---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import '@fontsource/be-vietnam-pro/400.css'
import '@fontsource/be-vietnam-pro/500.css'
import '@fontsource/be-vietnam-pro/600.css'
import '@fontsource/be-vietnam-pro/700.css'
import beVietnamPro600Woff2 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-600-normal.woff2?url'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { SITE_NAME, SITE_URL } from '../lib/site'
import { FaChevronUp } from 'react-icons/fa6'

interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  noIndex?: boolean
}

const {
  title,
  description = 'Xem phim đa nền tảng miễn phí, cập nhật nhanh nhất.',
  keywords,
  ogImage,
  noIndex = false,
} = Astro.props

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME
const canonical = new URL(Astro.url.pathname, SITE_URL)

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300',
)
---

<!doctype html>
<html lang="vi" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="google-site-verification" content="tarmfb6oRycJBNmrjeJaFruvUFOuOZI3QBW8CL-0sRg" />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://vsmov.com" />
    <link rel="dns-prefetch" href="https://vsmov.com" />
    <link rel="preload" as="font" type="font/woff2" href={beVietnamPro600Woff2} crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col">
    <div
      class="fixed inset-0 -z-10 overflow-hidden pointer-events-none"
      aria-hidden
    >
      <div class="absolute -top-32 -left-32 w-[36rem] h-[36rem] rounded-full bg-[#FF5C9E]/15 blur-[120px]" />
      <div class="absolute top-1/4 -right-40 w-[32rem] h-[32rem] rounded-full bg-[#4A9EFF]/15 blur-[120px]" />
      <div class="absolute bottom-0 left-1/3 w-[30rem] h-[30rem] rounded-full bg-[#00D6C8]/10 blur-[120px]" />
    </div>
    <a href="#main-content" class="skip-link">
      Chuyển đến nội dung
    </a>
    <Navbar />
    <main class="flex-1" id="main-content">
      <noscript>
        <div class="mx-auto max-w-xl mt-8 p-4 rounded-xl glass-tile text-center">
          <p class="text-text-secondary text-sm">
            Trang này cần JavaScript để hoạt động. Vui lòng bật JavaScript trong trình duyệt.
          </p>
        </div>
      </noscript>
      <slot />
    </main>
    <Footer />

    <div id="scroll-progress" aria-hidden class="fixed top-0 left-0 right-0 h-[3px] z-[70] origin-left bg-gradient-to-r from-[#FF6B9D] via-[#C44BED] to-[#4A9EFF]" style="transform: scaleX(0)"></div>
    <button id="back-to-top" class="back-to-top fixed bottom-6 right-6 z-50 w-11 h-11 rounded-full glass-tile flex items-center justify-center text-text-secondary hover:text-white" aria-label="Lên đầu trang">
      <FaChevronUp className="w-5 h-5" />
    </button>

    <script src="../scripts/app.ts"></script>

    <script is:inline data-astro-rerun>
      // Chạy lại trên MỌI trang (kể cả khi View Transitions đổi trang).
      // - Các script bundle chỉ chạy 1 lần (ESM cache) nên mọi per-page init
      //   được đăng ký qua lifecycle.ts và gọi lại ở đây.
      // - Lần load đầu: init tại DOMContentLoaded (sớm hơn window load).
      // - Khi VT đổi trang: init tại astro:page-load, bỏ qua entrance animation.
      // - load của resource nạp muộn cũng kích hoạt astro:page-load thêm lần nữa;
      //   dùng marker trên <main> để bỏ qua (tránh double-bind + replay animation).
      // Script này bị re-execute sau mỗi swap, nên dùng guard để không đăng ký listener trùng.
      if (!window.__nllpVtBound) {
        window.__nllpVtBound = true
        const boot = (viaTransition) => {
          const main = document.querySelector('main')
          if (main && main.dataset.nllpLanded) return
          if (main) main.dataset.nllpLanded = '1'
          if (window.__nllpPageInit) {
            try { window.__nllpPageInit.dispose() } catch {}
            try { window.__nllpPageInit.run() } catch {}
          }
          if (!viaTransition) main?.classList.add('page-enter')
        }
        document.addEventListener('DOMContentLoaded', () => boot(false))
        document.addEventListener('astro:page-load', () => boot(true))
        document.addEventListener('astro:before-swap', () => {
          try { window.__nllpPageInit && window.__nllpPageInit.dispose() } catch {}
        })
        window.addEventListener('pagehide', () => {
          try { window.__nllpPageInit && window.__nllpPageInit.dispose() } catch {}
        })
      }
    </script>
  </body>
</html>
