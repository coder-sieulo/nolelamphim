---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import '@fontsource/inter/400.css'
import '@fontsource/inter/500.css'
import '@fontsource/inter/600.css'
import '@fontsource/inter/700.css'
// Giữ Be Vietnam Pro làm fallback cho chữ hiếm Inter không cover (font family
// khai báo trong tokens.css vẫn trỏ cả hai).
import '@fontsource/be-vietnam-pro/400.css'
import '@fontsource/be-vietnam-pro/600.css'
import '@fontsource/be-vietnam-pro/700.css'
import inter600Woff2 from '@fontsource/inter/files/inter-vietnamese-600-normal.woff2?url'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { SITE_NAME, SITE_URL } from '../lib/site'
import { FaChevronUp } from 'react-icons/fa6'

interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  noIndex?: boolean
  /**
   * Chính sách cache CDN. **Mac dinh fail-closed**:
   * - Trang tĩnh (`prerender = true`) → `'public'` (cache edge bình thường).
   * - Trang SSR → `'private'` (KHÔNG cache edge), vì HTML có thể chứa dữ liệu
   *   theo người dùng (session, tên/avatar, cờ admin…). Vercel cache cả request
   *   kèm Cookie nên nếu để `public` sẽ rò dữ liệu người dùng này sang người khác.
   *
   * Trang SSR **thuần công khai** (không đọc session) muốn được cache thì truyền
   * `cache="public"` tường minh.
   */
  cache?: 'public' | 'private'
  /**
   * Tinh chỉnh TTL khi `cache="public"` (giây). Mặc định 60/300 (an toàn cho
   * trang danh sách). Trang chi tiết phim dùng 300/3600 — nội dung đổi chậm,
   * HTML đã công khai thật (4.2).
   */
  sMaxAge?: number
  staleWhileRevalidate?: number
}

const {
  title,
  description = 'Xem phim đa nền tảng miễn phí, cập nhật nhanh nhất.',
  keywords,
  ogImage,
  noIndex = false,
  cache,
  sMaxAge = 60,
  staleWhileRevalidate = 300,
} = Astro.props

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME
const canonical = new URL(Astro.url.pathname, SITE_URL)

const cacheMode = cache ?? (Astro.isPrerendered ? 'public' : 'private')
Astro.response.headers.set(
  'Cache-Control',
  cacheMode === 'private'
    ? 'private, no-store, max-age=0'
    : `public, s-maxage=${Math.max(0, Math.round(sMaxAge))}, stale-while-revalidate=${Math.max(0, Math.round(staleWhileRevalidate))}`,
)
---

<!doctype html>
  <html lang="vi" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="theme-color" content="#1b1b1f" />
    <meta name="google-site-verification" content="tarmfb6oRycJBNmrjeJaFruvUFOuOZI3QBW8CL-0sRg" />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://vsmov.com" />
    <link rel="dns-prefetch" href="https://vsmov.com" />
    <link rel="preload" as="font" type="font/woff2" href={inter600Woff2} crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col">
    <!-- Overlay chờ trang (View Transitions) — concept "máy chiếu phim": hạt phim,
         dải lỗ phim 2 mép, reel quay, đèn máy chiếu, chữ hiện dần từng từ.
         Hiện khi ClientRouter bắt đầu lấy trang mới, tắt khi trang mới swap xong.
         Không có JS thì ẩn hoàn toàn. Che màn hình nên chặn luôn click "spam". -->
    <div id="cm-loading" role="status" aria-live="polite">
      <div class="cm-strip cm-strip--top" aria-hidden="true"><span class="cm-strip-holes"></span></div>
      <div class="cm-strip cm-strip--bottom" aria-hidden="true"><span class="cm-strip-holes"></span></div>
      <div class="cm-lamp" aria-hidden="true"></div>
      <div class="cm-motes" aria-hidden="true">
        <span style="--x:14%;--s:3px;--d:0s;--dur:7.5s"></span>
        <span style="--x:28%;--s:2px;--d:1.1s;--dur:9s"></span>
        <span style="--x:39%;--s:4px;--d:2.6s;--dur:8.2s"></span>
        <span style="--x:48%;--s:2px;--d:0.6s;--dur:6.8s"></span>
        <span style="--x:57%;--s:3px;--d:3.4s;--dur:9.6s"></span>
        <span style="--x:66%;--s:2px;--d:1.8s;--dur:7.1s"></span>
        <span style="--x:74%;--s:4px;--d:4.2s;--dur:8.8s"></span>
        <span style="--x:85%;--s:3px;--d:2.2s;--dur:7.9s"></span>
        <span style="--x:22%;--s:2px;--d:5.1s;--dur:9.2s"></span>
        <span style="--x:63%;--s:2px;--d:5.8s;--dur:6.6s"></span>
      </div>
      <div class="cm-grain" aria-hidden="true"></div>
      <div class="cm-inner">
        <div class="cm-reel" aria-hidden="true">
          <span class="cm-reel-ring cm-reel-ring--outer"></span>
          <span class="cm-reel-ring cm-reel-ring--mid"></span>
          <span class="cm-reel-ring cm-reel-ring--arc"></span>
          <span class="cm-reel-core"></span>
        </div>
        <p class="cm-loading-text">
          <span style="--i:0">Bé</span>
          <span style="--i:1">Lỏ</span>
          <span style="--i:2">đang</span>
          <span style="--i:3">lấy</span>
          <span style="--i:4">phim</span>
          <span style="--i:5">cho</span>
          <span style="--i:6">bạn</span>
          <span class="cm-face" style="--i:7">:3</span>
        </p>
        <div class="cm-bar" aria-hidden="true"><span></span></div>
      </div>
    </div>
    <!-- Nền phẳng #0B0B0C + vignette rất nhẹ (CINEMA MINIMAL §03).
         Không blob màu; theme theo phim vẫn cô lập trong styles/themes. -->
    <div class="fixed inset-0 -z-10 pointer-events-none bg-cm-bg" aria-hidden>
      <div
        class="absolute inset-0"
        style="background: radial-gradient(120% 90% at 50% 0%, rgba(255,255,255,0.04) 0%, transparent 55%)"
      />
    </div>
    <a href="#main-content" class="skip-link">
      Chuyển đến nội dung
    </a>
    <Navbar />
    <main class="flex-1" id="main-content">
      <noscript>
        <div class="mx-auto max-w-xl mt-8 p-4 rounded-[var(--radius-cm-card)] bg-cm-surface border border-cm-border text-center">
          <p class="text-cm-text-2 text-sm">
            Trang này cần JavaScript để hoạt động. Vui lòng bật JavaScript trong trình duyệt.
          </p>
        </div>
      </noscript>
      <slot />
    </main>
    <Footer />

    <div id="scroll-progress" aria-hidden class="fixed top-0 left-0 right-0 h-[2px] z-[70] origin-left" style="transform: scaleX(0); background: var(--color-cm-accent)"></div>
    <button id="back-to-top" class="back-to-top fixed bottom-6 right-6 z-50 w-11 h-11 rounded-full bg-cm-surface border border-cm-border flex items-center justify-center text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]" aria-label="Lên đầu trang">
      <FaChevronUp className="w-5 h-5" />
    </button>

    {/* Context menu poster (Phase 7) — drawer trượt phải, BaseLayout nên giữ nguyên trên mọi trang */}
    <div id="ctx-menu" class="ctx-menu fixed inset-0 z-[115]" role="dialog" aria-modal="true" aria-label="Tuỳ chọn phim">
      <div id="ctx-veil" class="ctx-veil absolute inset-0 bg-black/70"></div>
      <div class="ctx-panel relative ml-auto h-full w-[300px] max-w-[86vw] flex flex-col bg-cm-elevated border-l border-cm-border shadow-[var(--shadow-cm-up)]">
        <header class="flex items-start gap-3 p-4 border-b border-cm-border shrink-0">
          <div id="ctx-poster" class="w-12 h-16 rounded-[var(--radius-cm-btn)] overflow-hidden bg-cm-bg-2 border border-cm-border shrink-0"></div>
          <div class="min-w-0 flex-1">
            <h2 id="ctx-name" class="text-sm font-semibold text-cm-text line-clamp-2 leading-snug"></h2>
            <p id="ctx-meta" class="text-xs text-cm-text-3 mt-0.5 truncate"></p>
          </div>
          <button id="ctx-close" type="button" class="w-8 h-8 shrink-0 rounded-[var(--radius-cm-btn)] flex items-center justify-center text-cm-text-3 hover:text-cm-text hover:bg-cm-surface transition-colors duration-[var(--duration-cm)]" aria-label="Đóng">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
          </button>
        </header>
        <nav class="flex-1 overflow-y-auto p-2 space-y-0.5">
          <a id="ctx-watch" href="#" class="ctx-item">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            <span data-ctx-watch-label>Xem ngay</span>
          </a>
          <button id="ctx-fav" type="button" class="ctx-item" aria-pressed="false">
            <span data-ctx-fav-on class="hidden"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></span>
            <span data-ctx-fav-off><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"/></svg></span>
            <span data-ctx-fav-label>Yêu thích</span>
          </button>
          <button id="ctx-share" type="button" class="ctx-item">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/></svg>
            <span data-ctx-share-label>Chia sẻ</span>
          </button>
          <button id="ctx-unwatch" type="button" class="ctx-item ctx-danger">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            <span data-ctx-unwatch-label>Đánh dấu chưa xem</span>
          </button>
        </nav>
      </div>
    </div>

    {/* Overlay phím tắt (Phase 7): nhấn `?` để mở */}
    <div id="shortcuts-overlay" class="hidden fixed inset-0 z-[120] flex items-center justify-center p-6">
      <div class="absolute inset-0 bg-cm-bg/75" data-close-shortcuts></div>
      <div class="relative w-full max-w-sm rounded-[var(--radius-cm-card)] bg-cm-elevated border border-cm-border p-6 shadow-[var(--shadow-cm-up)]" role="dialog" aria-modal="true" aria-label="Phím tắt">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-bold text-cm-text">Phím tắt</h2>
          <button type="button" data-close-shortcuts class="w-8 h-8 rounded-[var(--radius-cm-btn)] flex items-center justify-center text-cm-text-3 hover:text-cm-text hover:bg-cm-surface transition-colors duration-[var(--duration-cm)]" aria-label="Đóng">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
          </button>
        </div>
        <ul class="space-y-2 text-cm-body">
          <li class="flex items-center justify-between gap-4"><span class="text-cm-text-2">Tìm kiếm</span><kbd class="shortcut-key">/</kbd></li>
          <li class="flex items-center justify-between gap-4"><span class="text-cm-text-2">Phím tắt này</span><kbd class="shortcut-key">?</kbd></li>
          <li class="flex items-center justify-between gap-4"><span class="text-cm-text-2">Đóng cửa sổ / trình đơn</span><kbd class="shortcut-key">Esc</kbd></li>
          <li class="flex items-center justify-between gap-4"><span class="text-cm-text-2">Đổi tập (trang xem)</span><span class="flex items-center gap-1"><kbd class="shortcut-key"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.4 7.4L14 6l-6 6 6 6 1.4-1.4L11.8 12z"/></svg></kbd> <kbd class="shortcut-key"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.6 16.6L10 18l6-6-6-6-1.4 1.4L12.2 12z"/></svg></kbd></span></li>
          <li class="flex items-center justify-between gap-4"><span class="text-cm-text-2">Toàn màn hình (trang xem)</span><kbd class="shortcut-key">F</kbd></li>
          <li class="flex items-center justify-between gap-4"><span class="text-cm-text-2">Tuỳ chọn phim</span><kbd class="shortcut-key">Chuột phải</kbd></li>
        </ul>
      </div>
    </div>

    <script is:inline>
      // Overlay "Bé Lỏ đang lấy phim cho bạn" theo View Transitions.
      // - `astro:before-preparation`: bắt đầu lấy trang mới → hiện overlay (chặn click).
      // - `astro:after-swap`: DOM trang mới đã vào → tắt ngay. Phần mờ dần do View
      //   Transition tự cross-fade (overlay nằm trong ảnh chụp "trang cũ").
      // - `pageshow` (chỉ khi `persisted` = back/forward cache): tắt.
      // - Lưới an toàn 30s: điều hướng treo thì tự tắt, không khoá màn hình.
      //
      // ⚠️ KHÔNG tắt ở `astro:page-load`: router còn gắn `page-load` vào `window.load`
      // của chính trang hiện tại (astro/dist/transitions/router.js). Trang đang xem mà
      // load muộn (ảnh/font) sẽ bắn `page-load` GIỮA lúc đang chờ trang mới → tắt overlay
      // sớm, lộ trang cũ đứng hình. `astro:after-swap` mới là mốc "trang mới đã tới".
      //
      // ⚠️ KHÔNG giữ overlay thêm một khoảng tối thiểu sau swap: lúc đó overlay đã
      // trong suốt (opacity 0) nhưng vẫn `pointer-events: auto` → chặn click ~200ms
      // trong khi màn hình trông bình thường.
      // Guard vì script inline có thể bị chạy lại sau mỗi swap.
      if (!window.__nllpLoadingBound) {
        window.__nllpLoadingBound = true
        var LOADING_CAP_MS = 30000
        var loadingCapTimer = 0

        var loadingEl = function () {
          return document.getElementById('cm-loading')
        }
        var loadingHide = function () {
          if (loadingCapTimer) {
            clearTimeout(loadingCapTimer)
            loadingCapTimer = 0
          }
          var el = loadingEl()
          if (el) el.classList.remove('is-on')
        }
        var loadingShow = function () {
          var el = loadingEl()
          if (!el) return
          el.classList.add('is-on')
          if (loadingCapTimer) clearTimeout(loadingCapTimer)
          loadingCapTimer = setTimeout(loadingHide, LOADING_CAP_MS)
        }

        document.addEventListener('astro:before-preparation', loadingShow)
        document.addEventListener('astro:after-swap', loadingHide)
        // Chỉ back/forward cache mới cần dọn; `pageshow` thường bắn ngay sau khi
        // trang đầu load xong (có thể trùng lúc đang chờ điều hướng) nên bỏ qua.
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) loadingHide()
        })
      }
    </script>

    <script src="../scripts/app.ts"></script>
    <script src="../scripts/context-menu.ts"></script>

    <script is:inline data-astro-rerun>
      // Chạy lại trên MỌI trang (kể cả khi View Transitions đổi trang).
      // - Các script bundle chỉ chạy 1 lần (ESM cache) nên mọi per-page init
      //   được đăng ký qua lifecycle.ts và gọi lại ở đây.
      // - Lần load đầu: init tại DOMContentLoaded (sớm hơn window load).
      // - Khi VT đổi trang: init tại astro:page-load, bỏ qua entrance animation.
      // - load của resource nạp muộn cũng kích hoạt astro:page-load thêm lần nữa;
      //   dùng marker trên <main> để bỏ qua (tránh double-bind + replay animation).
      // Script này bị re-execute sau mỗi swap, nên dùng guard để không đăng ký listener trùng.
      if (!window.__nllpVtBound) {
        window.__nllpVtBound = true
        const boot = (viaTransition) => {
          const main = document.querySelector('main')
          if (main && main.dataset.nllpLanded) return
          if (main) main.dataset.nllpLanded = '1'
          if (window.__nllpPageInit) {
            try { window.__nllpPageInit.dispose() } catch {}
            try { window.__nllpPageInit.run() } catch {}
          }
          if (!viaTransition) main?.classList.add('page-enter')
        }
        document.addEventListener('DOMContentLoaded', () => boot(false))
        document.addEventListener('astro:page-load', () => boot(true))
        document.addEventListener('astro:before-swap', () => {
          try { window.__nllpPageInit && window.__nllpPageInit.dispose() } catch {}
        })
        window.addEventListener('pagehide', () => {
          try { window.__nllpPageInit && window.__nllpPageInit.dispose() } catch {}
        })
      }
    </script>
  </body>
</html>
