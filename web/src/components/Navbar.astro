---
// Shell Phase 1 — header CINEMA MINIMAL (brief §05) + search overlay (§09) + mobile bottom nav (§21)
const pathname = Astro.url.pathname
import {
  FaMagnifyingGlass,
  FaTv,
  FaChevronDown,
  FaHouse,
  FaPlus,
  FaClockRotateLeft,
  FaUser,
  FaArrowLeft,
  FaXmark,
} from 'react-icons/fa6'

const links = [
  { href: '/', label: 'Trang chủ', match: (p: string) => p === '/' },
  {
    href: '/danh-sach/phim-le',
    label: 'Phim',
    match: (p: string) =>
      p.startsWith('/danh-sach/phim-le') ||
      p.startsWith('/danh-sach/phim-moi') ||
      p.startsWith('/danh-sach/phim-dang-chieu') ||
      p.startsWith('/danh-sach/subteam'),
  },
  { href: '/danh-sach/phim-bo', label: 'Series', match: (p: string) => p.startsWith('/danh-sach/phim-bo') },
]

const activeIndex = links.findIndex((l) => l.match(pathname))
const genreActive = pathname.startsWith('/the-loai')
const bottomItems = [
  { href: '/', label: 'Trang chủ', icon: FaHouse, match: (p: string) => p === '/' },
  { href: '/favorites', label: 'Danh sách', icon: FaPlus, match: (p: string) => p.startsWith('/favorites') },
  { href: '/recent', label: 'Đã xem', icon: FaClockRotateLeft, match: (p: string) => p.startsWith('/recent') },
  { href: '/profile', label: 'Hồ sơ', icon: FaUser, match: (p: string) => p.startsWith('/profile') },
]
---

<nav id="navbar" class="site-header" aria-label="Điều hướng chính">
  <!-- Loading overlay (giữ từ cũ — random/dna navigates) -->
  <div
    id="nav-loading"
    class="hidden fixed inset-0 z-[80] flex-col items-center justify-center gap-4 bg-cm-bg/80"
  >
    <div class="w-9 h-9 border-2 border-cm-accent/30 border-t-cm-accent rounded-full animate-spin"></div>
    <p class="text-cm-text-2 text-sm font-medium"></p>
  </div>

  <div id="nav-shell" class="site-bar">
    <a href="/" class="site-logo group">
      <img src="/logo.png" alt="Nô Lệ Làm Phim" width="32" height="32" />
      <span>Nô Lệ Làm Phim</span>
    </a>

    <div id="nav-links" class="site-nav">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            class:list={['nav-link', i === activeIndex && 'active']}
            aria-current={i === activeIndex ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <div id="genre-wrap" class:list={['genre-wrap', genreActive && 'genre-on']}>
        <button id="genre-btn" class="genre-btn" aria-haspopup="true" aria-expanded="false">
          Thể loại
          <FaChevronDown className="chevron w-3 h-3" />
        </button>
        <div id="genre-menu" class="menu-panel"></div>
      </div>
    </div>

    <div class="site-actions">
      <button id="search-open" class="site-icon-btn" aria-label="Tìm kiếm" title="Tìm kiếm (/)">
        <FaMagnifyingGlass className="w-[18px] h-[18px]" />
      </button>
      <a
        href="/xem-chung"
        id="nav-xem-chung"
        class="site-icon-btn relative"
        aria-label="Xem Chung"
        title="Xem Chung — phòng xem phim cùng nhau"
      >
        <FaTv className="w-[18px] h-[18px]" />
        <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full pointer-events-none bg-cm-accent/80"></span>
      </a>
      <div id="auth-slot"></div>
    </div>
  </div>
</nav>

<!-- Search overlay (brief §09): header biến thành ô search, realtime, không rời trang -->
<div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="Tìm kiếm">
  <div class="search-overlay-bar">
    <button id="search-close" class="site-icon-btn" aria-label="Đóng tìm kiếm">
      <FaArrowLeft className="w-[18px] h-[18px]" />
    </button>
    <FaMagnifyingGlass className="w-[18px] h-[18px] text-cm-text-3 shrink-0" />
    <input
      id="search-overlay-input"
      class="search-overlay-input"
      type="text"
      placeholder="Tìm phim, diễn viên, đạo diễn, thể loại…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Nhập từ khoá tìm kiếm"
    />
    <button id="search-clear" class="site-icon-btn hidden" aria-label="Xoá từ khoá">
      <FaXmark className="w-[18px] h-[18px]" />
    </button>
  </div>
  <div id="search-panel" class="search-overlay-panel"></div>
</div>

<!-- Mobile bottom nav (brief §21): Home · Search · Library · Activity · Profile -->
<nav class="bottom-nav" aria-label="Điều hướng di động">
  {
    bottomItems.slice(0, 1).map((item) => {
      const active = item.match(pathname)
      return (
        <a class:list={['bottom-nav-item', active && 'active']} href={item.href} aria-current={active ? 'page' : undefined}>
          <item.icon className="w-5 h-5" />
          <span class="bottom-nav-label">{item.label}</span>
        </a>
      )
    })
  }
  <button id="bn-search" class="bottom-nav-item" aria-label="Tìm kiếm">
    <FaMagnifyingGlass className="w-5 h-5" />
    <span class="bottom-nav-label">Tìm kiếm</span>
  </button>
  {
    bottomItems.slice(1).map((item) => {
      const active = item.match(pathname)
      return (
        <a class:list={['bottom-nav-item', active && 'active']} href={item.href} aria-current={active ? 'page' : undefined}>
          <item.icon className="w-5 h-5" />
          <span class="bottom-nav-label">{item.label}</span>
        </a>
      )
    })
  }
</nav>
<div class="bottom-nav-spacer" aria-hidden="true"></div>

<script src="../scripts/navbar.ts"></script>
<script src="../scripts/header-search.ts"></script>
<script src="../scripts/auth.ts"></script>