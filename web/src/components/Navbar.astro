---
const pathname = Astro.url.pathname
import { FaDiscord, FaTv, FaDice, FaDna, FaShuffle } from 'react-icons/fa6'

const links = [
  { href: '/', label: 'Trang chủ' },
  { href: '/search', label: 'Tìm kiếm' },
  { href: '/favorites', label: 'Yêu thích' },
  { href: '/recent', label: 'Đã xem' },
  { href: '/download', label: 'Tải App' },
]

function isActive(p: string, href: string) {
  return p === href || (href !== '/' && p.startsWith(href))
}

const activeIndex = links.findIndex((l) => isActive(pathname, l.href))
---

<nav id="navbar" class="sticky top-0 z-50">
  <div
    id="nav-loading"
    class="hidden fixed inset-0 z-[80] flex-col items-center justify-center gap-4 bg-black/70 backdrop-blur-sm"
  >
    <div class="w-11 h-11 border-3 border-[#C44BED]/30 border-t-[#C44BED] rounded-full animate-spin"></div>
    <p class="text-text-secondary text-sm font-medium"></p>
  </div>
  <div id="nav-shell" class="px-4 md:px-8 transition-all duration-300">
    <div class="flex items-stretch gap-2 md:gap-3">
    <div
      id="nav-bar"
      class="liquid-glass flex-1 flex items-center justify-between gap-3 h-14 md:h-16 rounded-2xl md:rounded-3xl px-3 md:px-4"
    >
      <a href="/" class="flex items-center gap-2 md:gap-3 shrink-0 group pl-1 md:pl-2">
        <img
          src="/logo.png"
          alt="Nô Lệ Làm Phim"
          width="40"
          height="40"
          class="md:w-11 md:h-11 rounded-xl transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl group-hover:shadow-[#C44BED]/20"
        />
        <span class="font-semibold text-base md:text-lg text-text-primary transition-all duration-300 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-[#FF6B9D] group-hover:via-[#C44BED] group-hover:to-[#4A9EFF]">
          Nô Lệ Làm Phim
        </span>
      </a>

      <button
        id="nav-toggle"
        class="md:hidden relative w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center"
        aria-label="Menu"
        aria-expanded="false"
      >
        <div class="w-5 flex flex-col gap-1">
          <span id="nav-line-1" class="block h-0.5 bg-text-secondary rounded transition-all duration-300"></span>
          <span id="nav-line-2" class="block h-0.5 bg-text-secondary rounded transition-all duration-300"></span>
          <span id="nav-line-3" class="block h-0.5 bg-text-secondary rounded transition-all duration-300"></span>
        </div>
      </button>

      <div id="nav-links" class="hidden md:flex items-center gap-1 relative">
        <span
          id="nav-pill"
          class="absolute inset-y-0 rounded-xl bg-white/10 border border-white/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all duration-300 ease-out opacity-0"
          style="left:0;width:0"
        ></span>
        {
          links.map((link, i) => {
            const active = i === activeIndex
            return (
              <a
                href={link.href}
                class={`nav-link relative px-4 lg:px-5 py-2 rounded-xl text-[15px] font-medium transition-all duration-300 ease-out z-10 ${
                  active ? 'text-white' : 'text-text-secondary hover:text-white'
                }`}
              >
                {link.label}
              </a>
            )
          })
        }
      </div>

<div class="hidden md:flex items-center gap-1.5 shrink-0">
        <a id="nav-loading-random" href="/api/random" class="w-9 h-9 rounded-xl glass-tile flex items-center justify-center text-text-secondary hover:text-white transition-colors" aria-label="Phim bất kỳ" title="Phim bất kỳ">
          <FaDice className="w-4 h-4" />
        </a>
        <a id="nav-loading-dna" href="/phim-dna" class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#FF6B9D]/25 to-[#C44BED]/25 border border-[#C44BED]/30 flex items-center justify-center text-[#FF6B9D] hover:text-white transition-colors" aria-label="Phim DNA" title="Phim DNA">
          <FaDna className="w-4 h-4" />
        </a>
      </div>
    </div>

    <div class="hidden sm:flex items-center gap-2 shrink-0">
      <a
        href="/xem-chung"
        id="nav-xem-chung"
        class="relative w-14 h-14 md:w-16 md:h-16 rounded-full liquid-glass flex items-center justify-center text-[#FF6B9D] hover:text-white transition-colors group"
        aria-label="Xem Chung"
        title="Xem Chung — phòng xem phim cùng nhau"
      >
        <FaTv className="w-6 h-6 md:w-7 md:h-7 group-hover:scale-110 transition-transform" />
        <span class="absolute top-2.5 right-2.5 md:top-3 md:right-3 w-2.5 h-2.5 rounded-full pointer-events-none bg-[#FF6B9D]/80"></span>
      </a>
      <a
        href="/api/auth/discord"
        id="auth-login-round"
        class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#5865F2] hover:brightness-110 flex items-center justify-center text-white transition-all group"
        aria-label="Đăng nhập bằng Discord"
        title="Đăng nhập bằng Discord"
      >
        <FaDiscord className="w-6 h-6 md:w-7 md:h-7 group-hover:scale-110 transition-transform" />
      </a>
      <div id="auth-btn-desktop" class="hidden"></div>
    </div>
    </div>

    <div id="nav-mobile" class="nav-mobile md:hidden overflow-hidden transition-all duration-300 ease-out">
      <div class="liquid-glass mt-2 rounded-2xl px-3 py-2 flex flex-col gap-1">
        <div class="flex items-center justify-between gap-3 px-3 py-2.5 mb-1 border-b border-white/5">
          <a href="/xem-chung" class="flex items-center gap-2 flex-1 px-3 py-2.5 rounded-xl glass-tile text-[#FF6B9D] text-sm font-medium hover:text-white hover:bg-white/5 transition-colors">
            <FaTv className="w-4 h-4" /> Xem Chung
          </a>
          <a
            href="/api/auth/discord"
            id="auth-login-round-mobile"
            class="flex items-center gap-2 px-3 py-2.5 rounded-xl bg-[#5865F2] text-white text-sm font-medium hover:brightness-110 transition-all"
          >
            <FaDiscord className="w-4 h-4" />
            Discord
          </a>
        </div>
        {
          links.map((link, i) => {
            const active = i === activeIndex
            return (
              <a
                href={link.href}
                class={`nav-mobile-link px-4 py-3 rounded-xl text-sm font-medium transition-all duration-300 ease-out ${
                  active
                    ? 'text-white bg-white/10'
                    : 'text-text-secondary hover:text-white hover:bg-white/5'
                }`}
              >
                {link.label}
              </a>
            )
          })
        }
        <div class="flex items-center gap-2 px-3 py-2 mt-1 border-t border-white/5">
          <a id="nav-loading-random" href="/api/random" class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl glass-tile text-text-secondary text-sm font-medium hover:text-white transition-colors">
            <FaDice className="w-4 h-4" /> Phim bất kỳ
          </a>
          <a id="nav-loading-dna" href="/phim-dna" class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-gradient-to-r from-[#FF6B9D]/20 to-[#C44BED]/20 border border-[#C44BED]/30 text-[#FF6B9D] text-sm font-medium hover:text-white transition-colors">
            <FaDna className="w-4 h-4" /> Phim DNA
          </a>
        </div>
        <div id="auth-btn-mobile" class="px-3 py-2"></div>
      </div>
    </div>
  </div>
</nav>

<script src="../scripts/navbar.ts"></script>
<script src="../scripts/auth.ts"></script>
