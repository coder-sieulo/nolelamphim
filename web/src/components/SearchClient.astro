---
import MovieCard from './MovieCard.astro'
import type { Movie } from '../lib/types'
import { FaMagnifyingGlass, FaXmark, FaChevronDown, FaFilterCircleXmark } from 'react-icons/fa6'

interface Props {
  initialQuery?: string
  initialResults?: Movie[]
  initialLabel?: string
  initialTotalPages?: number
  initialFilter?: { type: string; label: string; value: string } | null
}

const { initialQuery = '', initialResults = [], initialLabel = '', initialTotalPages = 1, initialFilter = null } = Astro.props

const filterConfig = [
  { key: 'category', label: 'Thể loại', hint: 'Chọn thể loại' },
  { key: 'country', label: 'Quốc gia', hint: 'Chọn quốc gia' },
  { key: 'year', label: 'Năm', hint: 'Chọn năm' },
]
---

<main class="search-client px-4 md:px-8 py-6 md:py-8 max-w-[1600px] mx-auto w-full">
  <div
    class="sr-only"
    data-initial-results={JSON.stringify(
      initialResults.map((m) => ({
        slug: m.slug,
        name: m.name,
        year: m.year,
        thumb_url: m.thumb_url,
        episode_current: m.episode_current,
        quality: m.quality,
        lang: m.lang,
        tmdb_vote: m.tmdb?.vote_average,
      })),
    )}
    data-initial-label={initialLabel}
    data-initial-total-pages={initialTotalPages}
    data-initial-filter={initialFilter ? JSON.stringify(initialFilter) : ''}
  />

  <div class="mb-6 md:mb-8">
    <h1 class="text-xl md:text-2xl font-semibold text-text-primary mb-1">Tìm kiếm phim</h1>
    <p class="text-sm text-text-secondary">Tra cứu theo tên phim hoặc lọc theo thể loại, quốc gia, năm phát hành.</p>
  </div>

  <div class="relative mb-5">
    <div class="glass-tile group rounded-2xl md:rounded-3xl px-4 md:px-5 py-4 flex items-center gap-3 transition-shadow focus-within:ring-2 focus-within:ring-[#C44BED]/40 focus-within:ring-offset-2 focus-within:ring-offset-transparent">
      <FaMagnifyingGlass className="w-5 h-5 shrink-0 text-text-muted group-focus-within:text-[#C44BED] transition-colors" />
      <input
        id="search-input"
        type="text"
        value={initialQuery}
        placeholder="Nhập tên phim để tìm kiếm..."
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-suggestions"
        aria-autocomplete="list"
        aria-label="Tìm kiếm phim"
        class="flex-1 min-w-0 bg-transparent text-text-primary outline-none placeholder:text-text-muted text-[15px] md:text-base"
      />
      <button id="search-clear" class="hidden text-text-muted hover:text-white transition-colors p-1 rounded-lg hover:bg-white/5" aria-label="Xoá từ khoá" type="button">
        <FaXmark className="w-4 h-4" />
      </button>
      <button id="search-submit" type="button" class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl liquid-glass text-sm font-medium text-white shrink-0 hover:bg-white/10 transition-colors" aria-label="Tìm kiếm">
        <FaMagnifyingGlass className="w-4 h-4" />
        Tìm
      </button>
    </div>

    <div
      id="search-suggestions"
      role="listbox"
      aria-label="Gợi ý tìm kiếm"
      class="dropdown absolute top-full left-0 right-0 mt-2 z-40 w-full rounded-2xl glass-dropdown p-1.5 shadow-2xl max-h-[60vh] overflow-y-auto"
    ></div>
  </div>

  <div id="recent-searches" class="flex items-center gap-2 mb-5 flex-wrap" aria-label="Tìm kiếm gần đây"></div>

  <div class="flex flex-wrap items-center gap-2 mb-6">
    {
      filterConfig.map(({ key, label }) => (
        <div class="relative">
          <button
            type="button"
            class="filter-chip glass-tile text-text-secondary px-4 py-2 rounded-xl text-xs font-medium transition-all duration-200 hover:text-white"
            data-key={key}
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <span class="filter-chip-label flex items-center gap-1.5">
              <span class="filter-chip-text">{label}</span>
              <FaChevronDown className="filter-chevron w-3 h-3 transition-transform duration-200" />
            </span>
          </button>
          <div
            class="filter-dropdown dropdown absolute top-full left-0 mt-2 z-30 w-56 max-w-[calc(100vw-2.5rem)] max-h-72 overflow-y-auto rounded-xl glass-dropdown py-1.5 shadow-2xl"
            data-dropdown={key}
            role="listbox"
            aria-label={label}
          >
            <div class="px-4 py-3 text-sm text-text-muted text-center">Đang tải...</div>
          </div>
        </div>
      ))
    }

    <button type="button" id="filter-clear" class="hidden px-3 py-2 rounded-xl text-[11px] font-medium text-text-muted hover:text-white glass-tile" aria-label="Xoá bộ lọc">
      <span class="flex items-center gap-1">
        <FaFilterCircleXmark className="w-3 h-3" />
        Xoá lọc
      </span>
    </button>
  </div>

  <div id="result-header" class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <p id="filter-label" class="text-sm text-text-secondary" role="status">{initialLabel}</p>
  </div>

  <p id="results-status" class="mb-4 text-xs text-text-muted" aria-live="polite"></p>

  <div id="search-results">
    {
      initialResults.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-8 gap-2.5">
          {
            initialResults.map((movie) => <MovieCard movie={movie} />)
          }
        </div>
      ) : (
        <div id="search-empty">
          <div class="content-card px-8 py-14 flex flex-col items-center text-center">
            <div class="w-14 h-14 rounded-full bg-white/5 flex items-center justify-center mb-4">
              <FaMagnifyingGlass className="w-7 h-7 text-text-muted" />
            </div>
            <p class="text-text-secondary text-sm">Chưa có kết quả. Thử nhập từ khoá hoặc chọn bộ lọc.</p>
          </div>
        </div>
      )
    }
  </div>

  <div id="search-loading" class="hidden">
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-8 gap-2.5">
      {
        Array.from({ length: 16 }).map(() => (
          <div>
            <div class="aspect-[2/3] rounded-xl shimmer" />
            <div class="mt-2.5 h-3 shimmer rounded w-3/4" />
            <div class="mt-1.5 h-2.5 shimmer rounded w-1/2" />
          </div>
        ))
      }
    </div>
  </div>

  <div id="search-pagination" class="flex flex-wrap items-center justify-center gap-1.5 mt-8"></div>

  <div id="sort-row" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-40 glass-tile rounded-full px-2 py-1.5 flex items-center gap-1 shadow-2xl">
    <span class="text-[11px] text-text-muted pl-2">Sắp xếp:</span>
    <button type="button" class="sort-btn px-2.5 py-1 rounded-full text-[11px] font-medium transition-all text-text-muted hover:text-white" data-sort="name" aria-pressed="false">Tên</button>
    <button type="button" class="sort-btn px-2.5 py-1 rounded-full text-[11px] font-medium transition-all text-text-muted hover:text-white" data-sort="year" aria-pressed="false">Năm</button>
  </div>
</main>

<script>
  import { gridHTML, escapeHTML } from '../scripts/cards'
  import { imgUrl } from '../lib/img'
  import { arrowButtonsHTML } from '../scripts/pagination'
  import { getRecentSearches, saveRecentSearches } from '../scripts/store'
  import {
    getNewMovies,
    getMoviesByCategory,
    getMoviesByCountry,
    getMoviesByYear,
    searchMovies,
    getCategories,
    getCountries,
    getYears,
  } from '../lib/api'
  import { SEARCH_LIMIT, SUGGESTION_LIMIT } from '../lib/constants'
  import { registerPageInit } from '../scripts/lifecycle'
  import { iconString } from '../lib/icon-strings'

  registerPageInit(() => {
    const root = document.querySelector<HTMLElement>('.search-client')
    if (!root) return () => {}
    const ac = new AbortController()

    const metaHolder = root.querySelector<HTMLElement>('[data-initial-results]')
    let initialResults: { slug: string; name: string; year?: number; thumb_url?: string; _id?: number; episode_current?: string; quality?: string; lang?: string; tmdb_vote?: string; tmdb?: { vote_average?: string } }[] = []
    try {
      initialResults = JSON.parse(metaHolder?.dataset.initialResults || '[]')
    } catch {
      initialResults = []
    }
    let initialFilter: { type: string; label: string; value: string } | null = null
    try {
      const raw = metaHolder?.dataset.initialFilter
      if (raw) initialFilter = JSON.parse(raw)
    } catch {
      initialFilter = null
    }

    const input = document.getElementById('search-input') as HTMLInputElement
    const clearBtn = document.getElementById('search-clear')
    const submitBtn = document.getElementById('search-submit')
    const suggestionsEl = document.getElementById('search-suggestions') as HTMLElement
    const recentEl = document.getElementById('recent-searches') as HTMLElement
    const resultsEl = document.getElementById('search-results') as HTMLElement
    const loadingEl = document.getElementById('search-loading') as HTMLElement
    const labelEl = document.getElementById('filter-label') as HTMLElement
    const resultsStatus = document.getElementById('results-status') as HTMLElement
    const sortRow = document.getElementById('sort-row') as HTMLElement
    const filterClear = document.getElementById('filter-clear') as HTMLElement
    const paginationEl = document.getElementById('search-pagination') as HTMLElement
    const chipBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.filter-chip'))
    const dropdownEls = Array.from(root.querySelectorAll<HTMLElement>('.filter-dropdown'))

    let query = input.value
    let results = initialResults
    let loading = false
    let page = 1
    let totalPages = Number(metaHolder?.dataset.initialTotalPages) || 1
    let categories: { slug: string; name: string }[] = []
    let countries: { slug: string; name: string }[] = []
    let years: { slug: string; name: string }[] = []
    let openDropdown: string | null = null
    let recentSearches: string[] = getRecentSearches()
    let suggestions: { slug: string; name: string; origin_name?: string; year?: number; thumb_url?: string }[] = []
    let suggestionQuery = ''
    let showSuggestions = false
    let activeFilter: { type: string; label: string; value: string } | null = initialFilter
    let sortBy: 'name' | 'year' | null = null

    let searchTimer: ReturnType<typeof setTimeout> | undefined
    let suggestTimer: ReturnType<typeof setTimeout> | undefined
    let highlightIndex = -1
    let highlights: { slug: string; name: string } | undefined

    const filterLabelMap = (type: string, label: string) =>
      type === 'category' ? `Thể loại: ${label}` : type === 'country' ? `Quốc gia: ${label}` : `Năm: ${label}`

    function currentURLParams(): URLSearchParams {
      const sp = new URLSearchParams()
      if (query.trim()) {
        sp.set('q', query.trim())
      } else if (activeFilter) {
        const fType = activeFilter.type === 'category' ? 'the-loai' : activeFilter.type === 'country' ? 'quoc-gia' : 'nam'
        sp.set('f', `${fType}:${activeFilter.value}`)
      }
      if (page > 1) sp.set('p', String(page))
      return sp
    }

    function syncURL(mode: 'replace' | 'push') {
      const sp = currentURLParams()
      const target = `${location.pathname}${sp.toString() ? `?${sp.toString()}` : ''}`
      if (mode === 'push') {
        history.pushState({}, '', target)
        return
      }
      if (target !== location.pathname + location.search) {
        history.replaceState({}, '', target)
      }
    }

    function decodeFilter(fParam: string): { type: string; label: string; value: string } | null {
      const [rawType, ...rest] = fParam.split(':')
      const value = rest.join(':')
      if (!rawType || !value) return null
      const type = rawType === 'the-loai' ? 'category' : rawType === 'quoc-gia' ? 'country' : rawType === 'nam' ? 'year' : null
      if (!type) return null
      const meta = type === 'category' ? categories : type === 'country' ? countries : years
      const item = meta.find((m) => m.slug === value)
      return { type, label: item?.name || value, value }
    }

    window.addEventListener('popstate', () => {
      loadMeta().then(() => {
        const sp = new URLSearchParams(location.search)
        const q = sp.get('q') || ''
        const f = sp.get('f') || ''
        const p = Math.max(1, Number(sp.get('p')) || 1)
        query = q
        input.value = q
        clearBtn?.classList.toggle('hidden', !q)
        closeSuggestions()
        activeFilter = f ? decodeFilter(f) : null
        paintChips()
        paintRecent()
        if (q.trim()) runSearch(p, false, true)
        else fetchByFilter(activeFilter, p, { skipSync: true })
      })
    }, { signal: ac.signal })

    function setLoading(v: boolean) {
      loading = v
      loadingEl.classList.toggle('hidden', !v)
      resultsEl.style.display = v ? 'none' : ''
    }

    function showEmpty(message: string, retryable = false) {
      resultsEl.innerHTML = `
        <div class="content-card px-8 py-14 flex flex-col items-center text-center">
          <div class="w-14 h-14 rounded-full bg-white/5 flex items-center justify-center mb-4">
            ${iconString('search', 'w-7 h-7 text-text-muted')}
          </div>
          <p class="text-text-secondary text-sm">${escapeHTML(message)}</p>
          ${
            retryable
              ? `<button type="button" id="empty-retry" class="mt-4 px-4 py-2 rounded-xl glass-tile text-xs text-text-secondary hover:text-white transition-colors">Thử lại</button>`
              : ''
          }
        </div>
      `
      resultsEl.style.display = ''
      document.getElementById('empty-retry')?.addEventListener('click', () => {
        if (query.trim()) runSearch(page)
        else fetchByFilter(activeFilter, page)
      })
    }

    function renderResults() {
      const sorted =
        sortBy === 'name'
          ? [...results].sort((a, b) => a.name.localeCompare(b.name, 'vi'))
          : sortBy === 'year'
            ? [...results].sort((a, b) => (b.year || 0) - (a.year || 0))
            : results
      if (sorted.length === 0) {
        showEmpty(query.trim() ? `Không tìm thấy phim nào cho "${query.trim()}"` : 'Chưa có kết quả. Thử nhập từ khoá hoặc chọn bộ lọc.')
        return
      }
      resultsEl.innerHTML = `<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-8 gap-2.5">${gridHTML(sorted)}</div>`
      renderStatus()
    }

    function renderStatus() {
      resultsStatus.textContent = results.length > 0 ? `Hiển thị ${results.length} phim` : ''
    }

    function setLabel(text: string) {
      labelEl.textContent = text
      renderStatus()
      sortRow.classList.toggle('hidden', results.length === 0)
    }

    function goToPage(p: number) {
      if (p === page || loading) return
      if (query.trim()) runSearch(p)
      else fetchByFilter(activeFilter, p)
    }

    function renderPagination() {
      if (totalPages <= 1 || results.length === 0) {
        paginationEl.innerHTML = ''
        return
      }
      paginationEl.innerHTML = arrowButtonsHTML(page, totalPages, 'sp-page')
      paginationEl.querySelectorAll<HTMLButtonElement>('.sp-page').forEach((btn) => {
        btn.addEventListener('click', () => goToPage(Number(btn.dataset.page)))
      })
      paginationEl.querySelectorAll<HTMLButtonElement>('[data-nav]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const nav = btn.dataset.nav
          if (nav === 'first') goToPage(1)
          else if (nav === 'prev') goToPage(Math.max(1, page - 1))
          else if (nav === 'next') goToPage(Math.min(totalPages, page + 1))
          else if (nav === 'last') goToPage(totalPages)
        })
      })
    }

    async function fetchByFilter(
      filter: { type: string; label: string; value: string } | null,
      targetPage = 1,
      opts: { push?: boolean; skipSync?: boolean } = {},
    ) {
      const key = filter ? `${filter.type}:${filter.value}` : ''
      setLoading(true)
      try {
        let data: { status: boolean; items: typeof results; pagination?: { totalPages?: number } }
        if (!filter) {
          data = await getNewMovies(targetPage)
          setLabel('Phim mới nhất')
        } else if (filter.type === 'category') {
          data = await getMoviesByCategory(filter.value, { page: targetPage, limit: SEARCH_LIMIT })
          setLabel(filterLabelMap('category', filter.label))
        } else if (filter.type === 'country') {
          data = await getMoviesByCountry(filter.value, { page: targetPage, limit: SEARCH_LIMIT })
          setLabel(filterLabelMap('country', filter.label))
        } else {
          data = await getMoviesByYear(filter.value, { page: targetPage, limit: SEARCH_LIMIT })
          setLabel(filterLabelMap('year', filter.label))
        }
        if (query.trim() || (activeFilter ? `${activeFilter.type}:${activeFilter.value}` : '') !== key) return
        results = Array.isArray(data.items) ? data.items.map((m) => ({ ...m, tmdb_vote: m.tmdb?.vote_average })) : []
        page = targetPage
        totalPages = Number(data.pagination?.totalPages) || 1
        renderResults()
        renderPagination()
        if (!opts.skipSync) syncURL(opts.push ? 'push' : 'replace')
      } catch {
        if (query.trim() || (activeFilter ? `${activeFilter.type}:${activeFilter.value}` : '') !== key) return
        results = []
        page = targetPage
        totalPages = 1
        showEmpty('Không thể tải dữ liệu. Kiểm tra kết nối rồi thử lại.', true)
        renderPagination()
        if (!opts.skipSync) syncURL(opts.push ? 'push' : 'replace')
      } finally {
        setLoading(false)
      }
    }

    async function runSearch(targetPage = 1, push = false, skipSync = false) {
      const q = query.trim()
      if (!q) {
        setLabel('Phim mới nhất')
        fetchByFilter(activeFilter, 1, { push, skipSync })
        return
      }
      setLoading(true)
      try {
        const data = await searchMovies(q, targetPage, SEARCH_LIMIT)
        if (query.trim() !== q) return
        results = Array.isArray(data.items) ? data.items.map((m) => ({ ...m, tmdb_vote: m.tmdb?.vote_average })) : []
        page = targetPage
        totalPages = Number(data.pagination?.totalPages) || 1
        setLabel(`Kết quả cho "${q}"`)
        renderResults()
        renderPagination()
        if (!skipSync) syncURL(push ? 'push' : 'replace')
      } catch {
        if (query.trim() !== q) return
        results = []
        showEmpty('Không thể tải dữ liệu. Kiểm tra kết nối rồi thử lại.', true)
        renderPagination()
        if (!skipSync) syncURL(push ? 'push' : 'replace')
      } finally {
        setLoading(false)
      }
    }

    async function loadSuggestions() {
      const q = query.trim()
      if (!q) return
      if (suggestTimer) clearTimeout(suggestTimer)
      suggestTimer = setTimeout(async () => {
        try {
          const data = await searchMovies(q, 1, SUGGESTION_LIMIT)
          suggestionQuery = q
          suggestions = Array.isArray(data.items) ? data.items.slice(0, 8) : []
          showSuggestions = suggestions.length > 0 && suggestionQuery === q && document.activeElement === input
          paintSuggestions()
        } catch {
          suggestions = []
          paintSuggestions()
        }
      }, 220)
    }

    function setInputExpanded(open: boolean) {
      input.setAttribute('aria-expanded', open ? 'true' : 'false')
    }

    function highlightQuery(text: string, q: string): string {
      const clean = q.trim()
      if (!clean) return escapeHTML(text)
      const idx = text.toLowerCase().indexOf(clean.toLowerCase())
      if (idx === -1) return escapeHTML(text)
      return `${escapeHTML(text.slice(0, idx))}<mark class="bg-transparent bg-gradient-to-r from-[#C44BED]/30 to-[#4A9EFF]/30 text-white rounded px-0.5">${escapeHTML(text.slice(idx, idx + clean.length))}</mark>${escapeHTML(text.slice(idx + clean.length))}`
    }

    function paintSuggestions() {
      if (!showSuggestions || suggestions.length === 0) {
        closeSuggestions()
        return
      }
      highlightIndex = Math.min(highlightIndex, suggestions.length - 1)
      highlights = highlightIndex >= 0 ? { slug: suggestions[highlightIndex].slug, name: suggestions[highlightIndex].name } : undefined
      suggestionsEl.innerHTML =
        suggestions
          .map(
            (m, i) => `
              <a
                href="/phim/${escapeHTML(m.slug)}"
                role="option"
                id="sug-${i}"
                aria-selected="${i === highlightIndex}"
                class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors ${i === highlightIndex ? 'bg-white/10' : 'hover:bg-white/5'} text-text-secondary hover:text-white"
              >
                ${m.thumb_url ? `<div class="relative w-9 h-13 rounded-md overflow-hidden shrink-0 bg-bg-card glass-frame poster-shell"><img src="${escapeHTML(imgUrl(m.thumb_url, 300))}" alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" /></div>` : '<div class="w-9 shrink-0"></div>'}
                <div class="min-w-0">
                  <p class="text-sm text-text-primary truncate">${highlightQuery(m.name, suggestionQuery)}</p>
                  ${m.origin_name ? `<p class="text-[11px] text-text-muted truncate">${escapeHTML(m.origin_name)}</p>` : ''}
                </div>
                ${m.year ? `<span class="ml-auto text-[11px] text-text-muted shrink-0 tabular-nums">${m.year}</span>` : ''}
              </a>
            `,
          )
          .join('') +
        `<div class="suggest-footer px-3 py-2.5 mt-1 border-t border-white/10 flex items-center justify-between">
          <span class="text-[11px] text-text-muted">Nhấn Enter để xem tất cả</span>
          <span class="flex items-center gap-0.5 text-[10px] text-text-muted">
            <kbd class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 font-mono">↑↓</kbd>
            <span>điều hướng</span>
          </span>
        </div>`
      suggestionsEl.classList.add('open')
      setInputExpanded(true)
      updateActiveDescendant()
    }

    function updateActiveDescendant() {
      if (highlightIndex >= 0) {
        input.setAttribute('aria-activedescendant', `sug-${highlightIndex}`)
      } else {
        input.removeAttribute('aria-activedescendant')
      }
    }

    function closeSuggestions() {
      suggestionsEl.innerHTML = ''
      suggestionsEl.classList.remove('open')
      showSuggestions = false
      highlightIndex = -1
      highlights = undefined
      setInputExpanded(false)
      input.removeAttribute('aria-activedescendant')
      if (suggestTimer) clearTimeout(suggestTimer)
    }

    function recordSearch(q: string) {
      const v = q.trim()
      if (!v) return
      const next = [v, ...recentSearches.filter((x) => x !== v)].slice(0, 8)
      recentSearches = next
      saveRecentSearches(next)
      paintRecent()
    }

    function paintRecent() {
      if (query.trim() || recentSearches.length === 0) {
        recentEl.innerHTML = ''
        return
      }
      recentEl.innerHTML =
        `<span class="text-[11px] text-text-muted mr-1">Tìm kiếm gần đây:</span>` +
        recentSearches
          .map(
            (q) =>
              `<button type="button" class="recent-chip px-3 py-1.5 rounded-xl glass-tile text-[12px] text-text-secondary hover:text-white transition-colors" data-q="${escapeHTML(q)}">${escapeHTML(q)}</button>`,
          )
          .join('') +
        `<button type="button" id="recent-clear" class="px-2 py-1 text-[11px] text-text-muted hover:text-white transition-colors" aria-label="Xoá lịch sử tìm kiếm">Xoá</button>`
      recentEl.querySelectorAll<HTMLButtonElement>('.recent-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          query = btn.dataset.q || ''
          input.value = query
          clearBtn?.classList.toggle('hidden', !query)
          recordSearch(query)
          closeSuggestions()
          runSearch(1, true)
        })
      })
      recentEl.querySelector<HTMLButtonElement>('#recent-clear')?.addEventListener('click', () => {
        recentSearches = []
        saveRecentSearches([])
        paintRecent()
      })
    }

    let metaPromise: Promise<void> | null = null
    function loadMeta() {
      if (metaPromise) return metaPromise
      metaPromise = (async () => {
        const [c, co, y] = await Promise.all([getCategories(), getCountries(), getYears()])
        categories = c.status === 'success' ? c.data.items : []
        countries = co.status === 'success' ? co.data.items : []
        years = y.status === 'success' ? y.data.items : []
        paintDropdowns()
      })().catch(() => {})
      return metaPromise
    }

    function paintDropdowns() {
      dropdownEls.forEach((el) => {
        const key = el.dataset.dropdown
        const items = key === 'category' ? categories : key === 'country' ? countries : years
        if (items.length === 0) return
        const selected = activeFilter && activeFilter.type === key ? activeFilter.value : ''
        el.innerHTML =
          `<button type="button" role="option" aria-selected="${!selected ? 'true' : 'false'}" class="filter-option w-full text-left px-4 py-2 text-sm text-text-secondary hover:text-white hover:bg-white/5 transition-colors ${!selected ? 'text-white bg-white/10' : ''}" data-type="${key}" data-label="" data-value="">Tất cả</button>` +
          items
            .map(
              (item) =>
                `<button type="button" role="option" aria-selected="${selected === item.slug ? 'true' : 'false'}" class="filter-option w-full text-left px-4 py-2 text-sm ${selected === item.slug ? 'text-white bg-white/10' : 'text-text-secondary hover:text-white hover:bg-white/5'} transition-colors" data-type="${key}" data-label="${escapeHTML(item.name)}" data-value="${escapeHTML(item.slug)}">${escapeHTML(item.name)}${selected === item.slug ? `<span class="ml-1 text-[#C44BED]">✓</span>` : ''}</button>`,
            )
            .join('')
      })
    }

    function paintChips() {
      chipBtns.forEach((btn) => {
        const key = btn.dataset.key
        const active = activeFilter?.type === key
        btn.className = active
          ? `filter-chip glass-tile-active text-white px-4 py-2 rounded-xl text-xs font-medium transition-all duration-200`
          : `filter-chip glass-tile text-text-secondary px-4 py-2 rounded-xl text-xs font-medium transition-all duration-200 hover:text-white`
        const labelSpan = btn.querySelector('.filter-chip-text')
        if (labelSpan && labelSpan.firstChild) {
          ;(labelSpan.firstChild as Text).textContent = active ? activeFilter?.label || '' : btn.dataset.key === 'category' ? 'Thể loại' : btn.dataset.key === 'country' ? 'Quốc gia' : 'Năm'
        }
        const chevron = btn.querySelector('.filter-chevron')
        if (chevron) chevron.classList.toggle('rotate-180', active)
      })
      filterClear?.classList.toggle('hidden', !activeFilter)
    }

    function selectFilter(type: string, label: string, value: string) {
      if (!value) {
        activeFilter = null
      } else {
        activeFilter = { type, label, value }
      }
      closeAllDropdowns()
      query = ''
      input.value = ''
      clearBtn?.classList.add('hidden')
      paintChips()
      paintRecent()
      paintSuggestions()
      fetchByFilter(activeFilter, 1, { push: true })
    }

    function closeAllDropdowns() {
      openDropdown = null
      dropdownEls.forEach((el) => {
        el.classList.remove('open')
        const key = el.dataset.dropdown
        const chip = chipBtns.find((c) => c.dataset.key === key)
        chip?.setAttribute('aria-expanded', 'false')
      })
    }

    input?.addEventListener('input', () => {
      query = input.value
      clearBtn?.classList.toggle('hidden', !query)
      if (query.trim() && activeFilter) {
        activeFilter = null
        paintChips()
      }
      paintRecent()
      closeSuggestions()
      if (searchTimer) clearTimeout(searchTimer)
      if (!query.trim()) {
        searchTimer = setTimeout(() => runSearch(1), 120)
        return
      }
      loadSuggestions()
      searchTimer = setTimeout(() => runSearch(1), 400)
    })

    input?.addEventListener('keydown', (e) => {
      if (showSuggestions && suggestions.length > 0) {
        if (e.key === 'ArrowDown') {
          e.preventDefault()
          highlightIndex = (highlightIndex + 1) % suggestions.length
          paintHighlightOnly()
          return
        }
        if (e.key === 'ArrowUp') {
          e.preventDefault()
          highlightIndex = highlightIndex <= 0 ? suggestions.length - 1 : highlightIndex - 1
          paintHighlightOnly()
          return
        }
        if (e.key === 'Escape') {
          e.preventDefault()
          closeSuggestions()
          return
        }
      }
      if (e.key === 'Enter') {
        e.preventDefault()
        if (query.trim()) {
          recordSearch(query)
          const selected = highlights
          closeSuggestions()
          if (selected) {
            location.href = `/phim/${selected.slug}`
            return
          }
          runSearch(1, true)
        }
      }
    })

    function paintHighlightOnly() {
      suggestionsEl.querySelectorAll<HTMLElement>('[role="option"]').forEach((el, i) => {
        const on = i === highlightIndex
        if (i < suggestions.length) {
          el.classList.toggle('bg-white/10', on)
          el.classList.toggle('hover:bg-white/5', !on)
          el.setAttribute('aria-selected', on ? 'true' : 'false')
          if (on) {
            const m = suggestions[i]
            highlights = { slug: m.slug, name: m.name }
            el.scrollIntoView({ block: 'nearest' })
          }
        }
      })
      updateActiveDescendant()
    }

    input?.addEventListener('focus', () => {
      if (query.trim() && suggestions.length > 0) {
        showSuggestions = true
        paintSuggestions()
      }
    })

    clearBtn?.addEventListener('click', () => {
      query = ''
      input.value = ''
      clearBtn.classList.add('hidden')
      closeSuggestions()
      runSearch(1, true)
      paintRecent()
      input.focus()
    })

    submitBtn?.addEventListener('click', () => {
      recordSearch(query)
      closeSuggestions()
      runSearch(1, true)
    })

    chipBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.key || ''
        openDropdown = openDropdown === key ? null : key
        dropdownEls.forEach((el) => {
          const isOpen = el.dataset.dropdown === key && openDropdown === key
          el.classList.toggle('open', isOpen)
        })
        btn.setAttribute('aria-expanded', openDropdown === key ? 'true' : 'false')
      })
    })

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const opt = target.closest<HTMLButtonElement>('.filter-option')
      if (opt) {
        selectFilter(opt.dataset.type || '', opt.dataset.label || '', opt.dataset.value || '')
        return
      }
      if (target.closest('.filter-chip') || target.closest('.filter-dropdown')) return
      closeAllDropdowns()
    })

    filterClear?.addEventListener('click', () => {
      activeFilter = null
      query = ''
      input.value = ''
      clearBtn?.classList.add('hidden')
      paintChips()
      paintRecent()
      fetchByFilter(null, 1, { push: true })
    })

    document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const s = btn.dataset.sort as 'name' | 'year'
        sortBy = sortBy === s ? null : s
        document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((b) => {
          const active = sortBy === b.dataset.sort
          b.className = active
            ? `sort-btn px-2.5 py-1 rounded-full text-[11px] font-medium transition-all sort-active`
            : `sort-btn px-2.5 py-1 rounded-full text-[11px] font-medium transition-all text-text-muted hover:text-white`
          b.setAttribute('aria-pressed', active ? 'true' : 'false')
        })
        renderResults()
      })
    })

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      if (!root.contains(target)) {
        closeSuggestions()
      }
    }, { signal: ac.signal })

    input?.addEventListener(
      'focusout',
      (e) => {
        const related = e.relatedTarget as HTMLElement | null
        if (related && suggestionsEl.contains(related)) return
        setTimeout(() => {
          if (document.activeElement === input) return
          if (document.activeElement && input.parentElement?.contains(document.activeElement)) return
          closeSuggestions()
        }, 120)
      },
      { signal: ac.signal },
    )

    loadMeta()
    paintChips()
    paintRecent()
    paintSuggestions()
    renderResults()
    renderPagination()
    sortRow.classList.toggle('hidden', results.length === 0)

    return () => ac.abort()
  })
</script>
