---
/**
 * CategorySection — row thể loại theo brief §07: chỉ tiêu đề + "Xem tất cả →"
 * + hàng poster cuộn ngang. KHÔNG bọc glass/card; poster = movieCardHTML (cm).
 */
import MovieCard from './MovieCard.astro'
import SectionHeader from './ui/SectionHeader.astro'
import EmptyState from './ui/EmptyState.astro'
import type { Movie } from '../lib/types'

interface Props {
  slug: string
  name: string
  items: Movie[]
  className?: string
}

const { slug, name, items, className = '' } = Astro.props

const isEmpty = items.length === 0
---

<section class:list={[className]}>
  {
    isEmpty ? (
      <EmptyState title={`Chưa có phim thể loại ${name}`} hint="Thử lại sau nhé" />
    ) : (
      <>
        <SectionHeader title={name} href={`/the-loai/${slug}`} linkLabel="Xem tất cả" />
        <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none snap-x snap-mandatory">
          {
            items.map((movie) => (
              <div class="snap-start shrink-0 w-[150px]">
                <MovieCard movie={movie} />
              </div>
            ))
          }
        </div>
      </>
    )
  }
</section>