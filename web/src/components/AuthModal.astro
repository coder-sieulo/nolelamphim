---
import { supabase } from '../lib/supabase'
---
<div id="auth-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/70" data-auth-close></div>
  <div class="relative w-full max-w-sm rounded-[var(--radius-cm-modal)] bg-cm-elevated border border-cm-border shadow-[var(--shadow-cm-up)] p-6">
    <button type="button" class="absolute right-3 top-3 w-8 h-8 rounded-full flex items-center justify-center text-cm-text-3 hover:text-cm-text" data-auth-close aria-label="Đóng">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </button>
    <h2 class="text-lg font-semibold text-cm-text mb-1">Đăng nhập</h2>
    <p class="text-sm text-cm-text-2 mb-5">Đăng nhập để lưu yêu thích, đánh giá, lịch sử xem</p>
    <div class="space-y-2">
      <button id="auth-email" type="button" class="w-full h-11 rounded-[var(--radius-cm-btn)] bg-cm-accent text-white font-medium hover:bg-cm-accent-hover">Đăng nhập bằng Email</button>
      <button id="auth-magic" type="button" class="w-full h-11 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-text hover:bg-cm-elevated">Gửi link đăng nhập</button>
    </div>
    <div id="auth-email-form" class="hidden mt-4 space-y-2">
      <input id="auth-email-input" type="email" placeholder="email@example.com" class="w-full h-11 px-3 rounded-[var(--radius-cm-input)] bg-cm-surface border border-cm-border text-cm-text" />
      <input id="auth-pass-input" type="password" placeholder="Mật khẩu" class="w-full h-11 px-3 rounded-[var(--radius-cm-input)] bg-cm-surface border border-cm-border text-cm-text" />
      <div class="flex gap-2">
        <button id="auth-signin" type="button" class="flex-1 h-10 rounded-[var(--radius-cm-btn)] bg-cm-accent text-white">Đăng nhập</button>
        <button id="auth-signup" type="button" class="flex-1 h-10 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-text">Đăng ký</button>
      </div>
    </div>
    <p id="auth-msg" class="text-sm text-cm-text-2 mt-3 hidden"></p>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase'
  const modal = document.getElementById('auth-modal') as HTMLElement
  const openers = document.querySelectorAll('[data-auth-open]')
  const closers = document.querySelectorAll('[data-auth-close]')
  const emailBtn = document.getElementById('auth-email')
  const magicBtn = document.getElementById('auth-magic')
  const form = document.getElementById('auth-email-form')
  const emailIn = document.getElementById('auth-email-input') as HTMLInputElement
  const passIn = document.getElementById('auth-pass-input') as HTMLInputElement
  const signin = document.getElementById('auth-signin')
  const signup = document.getElementById('auth-signup')
  const msg = document.getElementById('auth-msg')

  function show(m: string){ if(msg){msg.textContent=m;msg.classList.remove('hidden')} }
  openers.forEach(b=>b.addEventListener('click',e=>{e.preventDefault();modal.classList.remove('hidden');modal.classList.add('flex');}))
  closers.forEach(b=>b.addEventListener('click',()=>{modal.classList.add('hidden');modal.classList.remove('flex')}))
  emailBtn?.addEventListener('click',()=>form?.classList.toggle('hidden'))
  magicBtn?.addEventListener('click',async()=>{
    const email=emailIn?.value.trim(); if(!email){show('Nhập email');return;}
    const {error}=await supabase.auth.signInWithOtp({email, options:{emailRedirectTo: location.origin + '/api/auth/supabase-callback'}});
    show(error?error.message:'Đã gửi link đăng nhập tới email');
  })
  signin?.addEventListener('click',async()=>{
    const email=emailIn?.value.trim(), password=passIn?.value||'';
    const {data,error}=await supabase.auth.signInWithPassword({email,password});
    if(error){show(error.message);return;}
    const user=data.user;
    if(!user){show('Đăng nhập thất bại');return;}
    await fetch('/api/auth/supabase-session',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({sub:user.id,username:user.email?.split('@')[0],global_name:user.user_metadata?.full_name||null,avatar:user.user_metadata?.avatar_url||null})});
    location.reload();
  })
  signup?.addEventListener('click',async()=>{
    const email=emailIn?.value.trim(), password=passIn?.value||'';
    const {data,error}=await supabase.auth.signUp({email,password, options:{emailRedirectTo: location.origin + '/api/auth/supabase-callback'}});
    if(error){show(error.message);return;}
    if(data.session && data.user){ const user=data.user; await fetch('/api/auth/supabase-session',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({sub:user.id,username:user.email?.split('@')[0],global_name:user.user_metadata?.full_name||null,avatar:user.user_metadata?.avatar_url||null})}); location.reload(); return;}
    show('Kiểm tra email để xác nhận đăng ký');
  })
</script>
