---
import MovieCard from './MovieCard.astro'
import { getCategoryFeedCached } from '../lib/api.server'
import type { Category, Movie } from '../lib/types'

interface Props {
  categories: Category[]
  excludeSlug: string
}

const { categories, excludeSlug } = Astro.props

let items: Movie[] = []

if (categories.length > 0) {
  const lists = await Promise.all(
    categories.slice(0, 4).map((c) =>
      // Đọc qua cache Postgres (`getFeedCached`, limit 12 trùng khoá prewarm) thay vì
      // crawl nguồn mỗi lượt render SSR — trước đây tốn tới ~3.4s/lượt xem.
      getCategoryFeedCached(c.slug, { limit: 12 })
        .then((d) => (Array.isArray(d.items) ? d.items.slice(0, 8) : []))
        .catch(() => [] as Movie[]),
    ),
  )
  const seen = new Set<string>()
  const merged: Movie[] = []
  for (const list of lists) {
    for (const m of list) {
      if (m.slug === excludeSlug || seen.has(m.slug)) continue
      seen.add(m.slug)
      merged.push(m)
    }
  }
  items = merged.slice(0, 6)
}
---

{
  items.length > 0 && (
    <section>
      <h3 class="text-cm-h3 font-semibold text-cm-text mb-3.5">
        Phim tương tự
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-8 gap-2.5">
        {
          items.map((movie) => (
            <MovieCard movie={movie} />
          ))
        }
      </div>
    </section>
  )
}
