---
import MovieCard from './MovieCard.astro'
import { getCategoryFeedCached, getSimilarMoviesCached } from '../lib/api.server'
import type { Category, Country, Movie } from '../lib/types'

interface Props {
  categories: Category[]
  excludeSlug: string
  countries?: Country[]
  director?: string[]
  actor?: string[]
  year?: number
}

const { categories, excludeSlug, countries, director, actor, year } = Astro.props

const TARGET = 6

// Ưu tiên chấm điểm tương đồng trong Postgres (thể loại + quốc gia + đạo diễn +
// diễn viên + năm). Chỉ khi có quá ít kết quả mới lấp thêm bằng feed thể loại.
let items: Movie[] = await getSimilarMoviesCached(
  { slug: excludeSlug, categories, countries, director, actor, year },
  { limit: 12 },
).catch(() => [] as Movie[])

items = items.filter((m) => m.slug !== excludeSlug)

if (items.length < TARGET && categories.length > 0) {
  const lists = await Promise.all(
    categories.slice(0, 4).map((c) =>
      // Đọc qua cache Postgres (`getFeedCached`, limit 12 trùng khoá prewarm) thay vì
      // crawl nguồn mỗi lượt render SSR — trước đây tốn tới ~3.4s/lượt xem.
      getCategoryFeedCached(c.slug, { limit: 12 })
        .then((d) => (Array.isArray(d.items) ? d.items.slice(0, 8) : []))
        .catch(() => [] as Movie[]),
    ),
  )
  const seen = new Set(items.map((m) => m.slug))
  for (const list of lists) {
    for (const m of list) {
      if (m.slug === excludeSlug || seen.has(m.slug)) continue
      seen.add(m.slug)
      items.push(m)
    }
  }
}

items = items.slice(0, TARGET)
---

{
  items.length > 0 && (
    <section>
      <h3 class="text-cm-h3 font-semibold text-cm-text mb-3.5">
        Phim tương tự
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-8 gap-2.5">
        {
          items.map((movie) => (
            <MovieCard movie={movie} />
          ))
        }
      </div>
    </section>
  )
}
