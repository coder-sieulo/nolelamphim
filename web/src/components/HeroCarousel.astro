---
import type { Movie } from '../lib/types'
import { imgUrl } from '../lib/img'
import { FaPlay, FaChevronLeft, FaChevronRight } from 'react-icons/fa6'

interface Props {
  movies: Movie[]
}

const { movies } = Astro.props
const total = movies.length

interface Slide {
  slug: string
  name: string
  origin_name?: string
  year?: number
  quality?: string
  image?: string
}

const slides: Slide[] = movies.map((m) => ({
  slug: m.slug,
  name: m.name,
  origin_name: m.origin_name,
  year: m.year,
  quality: m.quality,
  image: m.poster_url || m.thumb_url,
}))

const dataSlides = movies.map((m) => ({
  slug: m.slug,
  name: m.name,
  origin_name: m.origin_name,
  year: m.year,
  quality: m.quality,
}))

const first = slides[0]
---

<div
  id="hero"
  class="relative group/hero"
  data-slides={JSON.stringify(dataSlides)}
  data-count={total}
>
  <div class="relative overflow-hidden rounded-2xl w-full aspect-[16/10] md:aspect-[21/9] max-h-[80vh] bg-bg-card glass-frame">
    <div
      class="absolute inset-0 z-0"
      aria-hidden
      style="background: radial-gradient(60% 80% at 20% 20%, rgba(196,75,237,0.14) 0%, transparent 55%), radial-gradient(60% 80% at 80% 30%, rgba(74,158,255,0.12) 0%, transparent 55%)"
    ></div>

    <div id="hero-slides" class="absolute inset-0" style="will-change: transform">
      {
        movies.map((movie, i) => {
          const image = imgUrl(movie.poster_url || movie.thumb_url, 1600)
          return (
            <a
             
              href={`/phim/${movie.slug}`}
              class={`hero-slide poster-shell absolute inset-0 block transition-opacity duration-1000 ease-out ${
                i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
              }`}
            >
              {image ? (
                <img
                  src={image}
                  alt={movie.name}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                  class={`w-full h-full object-cover ${i === 0 ? 'ken-burns' : ''}`}
                />
              ) : (
                <div class="w-full h-full bg-bg-card flex items-center justify-center text-text-muted">
                  No image
                </div>
              )}
            </a>
          )
        })
      }
    </div>

    <div class="absolute inset-0 z-20 bg-gradient-to-t from-bg-dark via-bg-dark/25 to-transparent" />

    <div id="hero-content" class="absolute inset-0 z-30 flex items-end pointer-events-none">
      <div id="hero-content-inner" class="w-full pb-6 md:pb-10 px-5 md:px-10">
        {
          first && (
            <>
              <div class="hero-enter">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] md:text-xs font-bold uppercase tracking-widest bg-gradient-to-r from-[#FF6B9D] via-[#C44BED] to-[#4A9EFF] text-white shadow-lg shadow-[#C44BED]/25">
                  {first.year ? `Nổi bật · ${first.year}` : 'Nổi bật'}
                </span>
              </div>
              <h2 class="hero-enter hero-enter-delay-1 mt-3 text-white text-xl md:text-3xl lg:text-4xl font-bold drop-shadow-lg line-clamp-2 max-w-3xl">
                {first.name}
              </h2>
              {first.origin_name && (
                <p class="hero-enter hero-enter-delay-2 mt-1 text-text-secondary text-xs md:text-sm drop-shadow max-w-2xl truncate">
                  {first.origin_name}
                </p>
              )}
              <p class="hero-enter hero-enter-delay-3 mt-4 inline-flex items-center gap-2 text-xs md:text-sm text-white/90 font-medium">
                <a
                  href={`/phim/${first.slug}`}
                  class="pointer-events-auto inline-flex items-center gap-2 px-4 md:px-5 py-2 md:py-2.5 rounded-full bg-white/15 backdrop-blur border border-white/20 transition-all duration-300 hover:bg-white/25 hover:scale-105"
                >
                  <FaPlay className="w-4 h-4" />
                  Xem ngay
                </a>
                {first.quality && (
                  <span class="hidden sm:inline-flex px-3 py-1.5 rounded-full bg-white/10 backdrop-blur border border-white/15 text-text-secondary text-[11px] md:text-xs font-medium">
                    {first.quality}
                  </span>
                )}
              </p>
            </>
          )
        }
      </div>
    </div>

    <div id="hero-counter" class="absolute top-5 right-5 md:top-6 md:right-8 z-40 hidden md:flex items-center gap-2 text-white/70">
      <span class="text-2xl font-bold text-white drop-shadow">01</span>
      <span class="w-8 h-px bg-white/40"></span>
      <span class="text-sm">{String(total).padStart(2, '0')}</span>
    </div>

    <button
      id="hero-prev"
      aria-label="Trước"
      class="absolute left-3 top-1/2 -translate-y-1/2 z-40 w-9 h-9 md:w-11 md:h-11 rounded-full glass-tile text-white flex items-center justify-center opacity-0 group-hover/hero:opacity-100 transition-all duration-300 hover:scale-105"
    >
      <FaChevronLeft className="w-4 h-4 md:w-5 md:h-5" />
    </button>
    <button
      id="hero-next"
      aria-label="Tiếp"
      class="absolute right-3 top-1/2 -translate-y-1/2 z-40 w-9 h-9 md:w-11 md:h-11 rounded-full glass-tile text-white flex items-center justify-center opacity-0 group-hover/hero:opacity-100 transition-all duration-300 hover:scale-105"
    >
      <FaChevronRight className="w-4 h-4 md:w-5 md:h-5" />
    </button>
  </div>

  <div id="hero-dots" class="flex justify-center gap-2.5 mt-4"></div>
</div>

<script>
  import { AUTOPLAY_MS } from '../lib/constants'
  import { escapeHTML } from '../scripts/cards'
  import { registerPageInit } from '../scripts/lifecycle'
  import { iconString } from '../lib/icon-strings'

  interface Slide {
    slug: string
    name: string
    origin_name?: string
    year?: number
    quality?: string
    image?: string
  }

  registerPageInit(() => {
    const root = document.getElementById('hero')
    if (!root) return () => {}
    const hero = root
    const slides: Slide[] = JSON.parse(root.dataset.slides || '[]')
    const total = slides.length

    const slideEls = Array.from(root.querySelectorAll('.hero-slide')) as HTMLAnchorElement[]
    const contentInner = document.getElementById('hero-content-inner')
    const counterEl = document.getElementById('hero-counter')?.querySelector('span')
    const dotsEl = document.getElementById('hero-dots')

    let active = 0
    let paused = false
    let timer: ReturnType<typeof setInterval> | null = null
    let raf = 0

    function contentHTML(s: Slide, _i: number): string {
      const name = escapeHTML(s.name)
      const origin = escapeHTML(s.origin_name)
      const quality = escapeHTML(s.quality)
      const slug = escapeHTML(s.slug)
      const badge = s.year ? `Nổi bật · ${escapeHTML(s.year)}` : 'Nổi bật'
      return `
        <div class="hero-enter">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] md:text-xs font-bold uppercase tracking-widest bg-gradient-to-r from-[#FF6B9D] via-[#C44BED] to-[#4A9EFF] text-white shadow-lg shadow-[#C44BED]/25">${badge}</span>
        </div>
        <h2 class="hero-enter hero-enter-delay-1 mt-3 text-white text-xl md:text-3xl lg:text-4xl font-bold drop-shadow-lg line-clamp-2 max-w-3xl">${name}</h2>
        ${origin ? `<p class="hero-enter hero-enter-delay-2 mt-1 text-text-secondary text-xs md:text-sm drop-shadow max-w-2xl truncate">${origin}</p>` : ''}
        <p class="hero-enter hero-enter-delay-3 mt-4 inline-flex items-center gap-2 text-xs md:text-sm text-white/90 font-medium">
          <a href="/phim/${slug}" class="pointer-events-auto inline-flex items-center gap-2 px-4 md:px-5 py-2 md:py-2.5 rounded-full bg-white/15 backdrop-blur border border-white/20 transition-all duration-300 hover:bg-white/25 hover:scale-105">
            ${iconString('play', 'w-4 h-4')}
            Xem ngay
          </a>
          ${quality ? `<span class="hidden sm:inline-flex px-3 py-1.5 rounded-full bg-white/10 backdrop-blur border border-white/15 text-text-secondary text-[11px] md:text-xs font-medium">${quality}</span>` : ''}
        </p>
      `
    }

    function renderDots() {
      if (!dotsEl) return
      dotsEl.innerHTML = slides
        .map(
          (_, i) => `
          <button
            class="relative h-1.5 rounded-full overflow-hidden transition-all duration-500 ${i === active ? 'w-10 bg-white/25' : 'w-4 bg-white/15 hover:bg-white/30'}"
            aria-label="Slide ${i + 1}"
            data-dot="${i}"
          >
            ${i === active ? `<span class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-[#FF6B9D] to-[#4A9EFF] ${paused ? 'w-full' : 'w-full animate-[progress_linear_forwards]'}" style="animation-duration:${AUTOPLAY_MS}ms"></span>` : ''}
          </button>`,
        )
        .join('')
      dotsEl.querySelectorAll<HTMLButtonElement>('[data-dot]').forEach((btn) => {
        btn.addEventListener('click', () => setActive(Number(btn.dataset.dot)))
      })
    }

    function setActive(i: number) {
      if (total === 0) return
      active = (i + total) % total

      slideEls.forEach((el, idx) => {
        const isActive = idx === active
        el.classList.toggle('opacity-100', isActive)
        el.classList.toggle('z-10', isActive)
        el.classList.toggle('opacity-0', !isActive)
        el.classList.toggle('z-0', !isActive)
        const img = el.querySelector('img')
        if (img) {
          if (isActive) {
            img.classList.add('ken-burns')
            void img.offsetWidth
          } else {
            img.classList.remove('ken-burns')
          }
        }
      })

      if (contentInner) {
        contentInner.innerHTML = contentHTML(slides[active], active)
      }

      if (counterEl) counterEl.textContent = String(active + 1).padStart(2, '0')

      renderDots()
      restart()
    }

    function go(dir: 1 | -1) {
      setActive(active + dir)
    }

    function restart() {
      if (timer) clearInterval(timer)
      if (paused || total <= 1) return
      timer = setInterval(() => go(1), AUTOPLAY_MS)
    }

    // Parallax
    function onScroll() {
      cancelAnimationFrame(raf)
      raf = requestAnimationFrame(() => {
        if (document.hidden) return
        const rect = hero.getBoundingClientRect()
        const height = hero.offsetHeight
        const progress = Math.min(1, Math.max(0, -rect.top / height))
        const slidesEl = document.getElementById('hero-slides')
        if (slidesEl) slidesEl.style.transform = `translateY(${progress * 60}px)`
      })
    }

    function onScrollEnd() {
      cancelAnimationFrame(raf)
    }

    root.addEventListener('mouseenter', () => {
      paused = true
      restart()
    })
    root.addEventListener('mouseleave', () => {
      paused = false
      restart()
    })
    document.getElementById('hero-prev')?.addEventListener('click', () => go(-1))
    document.getElementById('hero-next')?.addEventListener('click', () => go(1))
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('scroll', onScrollEnd, { passive: true })

    renderDots()
    restart()

    return () => {
      if (timer) clearInterval(timer)
      cancelAnimationFrame(raf)
      window.removeEventListener('scroll', onScroll)
      window.removeEventListener('scroll', onScrollEnd)
    }
  })
</script>
