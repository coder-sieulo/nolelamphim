---
// Footer CINEMA MINIMAL — gọn, không glass (brief §24 footer)
const genres = [
  { href: '/the-loai/hanh-dong', label: 'Hành động' },
  { href: '/the-loai/lang-man', label: 'Lãng mạn' },
  { href: '/the-loai/hai', label: 'Hài' },
  { href: '/the-loai/vien-tuong', label: 'Viễn tưởng' },
]
const explore = [
  { href: '/xem-chung', label: 'Xem Chung' },
  { href: '/be-lo-chon-phim', label: 'Bé Lỏ chọn phim' },
  { href: '/phim-dna', label: 'Phim theo DNA' },
  { href: '/download', label: 'Tải App' },
  { href: '/search', label: 'Tìm kiếm' },
]
const legal = [
  { href: '/danh-sach/phim-le', label: 'Phim lẻ' },
  { href: '/danh-sach/phim-bo', label: 'Phim bộ' },
  { href: '/danh-sach/phim-moi-cap-nhat', label: 'Phim mới' },
]
const year = new Date().getFullYear()
---
<footer class="border-t border-cm-border mt-16">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo-64.png" alt="Nô Lệ Làm Phim" width="28" height="28" class="rounded-lg" />
          <span class="font-semibold text-sm text-cm-text">Nô Lệ Làm Phim</span>
        </a>
        <p class="text-xs text-cm-text-3 mt-3 leading-relaxed max-w-52">
          Xem phim đa nền tảng miễn phí, giao diện tối giản, ưu tiên nội dung.
        </p>
      </div>

      <nav aria-label="Khám phá">
        <h4 class="text-xs font-semibold text-cm-text-3 uppercase tracking-widest mb-4">Khám phá</h4>
        <ul class="space-y-3">
          {
            explore.map((link) => (
              <li>
                <a href={link.href} class="text-xs text-cm-text-2 hover:text-cm-text transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Danh mục">
        <h4 class="text-xs font-semibold text-cm-text-3 uppercase tracking-widest mb-4">Danh mục</h4>
        <ul class="space-y-3">
          {
            genres.map((link) => (
              <li>
                <a href={link.href} class="text-xs text-cm-text-2 hover:text-cm-text transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Phim">
        <h4 class="text-xs font-semibold text-cm-text-3 uppercase tracking-widest mb-4">Phim</h4>
        <ul class="space-y-3">
          {
            legal.map((link) => (
              <li>
                <a href={link.href} class="text-xs text-cm-text-2 hover:text-cm-text transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex items-center justify-between gap-4 mt-10 pt-6 border-t border-cm-border">
      <p class="text-xs text-cm-text-3">
        © {year} Nô Lệ Làm Phim.
      </p>
      <p class="coder-credit text-cm-text-3 text-xs tracking-[0.25em] font-semibold">
        MADE BY LỎ
      </p>
    </div>
  </div>
</footer>