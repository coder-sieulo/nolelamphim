---
import { searchMovies, getMoviesByCountry, getMoviesByCategory } from '../lib/api'
import MovieGrid from './MovieGrid.astro'
import type { Movie } from '../lib/types'
import { FaTv, FaDice, FaMagnifyingGlass, FaFlag, FaHeart } from 'react-icons/fa6'

interface Topic {
  slug: string
  name: string
  keyword: string
  icon: any
  fetch: () => Promise<Movie[]>
}

async function vietMovies(limit = 8): Promise<Movie[]> {
  for (const slug of ['viet-nam', 'việt-nam', 'vietnam']) {
    const d = await getMoviesByCountry(slug, { limit }).catch(() => null)
    if (d && d.items && d.items.length > 0) return d.items
  }
  return getMoviesByCategory('hoat-hinh', { limit }).then((d: any) => d.items ?? [])
}

const topics: Topic[] = [
  { slug: 'doraemon', name: 'Ăn cơm cùng Doraemon', keyword: 'Doraemon', icon: FaTv, fetch: () => searchMovies('Doraemon', 1, 8).then((d: any) => d.items ?? []) },
  { slug: 'shin', name: 'Quậy cùng Shin', keyword: 'Shin', icon: FaDice, fetch: () => searchMovies('Shin', 1, 8).then((d: any) => d.items ?? []) },
  { slug: 'conan', name: 'Phá án cùng Conan', keyword: 'Conan', icon: FaMagnifyingGlass, fetch: () => searchMovies('Conan', 1, 8).then((d: any) => d.items ?? []) },
  { slug: 'phim-viet', name: 'Mê phim việt', keyword: 'phim việt', icon: FaFlag, fetch: vietMovies },
  { slug: 'quat-chien', name: 'Tôi yêu nước', keyword: 'phim cách mạng việt nam', icon: FaHeart, fetch: vietMovies },
]

const topicMovies = await Promise.all(
  topics.map(async (t) => {
    const items = await t.fetch().catch(() => [] as Movie[])
    return { slug: t.slug, name: t.name, keyword: t.keyword, icon: t.icon, items }
  }),
)
---

<section class="mt-10 cv-auto">
  <div class="liquid-glass rounded-3xl px-4 sm:px-6 py-5">
    <h2 class="text-sm font-semibold text-text-primary mb-4">Chủ đề</h2>

    <div class="flex gap-2.5 overflow-x-auto pb-2 scrollbar-none mb-5" id="topic-pills">
      {topicMovies.map((t, i) => {
        const Icon = t.icon
        return (
          <button
            type="button"
            class="topic-pill shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-xl glass-tile text-xs font-medium text-text-secondary hover:text-white hover:border-[#C44BED]/40 transition-all"
            data-slug={t.slug}
          >
            <Icon className="w-4 h-4" />
            {t.name}
          </button>
        )
      })}
    </div>

    <div id="topic-content">
      {topicMovies.map((t) => (
        <div class="topic-panel" data-slug={t.slug}>
          {t.items.length > 0 ? (
            <MovieGrid initialItems={t.items} path={`/tim-kiem?q=${encodeURIComponent(t.keyword)}`} dot="hot" totalPages={10} />
          ) : (
            <div class="py-6 flex flex-col items-center justify-center text-center">
              <p class="text-text-muted text-xs">Không tìm thấy phim cho chủ đề này</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const pills = document.getElementById('topic-pills')
  const panels = document.querySelectorAll<HTMLDivElement>('.topic-panel')

  function showSlug(slug: string) {
    panels.forEach((p) => {
      p.style.display = p.dataset.slug === slug ? '' : 'none'
    })
    pills?.querySelectorAll<HTMLButtonElement>('.topic-pill').forEach((b) => {
      b.classList.toggle('border-[#C44BED]/40', b.dataset.slug === slug)
      b.classList.toggle('text-white', b.dataset.slug === slug)
    })
  }

  const first = pills?.querySelector<HTMLButtonElement>('.topic-pill')
  if (first) showSlug(first.dataset.slug || '')

  pills?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.topic-pill')
    if (!btn) return
    showSlug(btn.dataset.slug || '')
  })
</script>