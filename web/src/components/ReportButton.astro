---
import { CONTACT_EMAIL } from '../lib/site'
import { FaTriangleExclamation } from 'react-icons/fa6'

interface Props {
  slug: string
  name: string
  episode?: string
}

const { slug, name, episode } = Astro.props

const ISSUES = [
  { id: 'broken', label: 'Không xem được / lỗi phát' },
  { id: 'wrong-episode', label: 'Sai tập / sai phim' },
  { id: 'subtitle', label: 'Lỗi phụ đề' },
  { id: 'image', label: 'Sai poster / ảnh' },
  { id: 'other', label: 'Khác' },
]

/* Chip báo lỗi đang chọn — phẳng (dùng .sort-active như bộ lọc Phase 3) */
const issueActive = 'report-issue w-full text-left px-3.5 py-2.5 rounded-[var(--radius-cm-btn)] text-xs transition-all sort-active'
const issueIdle =
  'report-issue w-full text-left px-3.5 py-2.5 rounded-[var(--radius-cm-btn)] text-xs transition-all border border-cm-border bg-cm-surface text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated'
---

<div class="report-btn relative" data-slug={slug} data-name={name} data-episode={episode || ''} data-email={CONTACT_EMAIL}>
  <button
    type="button"
    class="report-trigger inline-flex h-9 items-center gap-1.5 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface/80 px-3.5 text-cm-meta text-cm-text-3 transition-colors duration-[var(--duration-cm)] hover:border-cm-border-strong hover:bg-cm-elevated hover:text-cm-text"
    aria-label="Báo lỗi phim"
    title="Báo lỗi phim"
  >
    <FaTriangleExclamation className="w-3.5 h-3.5" />
    Báo lỗi
  </button>

  <div class="report-modal hidden fixed inset-0 z-50 flex items-center justify-center bg-cm-bg/80 p-4">
    <div class="w-full max-w-sm rounded-[var(--radius-cm-modal)] border border-cm-border bg-cm-elevated p-5 shadow-[var(--shadow-cm-up)]">
      <h3 class="text-sm font-semibold text-cm-text mb-4">Báo lỗi phim</h3>
      <div class="report-issues flex flex-col gap-1.5 mb-4">
        {
          ISSUES.map((i, idx) => (
            <button
              type="button"
              class={idx === 0 ? issueActive : issueIdle}
              data-value={i.id}
            >
              {i.label}
            </button>
          ))
        }
      </div>
      <textarea
        class="report-note w-full px-3.5 py-2.5 rounded-[var(--radius-cm-input)] bg-cm-surface border border-cm-border text-cm-body text-cm-text outline-none resize-none focus:border-cm-border-strong placeholder:text-cm-text-3"
        placeholder="Ghi chú thêm (không bắt buộc)..."
        rows="3"
      ></textarea>
      <div class="flex gap-2 mt-4">
        <button class="report-cancel flex-1 h-10 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]">
          Huỷ
        </button>
        <button class="report-submit flex-1 h-10 rounded-[var(--radius-cm-btn)] bg-cm-accent text-white text-cm-meta font-medium hover:bg-cm-accent-hover transition-colors duration-[var(--duration-cm)]">
          Gửi báo lỗi
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { registerPageInit } from '../scripts/lifecycle'

  registerPageInit(() => {
    document.querySelectorAll<HTMLElement>('.report-btn').forEach((box) => {
      const slug = box.dataset.slug || ''
      const name = box.dataset.name || ''
      const episode = box.dataset.episode || ''
      const email = box.dataset.email || ''
      const trigger = box.querySelector<HTMLButtonElement>('.report-trigger')
      const modal = box.querySelector<HTMLElement>('.report-modal')
      const issues = Array.from(box.querySelectorAll<HTMLButtonElement>('.report-issue'))
      const note = box.querySelector<HTMLTextAreaElement>('.report-note')
      const cancel = box.querySelector<HTMLButtonElement>('.report-cancel')
      const submit = box.querySelector<HTMLButtonElement>('.report-submit')

      let issue = issues[0]?.dataset.value || ''

      const issueActive = 'report-issue w-full text-left px-3.5 py-2.5 rounded-[var(--radius-cm-btn)] text-xs transition-all sort-active'
      const issueIdle =
        'report-issue w-full text-left px-3.5 py-2.5 rounded-[var(--radius-cm-btn)] text-xs transition-all border border-cm-border bg-cm-surface text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated'

      function setActive() {
        issues.forEach((el) => {
          el.className = el.dataset.value === issue ? issueActive : issueIdle
        })
      }

      trigger?.addEventListener('click', () => {
        modal?.classList.remove('hidden')
      })
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden')
      })
      cancel?.addEventListener('click', () => {
        modal?.classList.add('hidden')
        if (note) note.value = ''
      })
      issues.forEach((el) => {
        el.addEventListener('click', () => {
          issue = el.dataset.value || ''
          setActive()
        })
      })

      submit?.addEventListener('click', () => {
        const subject = `[Báo lỗi] ${name}${episode ? ` - ${episode}` : ''}`
        const body =
          `Phim: ${name}\n` +
          `Liên kết: ${window.location.origin}/phim/${slug}\n` +
          (episode ? `Tập: ${episode}\n` : '') +
          `Vấn đề: ${issues.find((i) => i.dataset.value === issue)?.textContent?.trim()}\n` +
          (note?.value ? `Ghi chú: ${note.value}\n` : '')
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
        modal?.classList.add('hidden')
        if (note) note.value = ''
      })
    })
  })
</script>