---
interface Props {
  id: number
  name: string
  slug: string
  thumb: string
  vote?: string
}

const { id, name, slug, thumb, vote = '' } = Astro.props
---

<button
  class="fav-button px-4 py-2 rounded-xl text-xs font-medium transition-all duration-200 glass-tile text-text-secondary hover:text-white"
  data-id={id}
  data-name={name}
  data-slug={slug}
  data-thumb={thumb}
  data-vote={vote}
  aria-pressed="false"
>
  <span class="fav-label">♡ Yêu thích</span>
</button>

<script>
  import { isFavorite, toggleFavorite, getFavorites, writeJSON } from '../scripts/store'
  import { registerPageInit } from '../scripts/lifecycle'

  registerPageInit(() => {
    document.querySelectorAll<HTMLButtonElement>('.fav-button').forEach((btn) => {
      const id = Number(btn.dataset.id)
      const item = {
        id,
        name: btn.dataset.name || '',
        slug: btn.dataset.slug || '',
        thumb: btn.dataset.thumb || '',
        tmdb_vote: btn.dataset.vote || undefined,
      }
      const label = btn.querySelector('.fav-label')

      const update = (active: boolean) => {
        btn.classList.toggle('fav-active', active)
        btn.classList.toggle('glass-tile', !active)
        btn.classList.toggle('text-text-secondary', !active)
        if (label) label.textContent = active ? '♥ Đã thích' : '♡ Yêu thích'
        btn.setAttribute('aria-pressed', String(active))
      }

      async function authedUser(): Promise<boolean> {
        try {
          const r = await fetch('/api/auth/me', { credentials: 'same-origin' })
          const d = await r.json()
          return Boolean(d?.user)
        } catch {
          return false
        }
      }

      update(isFavorite(id))

      void (async () => {
        // Đã đăng nhập → hợp nhất thư viện trên tài khoản vào máy để nút hiện đúng trạng thái.
        try {
          const me = await fetch('/api/auth/me', { credentials: 'same-origin' }).then((r) => r.json())
          if (!me?.user) return
          const res = await fetch('/api/user/lib', { credentials: 'same-origin' }).then((r) => r.json())
          const server = Array.isArray(res?.lib?.favorites) ? res.lib.favorites : []
          const merged = server.slice()
          for (const f of getFavorites()) {
            if (!merged.some((m: { slug: string }) => m.slug === f.slug)) merged.push(f)
          }
          writeJSON('favorites', merged)
          update(merged.some((f: { slug: string }) => f.slug === item.slug))
        } catch {
          /* thư viện máy vẫn hoạt động */
        }
      })()

      btn.addEventListener('click', async () => {
        const active = toggleFavorite(item)
        update(active)
        if (await authedUser()) {
          fetch('/api/user/favorite', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ item: { ...item }, on: active }),
          }).catch(() => {})
        }
      })
    })
  })
</script>
