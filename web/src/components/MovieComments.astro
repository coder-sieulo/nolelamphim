---
import { escapeHTML } from '../lib/movieCard'
import type { MovieComment } from '../lib/comments'
import type { SessionPayload } from '../lib/auth'

interface Props {
  slug: string
  comments: MovieComment[]
  total: number
  user: SessionPayload | null
  isAdmin: boolean
}

const { slug, comments, total, user, isAdmin } = Astro.props
const currentId = user?.sub || ''



function timeAgo(ts: number): string {
  const diff = Date.now() - ts
  const min = Math.floor(diff / 60000)
  if (min < 1) return 'vừa xong'
  if (min < 60) return `${min} phút trước`
  const hr = Math.floor(min / 60)
  if (hr < 24) return `${hr} giờ trước`
  const day = Math.floor(hr / 24)
  if (day < 30) return `${day} ngày trước`
  return new Date(ts).toLocaleDateString('vi-VN')
}


function avatarHTML(c: MovieComment): string {
  if (c.avatar) {
    return `<img src="https://cdn.discordapp.com/avatars/${escapeHTML(c.userId)}/${escapeHTML(c.avatar)}.png?size=64" alt="" width="40" height="40" loading="lazy" class="w-10 h-10 rounded-full object-cover" /></img>`
  }
  return `<div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#5865F2] to-[#FF6B9D] flex items-center justify-center text-white text-sm font-bold">${escapeHTML((c.username || '?').slice(0, 1).toUpperCase())}</div>`
}


function commentItemHTML(c: MovieComment, canDelete: boolean): string {
  return `
    <div class="movie-comment flex gap-3 py-3.5 border-b border-white/5 group" data-cid="${escapeHTML(c.id)}">
      ${avatarHTML(c)}
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-sm font-semibold text-text-primary truncate">${escapeHTML(c.username)}</span>
          '<span class="text-[10px] px-1.5 py-0.5 rounded-full bg-[#5865F2]/20 text-[#8b99ff]">Bạn</span>'
          '<span class="text-[10px] px-1.5 py-0.5 rounded-full bg-[#FF6B9D]/15 text-[#FF6B9D]">Admin</span>'
          <span class="text-[11px] text-text-muted">${escapeHTML(timeAgo(c.ts))}</span>
        </div>
        <p class="text-sm text-text-secondary mt-1 break-words whitespace-pre-wrap">${escapeHTML(c.text)}</p>
      </div>
      <button type="button" class="cmt-delete shrink-0 self-start w-7 h-7 rounded-lg glass-tile text-text-muted hover:text-red-400 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" data-cid="${escapeHTML(c.id)}" aria-label="Xoá bình luận"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
    </div>
  `
}

const commentsHTML = (() => { const _r: string[] = []; for (const c of comments) _r.push(commentItemHTML(c, isAdmin || c.userId === currentId)); return _r.join(''); })()
const countText = total > 0 ? '(' + total + ')' : ''
---

<section id="comments-root" class="mt-8" data-slug={slug} data-init-shown={comments.length} data-total={total} data-me={currentId} data-admin={isAdmin ? '1' : '0'}>
  <h2 class="text-base font-semibold text-text-primary mb-4 flex items-center gap-2">
    <svg class="w-4 h-4 text-[#4A9EFF]" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/></svg>
    Bình luận
    <span id="cmt-count" class="text-[11px] text-text-muted font-normal">{countText}</span>
  </h2>

  {
    user ? (
      <>
        <form id="cmt-form" class="flex gap-2.5 mb-2">
          <textarea
            id="cmt-input"
            rows={2}
            maxlength={500}
            required
            placeholder="Chia sẻ cảm nghĩ về phim… (đã đăng nhập là @{user.username})"
            class="flex-1 resize-none px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 text-sm text-text-primary placeholder:text-text-muted/60 focus:outline-none focus:ring-1 focus:ring-[#C44BED]/50 transition-colors"
          ></textarea>
          <button id="cmt-submit" type="submit" class="self-end px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#FF6B9D] to-[#C44BED] text-white text-sm font-semibold hover:opacity-90 disabled:opacity-50 transition-opacity">
            Gửi
          </button>
        </form>
        <p id="cmt-error" class="hidden text-[11px] text-red-400 mb-2"></p>
      </>
    ) : (
      <a href="/api/auth/discord" class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 text-sm text-text-secondary hover:text-white hover:bg-white/[0.07] transition-colors mb-2">
        <span class="text-[#5865F2]">Đăng nhập Discord</span> để bình luận
      </a>
    )
  }

  <div id="cmt-list" set:html={commentsHTML}></div>

  {comments.length < total && (
    <button id="cmt-more" type="button" class="mt-4 w-full py-2.5 rounded-xl glass-tile text-xs text-text-secondary hover:text-white hover:bg-white/5 transition-colors">
      Xem thêm bình luận…
    </button>
  )}

  <script>
    import "../scripts/movie-comments"
  </script>
</section>