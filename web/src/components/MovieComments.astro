---
/**
 * MovieComments — khối bình luận phim.
 *
 * **4.2 (ISR/CDN an toàn)**: component này KHÔNG được đọc session ở SSR nữa —
 * toàn bộ dữ liệu người dùng (danh tính, quyền xoá, danh sách bình luận) do
 * client nạp:
 *
 *   `GET /api/auth/me`                     → biết đã đăng nhập chưa + cờ admin
 *   `GET /api/movie/{slug}/comments?…`     → 20 bình luận đầu + tổng số
 *
 * Nhờ vậy HTML của `/phim/[slug]` giống hệt nhau với mọi người dùng ⇒ bật được
 * cache CDN công khai (`s-maxage=300, stale-while-revalidate=3600`).
 *
 * Giữ NGUYÊN id/class (`#comments-root`, `#cmt-list`, `#cmt-form`, `#cmt-more`,
 * `data-slug`, `.cmt-delete`…) để script `scripts/movie-comments.ts` chạy tiếp.
 */
import { FaComment } from 'react-icons/fa6'

interface Props {
  slug: string
  /** Prefill cache-warm (không bắt buộc): bình luận fetch sẵn từ server. */
  comments?: unknown[]
  total?: number
}

const { slug, comments = [], total = 0 } = Astro.props

/** Trạng thái server luôn là "chưa biết" — client sẽ điền sau khi gọi /api/auth/me. */
const skeleton = `
      <div class="cmt-skeleton space-y-3" aria-hidden="true">
        ${'<div class="flex gap-3 py-3.5"><div class="w-10 h-10 rounded-full bg-cm-elevated shrink-0"></div><div class="flex-1 space-y-2"><div class="h-3 w-28 rounded bg-cm-elevated"></div><div class="h-3 w-3/4 rounded bg-cm-elevated"></div></div></div>'.repeat(2)}
      </div>`
---

<section
  id="comments-root"
  class="mt-2"
  data-slug={slug}
  data-total={total}
  data-hydrated="0"
  data-async="1"
>
  <h2 class="text-cm-h3 font-semibold text-cm-text mb-4 flex items-center gap-2">
    <FaComment className="w-4 h-4 text-cm-text-3" />
    Bình luận
    <span id="cmt-count" class="text-cm-meta text-cm-text-3 font-normal">{total > 0 ? `(${total})` : ''}</span>
    <div class="ml-auto flex items-center gap-1 text-cm-meta">
      <button type="button" class="cmt-sort px-2 py-1 rounded-[4px] text-cm-text-2" data-sort="newest">Mới nhất</button>
      <button type="button" class="cmt-sort px-2 py-1 rounded-[4px] text-cm-text-3 hover:text-cm-text" data-sort="liked">Nhiều lượt thích</button>
    </div>
  </h2>

  {/* Vùng form: client thay bằng form thật hoặc nút đăng nhập sau khi biết danh tính. */}
  <div id="cmt-auth-slot">
    <div class="h-[68px] rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border animate-pulse"></div>
  </div>
  <p id="cmt-error" class="hidden text-cm-meta text-red-400 mb-2"></p>

  <div id="cmt-list" set:html={skeleton}></div>

  <button
    id="cmt-more"
    type="button"
    class="mt-4 w-full h-10 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)] hidden"
  >
    Xem thêm bình luận…
  </button>

  <script>
    import "../scripts/movie-comments"
  </script>
</section>
