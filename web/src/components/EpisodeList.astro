---
import type { EpisodeServer } from '../lib/types'
import { PER_PAGE } from '../lib/constants'
import { pageList } from '../lib/pagination'

interface Props {
  slug: string
  servers: EpisodeServer[]
}

const { slug, servers } = Astro.props

const serverData = servers.map((s) => ({
  name: s.server_name.trim(),
  items: s.list.map((e) => ({ name: e.name, slug: e.slug })),
}))

const current = servers[0]
const totalPages = Math.max(1, Math.ceil((current?.list.length ?? 0) / PER_PAGE))
const initialEpisodes = current ? current.list.slice(0, PER_PAGE) : []

function pagesHTML(page: number, total: number): string {
  return pageList(page, total)
    .map((p) =>
      p === '...'
        ? `<span class="px-2 text-text-muted text-xs">...</span>`
        : `<button type="button" class="ep-page w-9 h-9 rounded-xl text-sm font-medium transition-all duration-200 ${
            p === page ? 'pagination-active' : 'glass-tile text-text-secondary hover:text-white'
          }" data-page="${p}">${p}</button>`,
    )
    .join('')
}

const dataAttr = serverData.length > 0 ? JSON.stringify(serverData) : '[]'
---

<div class="episode-list" data-slug={slug} data-servers={dataAttr} data-per-page={PER_PAGE}>
  <div class="episode-panel">
    <div class="episode-header flex items-center justify-between gap-3 px-5 py-3 border-b border-white/10">
      <h3 class="flex items-center gap-2 text-sm font-bold text-text-primary">
        <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-gradient-to-br from-[#FF6B9D] to-[#C44BED] text-white shadow-[0_2px_10px_rgba(196,75,237,0.4)]">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="episode-title-text">Tập phim</span>
        {totalPages > 1 && (
          <span class="ep-count text-[11px] font-medium text-text-muted ml-1">
            ({current?.list.length ?? 0} tập)
          </span>
        )}
      </h3>
      <form id="episode-jump" class="episode-jump flex items-center gap-1.5 hidden" role="search" aria-label="Nhảy tới tập">
        <input
          id="episode-jump-input"
          type="number"
          min="1"
          inputmode="numeric"
          placeholder="Số tập"
          aria-label="Nhập số tập"
          class="w-20 px-2.5 py-1.5 rounded-xl bg-white/10 border border-white/15 text-text-secondary text-xs outline-none placeholder:text-text-muted focus:ring-1 focus:ring-[#C44BED]/60 focus:border-[#C44BED]/50 text-center"
        />
        <button
          type="submit"
          class="px-3 py-1.5 rounded-xl bg-white/10 border border-white/15 text-text-secondary text-xs hover:text-white hover:border-[#C44BED]/50 transition-all"
        >
          Nhảy
        </button>
      </form>
    </div>

    <div class="px-5 py-4">
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        {
          servers.length > 1 &&
            servers.map((s, i) => (
              <button
                
                type="button"
                class={`ep-server px-3 py-1.5 rounded-xl text-xs font-medium transition-all border ${
                  i === 0
                    ? 'glass-tile-active text-white border-white/20'
                    : 'glass-tile text-text-secondary border-white/10'
                }`}
                data-server={i}
              >
                {s.server_name.trim()}
              </button>
            ))
        }
      </div>

      <div
        id="episode-grid"
        class="flex flex-wrap gap-2"
      >
        {
          initialEpisodes.length > 0 ? (
            initialEpisodes.map((ep) => (
              <a
                
                href={`/xem/${slug}/${ep.slug}`}
                class="ep-btn w-12 h-12 sm:w-14 sm:h-14 rounded-xl text-xs flex items-center justify-center"
              >
                {ep.name}
              </a>
            ))
          ) : (
            <div class="w-full py-8 flex flex-col items-center justify-center text-center">
              <p class="text-text-muted text-xs">Chưa có tập nào cho bộ phim này</p>
              <p class="text-text-muted/70 text-[11px] mt-1">Vui lòng quay lại sau</p>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <div id="episode-pagination" class="flex flex-wrap items-center justify-center gap-1.5 mt-3">
    {
      totalPages > 1 && (
        <>
          <button type="button" class="w-9 h-9 rounded-xl glass-tile text-text-secondary hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-colors" disabled>«</button>
          <button type="button" class="w-9 h-9 rounded-xl glass-tile text-text-secondary hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-colors" disabled>‹</button>
          {pagesHTML(1, totalPages)}
          <button type="button" class="w-9 h-9 rounded-xl glass-tile text-text-secondary hover:text-white transition-colors">›</button>
          <button type="button" class="w-9 h-9 rounded-xl glass-tile text-text-secondary hover:text-white transition-colors">»</button>
        </>
      )
    }
  </div>
</div>

<script>
  import { escapeHTML } from '../scripts/cards'
  import { pageList } from '../lib/pagination'
  import { registerPageInit } from '../scripts/lifecycle'

  registerPageInit(() => {
    const list = document.querySelector<HTMLElement>('.episode-list')
    if (!list) return () => {}
    const slug = list.dataset.slug || ''
    const PER_PAGE = Number(list.dataset.perPage) || 24
    let servers: { name: string; items: { name: string; slug: string }[] }[] = []
    try {
      servers = JSON.parse(list.dataset.servers || '[]')
    } catch {
      servers = []
    }
    const grid = document.getElementById('episode-grid')
    const pagination = document.getElementById('episode-pagination')
    const serverBtns = Array.from(list.querySelectorAll<HTMLButtonElement>('.ep-server'))
    const countEl = list.querySelector<HTMLElement>('.ep-count')
    const jumpForm = document.getElementById('episode-jump') as HTMLFormElement | null
    const jumpInput = document.getElementById('episode-jump-input') as HTMLInputElement | null

    let serverIdx = 0
    let page = 1

    function toggleJumpVisibility() {
      const totalItems = currentServer().items.length
      if (jumpForm) jumpForm.classList.toggle('hidden', totalItems <= PER_PAGE)
    }

    jumpForm?.addEventListener('submit', (e) => {
      e.preventDefault()
      const value = Number(jumpInput?.value)
      if (!value || Number.isNaN(value)) return
      const items = currentServer().items
      const it = items.find((x) => {
        const num = Number((x.name || '').match(/\d+/)?.[0])
        return num === value
      })
      if (it) window.location.href = `/xem/${slug}/${it.slug}`
    })

    function currentServer() {
      return servers[serverIdx] || servers[0] || { name: '', items: [] }
    }

    function pagesHTML(total: number): string {
      return pageList(page, total)
        .map((p) =>
          p === '...'
            ? `<span class="px-2 text-text-muted text-xs">...</span>`
            : `<button type="button" class="ep-page w-9 h-9 rounded-xl text-sm font-medium transition-all duration-200 ${
                p === page ? 'pagination-active' : 'glass-tile text-text-secondary hover:text-white'
              }" data-page="${p}">${p}</button>`,
        )
        .join('')
    }

    function render() {
      const server = currentServer()
      const items = server.items
      const total = Math.max(1, Math.ceil(items.length / PER_PAGE))
      const start = (page - 1) * PER_PAGE
      const visible = items.slice(start, start + PER_PAGE)

      if (grid) {
        grid.innerHTML =
          visible.length > 0
            ? visible
                .map(
                  (ep) =>
                    `<a href="/xem/${slug}/${escapeHTML(ep.slug)}" class="ep-btn w-12 h-12 sm:w-14 sm:h-14 rounded-xl text-xs flex items-center justify-center">${escapeHTML(ep.name)}</a>`,
                )
                .join('')
            : `<div class="w-full py-8 flex flex-col items-center justify-center text-center">
                <p class="text-text-muted text-xs">Chưa có tập nào cho bộ phim này</p>
                <p class="text-text-muted/70 text-[11px] mt-1">Vui lòng quay lại sau</p>
              </div>`
      }

      serverBtns.forEach((btn) => {
        const i = Number(btn.dataset.server)
        const active = i === serverIdx
        btn.className = active
          ? `ep-server px-3 py-1.5 rounded-xl text-xs font-medium transition-all glass-tile-active text-white`
          : `ep-server px-3 py-1.5 rounded-xl text-xs font-medium transition-all glass-tile text-text-secondary`
      })

      if (countEl) countEl.textContent = `${items.length} tập`
      toggleJumpVisibility()

      if (pagination) {
        pagination.innerHTML =
          total > 1
            ? `
              <button type="button" class="ep-first w-9 h-9 rounded-xl glass-tile text-text-secondary hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-colors" ${page <= 1 ? 'disabled' : ''}>«</button>
              <button type="button" class="ep-prev w-9 h-9 rounded-xl glass-tile text-text-secondary hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-colors" ${page <= 1 ? 'disabled' : ''}>‹</button>
              ${pagesHTML(total)}
              <button type="button" class="ep-next w-9 h-9 rounded-xl glass-tile text-text-secondary hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-colors" ${page >= total ? 'disabled' : ''}>›</button>
              <button type="button" class="ep-last w-9 h-9 rounded-xl glass-tile text-text-secondary hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-colors" ${page >= total ? 'disabled' : ''}>»</button>
            `
            : ''
        pagination.querySelectorAll<HTMLButtonElement>('.ep-page').forEach((btn) => {
          btn.addEventListener('click', () => {
            page = Number(btn.dataset.page)
            render()
          })
        })
        pagination.querySelector<HTMLButtonElement>('.ep-prev')?.addEventListener('click', () => {
          page = Math.max(1, page - 1)
          render()
        })
        pagination.querySelector<HTMLButtonElement>('.ep-next')?.addEventListener('click', () => {
          const total = Math.max(1, Math.ceil(currentServer().items.length / PER_PAGE))
          page = Math.min(total, page + 1)
          render()
        })
        pagination.querySelector<HTMLButtonElement>('.ep-first')?.addEventListener('click', () => {
          page = 1
          render()
        })
        pagination.querySelector<HTMLButtonElement>('.ep-last')?.addEventListener('click', () => {
          page = Math.max(1, Math.ceil(currentServer().items.length / PER_PAGE))
          render()
        })
      }
    }

    serverBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        serverIdx = Number(btn.dataset.server)
        page = 1
        render()
      })
    })

    render()
    return () => {}
  })
</script>
