---
/**
 * ShareButton — chia sẻ phim (CINEMA MINIMAL, Phase 4).
 * Nút tròn phẳng; popover dropdown phẳng (không glass). Giữ logic cũ.
 */
import { SITE_URL } from '../lib/site'
import { FiShare2, FiLink } from 'react-icons/fi'
import { FaSquareFacebook } from 'react-icons/fa6'

interface Props {
  slug: string
  name: string
}

const { slug, name } = Astro.props
const url = `${SITE_URL}/phim/${slug}`
---

<div class="share-btn relative" data-url={url} data-name={name}>
  <button
    type="button"
    class="share-trigger flex h-11 w-11 items-center justify-center rounded-full border border-cm-border bg-cm-surface/80 text-cm-text-2 transition-colors duration-[var(--duration-cm)] hover:border-cm-border-strong hover:bg-cm-elevated hover:text-cm-text"
    aria-label="Chia sẻ"
    title="Chia sẻ phim"
  >
    <FiShare2 className="w-[18px] h-[18px]" />
  </button>

  <div class="share-popover dropdown absolute right-0 top-13 z-50 w-48 rounded-[var(--radius-cm-modal)] border border-cm-border bg-cm-elevated p-1.5 flex flex-col gap-0.5 shadow-[var(--shadow-cm-up)]">
    <button class="share-copy flex items-center gap-2.5 px-3 py-2 rounded-[var(--radius-cm-btn)] text-xs text-cm-text-2 hover:bg-cm-surface hover:text-cm-text transition-colors">
      <FiLink className="w-4 h-4" />
      <span class="share-copy-label">Copy liên kết</span>
    </button>
    <a
      class="flex items-center gap-2.5 px-3 py-2 rounded-[var(--radius-cm-btn)] text-xs text-cm-text-2 hover:bg-cm-surface hover:text-cm-text transition-colors"
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <FaSquareFacebook className="w-4 h-4" />
      Chia sẻ Facebook
    </a>
  </div>
</div>

<script>
  import { registerPageInit } from '../scripts/lifecycle'

  registerPageInit(() => {
    const ac = new AbortController()

    document.querySelectorAll<HTMLElement>('.share-btn').forEach((box) => {
      const url = box.dataset.url || ''
      const name = box.dataset.name || ''
      const trigger = box.querySelector<HTMLButtonElement>('.share-trigger')
      const popover = box.querySelector<HTMLElement>('.share-popover')
      const copyBtn = box.querySelector<HTMLButtonElement>('.share-copy')
      const copyLabel = box.querySelector('.share-copy-label')

      trigger?.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title: name, url })
            return
          } catch {
            // fall through to popover
          }
        }
        popover?.classList.toggle('open')
      }, { signal: ac.signal })

      document.addEventListener('click', (e) => {
        if (!box.contains(e.target as Node)) popover?.classList.remove('open')
      }, { signal: ac.signal })

      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url)
        } catch {
          const el = document.createElement('textarea')
          el.value = url
          document.body.appendChild(el)
          el.select()
          document.execCommand('copy')
          document.body.removeChild(el)
        }
        if (copyLabel) copyLabel.textContent = 'Đã copy!'
        setTimeout(() => {
          if (copyLabel) copyLabel.textContent = 'Copy liên kết'
        }, 2000)
      }, { signal: ac.signal })
    })

    return () => ac.abort()
  })
</script>