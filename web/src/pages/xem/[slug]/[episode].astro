---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ReportButton from '../../../components/ReportButton.astro'
import ThemeBG from '../../../components/ThemeBG.astro'
import HorrorGate from '../../../components/HorrorGate.astro'
import { getMovieDetail, getMovieEpisodes } from '../../../lib/api.server'
import { resolveIdentity } from '../../../lib/identity'
import { getKkphimDetail, buildM3u8Map } from '../../../lib/kkphim'
import { imgUrl, imgProxyUrl, imgSrcSet } from '../../../lib/img'
import { SITE_URL } from '../../../lib/site'
import { breadcrumbLd } from '../../../lib/seo'
import { isRealHls } from '../../../lib/hls'
import { FaCirclePlay, FaChevronLeft, FaChevronRight, FaListUl, FaXmark, FaChevronDown } from 'react-icons/fa6'

const slug = Astro.params.slug ?? ''
const episode = Astro.params.episode ?? ''

const [data, epRes] = await Promise.all([
  getMovieDetail(slug).catch(() => ({ status: false, movie: null })),
  getMovieEpisodes(slug),
])

if (!data.status || !data.movie) {
  return Astro.redirect('/404', 404)
}

const movie = data.movie
const episodes = epRes.status ? epRes.episodes : []

/*
 * Ưu tiên phát m3u8 thật của kkphim (nguồn V3) cho tập đang xem.
 * Ghép tập vsmov ↔ kkphim theo tên/thứ tự; chỉ áp cho server đầu (mặc định).
 * Không có kkphim hoặc ghép thất bại → giữ embed như cũ.
 */
let m3u8Map: Record<string, string> = {}
try {
  const identity = await resolveIdentity(slug, 'vsmov')
  if (identity.kkphim) {
    const kk = await getKkphimDetail(identity.kkphim)
    if (kk) m3u8Map = buildM3u8Map(episodes, kk)
  }
} catch {
  m3u8Map = {}
}

const serverData = episodes.map((s, si) => ({
  name: s.server_name.replace(/\s+/g, ' ').trim(),
  items: s.list.map((e) => ({
    name: e.name,
    slug: e.slug,
    embed: e.embed,
    // m3u8 thật lấy từ kkphim (m3u8 của vsmov là link embed, KHÔNG phải HLS).
    // Chỉ nhận khi đúng là HLS thật — tránh thử hls.js vô ích rồi mới rơi về iframe.
    ...(si === 0 && m3u8Map[e.slug]
      ? { m3u8: m3u8Map[e.slug] }
      : isRealHls(e.m3u8)
        ? { m3u8: e.m3u8 }
        : {}),
  })),
}))

const currentServer = episodes[0]
const currentList = currentServer?.list ?? []

/** Khớp tập theo slug chính xác; nếu URL dùng số thứ tự (vd `/xem/naruto/1`)
 *  thì thử khớp theo số đầu trong slug tập (`tap-1`/`tap-001` → 1). */
function resolveEpIndex(list: { slug: string }[], epSlug: string): number {
  const exact = list.findIndex((e) => e.slug === epSlug)
  if (exact >= 0) return exact
  if (!/^\d+$/.test(epSlug)) return -1
  const want = Number(epSlug)
  const hits: number[] = []
  list.forEach((e, i) => {
    const m = e.slug.match(/(\d+)/)
    if (m && Number(m[1]) === want) hits.push(i)
  })
  return hits.length === 1 ? hits[0] : -1
}

const currentEpIdx = resolveEpIndex(currentList, episode)
const currentEp = currentList[currentEpIdx]

// URL không phải slug chuẩn (vd số thứ tự cũ) nhưng khớp được tập → chuyển hướng
// về slug chuẩn để SEO/nav/tiến trình đều nhất quán.
if (currentEp && currentEp.slug !== episode) {
  return Astro.redirect(`/xem/${slug}/${currentEp.slug}`, 301)
}

const currentEpM3u8 = currentEp
  ? m3u8Map[currentEp.slug] || (isRealHls(currentEp.m3u8) ? currentEp.m3u8 : '')
  : ''
const prevEp = currentEpIdx > 0 ? currentList[currentEpIdx - 1] : null
const nextEp = currentEpIdx < currentList.length - 1 ? currentList[currentEpIdx + 1] : null

const pageTitle = movie.name && currentEp ? `${movie.name} - ${currentEp.name}` : movie.name

let embedOrigin = ''
try {
  if (currentEp?.embed) embedOrigin = new URL(currentEp.embed).origin
} catch {}

const breadcrumb = [
  { name: 'Trang chủ', path: '/' },
  { name: movie.name, path: `/phim/${slug}` },
  { name: currentEp?.name ?? episode, path: `/xem/${slug}/${episode}` },
]

// Kinh dị — áp dụng cho mọi phim có tag Kinh Dị
const isHorror = (movie.category ?? []).some((c) => c.slug === 'kinh-di')

/* Ảnh poster cho overlay nút phát */
const posterSrc = movie.poster_url || movie.thumb_url || ''

/* Nav prev/next — button flat, chevron SVG (không glyph) */
const navBtn =
  'inline-flex h-10 items-center gap-1.5 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)] px-4'
const navDisabled = 'inline-flex h-10 items-center gap-1.5 rounded-[var(--radius-cm-btn)] text-cm-meta text-cm-text-3 opacity-40 px-4'

/* Server chips trong drawer */
const serverChip = 'ep-server px-3.5 py-1.5 rounded-[var(--radius-cm-btn)] text-xs font-medium border'
const serverIdle =
  'ep-server px-3.5 py-1.5 rounded-[var(--radius-cm-btn)] text-xs font-medium border border-cm-border bg-cm-surface text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong'
const serverActive = 'ep-server px-3.5 py-1.5 rounded-[var(--radius-cm-btn)] text-xs font-medium border sort-active'
---

<BaseLayout
  title={pageTitle}
  description={`Xem ${movie.name} ${currentEp ? `tập ${currentEp.name}` : ''} HD VietSub miễn phí tại Nô Lệ Làm Phim.`}
  ogImage={`${SITE_URL}/og/${slug}.png`}
  cache="public"
  island={{
    movieSlug: slug,
    movieName: movie.name,
    movieThumb: movie.thumb_url || '',
    movieYear: movie.year ? String(movie.year) : '',
    movieQuality: movie.quality || '',
    movieSource: 'vsmov',
    movieType: movie.type || '',
    movieGenres: Array.isArray(movie.category)
      ? movie.category.map((c) => (typeof c === 'string' ? c : c.name)).join('|')
      : '',
    episodeSlug: currentEp?.slug || episode,
    episodeName: currentEp?.name || '',
    episodeIndex: currentEpIdx >= 0 ? currentEpIdx + 1 : undefined,
    episodeTotal: currentList.length || undefined,
  }}
>
  <script is:inline set:html={breadcrumbLd(breadcrumb)} type="application/ld+json" />
  {embedOrigin && <link rel="preconnect" href={embedOrigin} slot="head" />}
  <ThemeBG name={slug} variant={isHorror ? 'horror' : undefined} />
  {
    !currentEp ? (
      <div class="px-4 md:px-8 py-20 flex flex-col items-center gap-4">
        <p class="text-cm-body text-cm-text-3">Không tìm thấy tập phim</p>
        <a href={`/phim/${slug}`} class="inline-flex h-10 items-center rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface px-5 text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong transition-colors">
          Quay lại
        </a>
      </div>
    ) : (
      <>
        {isHorror && <HorrorGate slug={slug} variant="gate" />}

        <div
          class="watch-page px-4 sm:px-6 md:px-8 pt-4 pb-24 lg:pb-12 space-y-6 max-w-[1600px] mx-auto w-full"
          data-slug={slug}
          data-episode={episode}
          data-movie-name={movie.name}
          data-movie-id={movie._id}
          data-movie-thumb={movie.thumb_url || ''}
          data-movie-vote={movie.tmdb?.vote_average || ''}
          data-ep-name={currentEp.name}
          data-servers={serverData.length > 0 ? JSON.stringify(serverData) : '[]'}
          data-time={movie.time || ''}
        >
          {/* ── Player ── */}
          <div class="relative rounded-[var(--radius-cm-card)] overflow-hidden bg-black border border-cm-border">
            <div
              id="player-stage"
              class="aspect-video w-full relative"
              data-embed={currentEp.embed}
              data-m3u8={currentEpM3u8}
              data-title={`${movie.name} - ${currentEp.name}`}
            >
              <button
                id="player-play"
                type="button"
                class="absolute inset-0 w-full h-full group"
                aria-label={`Phát ${movie.name} - ${currentEp.name}`}
              >
                {posterSrc && (
                  <img
                    src={imgUrl(posterSrc, 1600)}
                    srcset={imgSrcSet(posterSrc)}
                    sizes="100vw"
                    data-proxy={imgProxyUrl(posterSrc, 1600)}
                    alt=""
                    width="1600"
                    height="900"
                    class="absolute inset-0 w-full h-full object-cover"
                    fetchpriority="high"
                    decoding="async"
                  />
                )}
                <div class="absolute inset-0 bg-black/40 group-hover:bg-black/25 transition-colors duration-[var(--duration-cm)]"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-cm-surface/90 border border-white/15 flex items-center justify-center group-hover:scale-105 transition-transform duration-[var(--duration-cm)]">
                    <FaCirclePlay className="w-7 h-7 md:w-8 md:h-8 text-white ml-1" />
                  </div>
                </div>
                <span class="absolute bottom-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-black/60 border border-white/15 text-cm-meta font-medium text-white">
                  Bấm để phát
                </span>
              </button>

              {isHorror && <HorrorGate variant="loader" />}

              {nextEp && (
                <a
                  id="watch-next-float"
                  href={`/xem/${slug}/${nextEp.slug}`}
                  data-astro-prefetch="load"
                  class="absolute bottom-3 right-3 z-20 inline-flex items-center gap-1 px-3 py-1.5 rounded-[var(--radius-cm-btn)] bg-black/60 border border-white/15 text-white text-cm-meta font-medium hover:bg-black/75 transition-colors duration-[var(--duration-cm)]"
                >
                  Tập kế tiếp
                  <FaChevronRight className="w-3.5 h-3.5" />
                </a>
              )}
            </div>

            {/* Nút PiP — JS chỉ gỡ `.hidden` khi đang phát bằng <video>. */}
            <button
              id="watch-pip"
              type="button"
              class="watch-pip hidden"
              aria-label="Cửa sổ nhỏ (picture-in-picture)"
              title="Cửa sổ nhỏ (i)"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-[18px] h-[18px]"
                aria-hidden="true"
              >
                <rect x="3" y="4.5" width="18" height="15" rx="2.5"></rect>
                <rect x="12" y="11" width="7" height="6" rx="1.2" fill="currentColor" stroke="none"></rect>
              </svg>
            </button>

            {/* Server switch — dropdown nhỏ góc phải player */}
            {serverData.length > 1 && (
              <div class="watch-server-dd" data-multi>
                <button
                  id="watch-server-trigger"
                  type="button"
                  class="watch-server-trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <span id="watch-server-label">{serverData[0]?.name ?? 'Server'}</span>
                  <FaChevronDown className="w-3 h-3" />
                </button>
                <div
                  id="watch-server-menu"
                  class="watch-server-menu dropdown absolute right-0 top-11 z-40 w-52 rounded-[var(--radius-cm-modal)] border border-cm-border bg-cm-elevated p-1.5 flex flex-col gap-0.5 shadow-[var(--shadow-cm-up)]"
                  role="listbox"
                  aria-label="Chọn server"
                >
                  {
                    serverData.map((s, i) => (
                      <button
                        type="button"
                        role="option"
                        class:list={[
                          'watch-server-dd-item w-full text-left px-3 py-2 rounded-[var(--radius-cm-btn)] text-cm-meta text-cm-text-2 hover:bg-cm-surface hover:text-cm-text transition-colors',
                          i === 0 && 'sort-active',
                        ]}
                        data-server={i}
                      >
                        {s.name}
                      </button>
                    ))
                  }
                </div>
              </div>
            )}

            {/* Chọn chất lượng HLS — chỉ hiện khi luồng có ≥2 mức (gắn ở JS) */}
            <div id="watch-quality-dd" class="watch-quality-dd hidden">
              <button
                id="watch-quality-trigger"
                type="button"
                class="watch-server-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span id="watch-quality-label">Tự động</span>
                <FaChevronDown className="w-3 h-3" />
              </button>
              <div
                id="watch-quality-menu"
                class="dropdown absolute left-0 top-11 z-40 w-36 rounded-[var(--radius-cm-modal)] border border-cm-border bg-cm-elevated p-1.5 flex flex-col gap-0.5 shadow-[var(--shadow-cm-up)]"
                role="listbox"
                aria-label="Chọn chất lượng"
              ></div>
            </div>
          </div>

          {/* ── Title block ── */}
          <div class="min-w-0">
            <nav aria-label="Đường dẫn" class="flex items-center gap-1.5 text-cm-meta text-cm-text-3 flex-wrap">
              <a href="/" class="hover:text-cm-text transition-colors duration-[var(--duration-cm)]">Trang chủ</a>
              <span aria-hidden="true" class="text-cm-text-3/60">/</span>
              <a href={`/phim/${slug}`} class="hover:text-cm-text transition-colors duration-[var(--duration-cm)]">{movie.name}</a>
              <span aria-hidden="true" class="text-cm-text-3/60">/</span>
              <span class="text-cm-text">{currentEp.name}</span>
            </nav>
            <h1 class="mt-2 text-cm-h2 font-bold text-cm-text tracking-tight">{movie.name} - {currentEp.name}</h1>
            {serverData.length > 1 && <p class="mt-1 text-cm-meta text-cm-text-3">Server: {serverData[0]?.name}</p>}
          </div>

          {/* ── Nav prev / danh sách tập / next ── */}
          <div class="flex items-center gap-2.5 flex-wrap">
            {
              prevEp ? (
                <a id="watch-prev" href={`/xem/${slug}/${prevEp.slug}`} class={navBtn}>
                  <FaChevronLeft className="w-3.5 h-3.5" />
                  {prevEp.name}
                </a>
              ) : (
                <span id="watch-prev" class={navDisabled}>
                  <FaChevronLeft className="w-3.5 h-3.5" />
                  Hết
                </span>
              )
            }

            <button
              id="watch-drawer-open"
              type="button"
              class="inline-flex h-10 items-center gap-2 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface px-4 text-cm-meta font-medium text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]"
              aria-haspopup="dialog"
            >
              <FaListUl className="w-3.5 h-3.5 text-cm-text-3" />
              Danh sách tập
            </button>

            {
              nextEp ? (
                <a id="watch-next" href={`/xem/${slug}/${nextEp.slug}`} class={navBtn}>
                  {nextEp.name}
                  <FaChevronRight className="w-3.5 h-3.5" />
                </a>
              ) : (
                <span id="watch-next" class={navDisabled}>
                  Hết
                  <FaChevronRight className="w-3.5 h-3.5" />
                </span>
              )
            }

            <span class="flex-1"></span>
            <ReportButton slug={slug} name={movie.name} episode={currentEp.name} />
          </div>
        </div>

        {/* ── Drawer danh sách tập (rule 03) ── */}
        {currentList.length > 0 && (
          <>
            <div id="watch-drawer-veil" class="drawer-veil"></div>
            <div id="watch-drawer" class="watch-drawer" role="dialog" aria-modal="true" aria-label="Danh sách tập">
              <div class="flex items-center justify-between gap-3 px-4 h-14 border-b border-cm-border shrink-0">
                <h3 class="flex items-center gap-2 text-sm font-bold text-cm-text">
                  Danh sách tập
                  <span id="watch-drawer-count" class="text-cm-meta text-cm-text-3 font-normal">({currentList.length} tập)</span>
                </h3>
                <button
                  id="watch-drawer-close"
                  type="button"
                  class="w-9 h-9 inline-flex items-center justify-center rounded-[var(--radius-cm-btn)] text-cm-text-3 hover:text-cm-text hover:bg-cm-surface transition-colors duration-[var(--duration-cm)]"
                  aria-label="Đóng"
                >
                  <FaXmark className="w-5 h-5" />
                </button>
              </div>

              {
                serverData.length > 1 && (
                  <div class="flex items-center gap-2 flex-wrap px-4 pt-3.5 pb-1 border-b border-cm-border shrink-0">
                    {
                      serverData.map((s, i) => (
                        <button
                          type="button"
                          class={`${serverChip} ${i === 0 ? serverActive : serverIdle}`}
                          data-server={i}
                        >
                          {s.name}
                        </button>
                      ))
                    }
                  </div>
                )
              }

              <div class="flex-1 min-h-0 overflow-y-auto">
                <div id="watch-drawer-grid" class="flex flex-wrap gap-2 px-4 py-4">
                  {
                    currentList.map((e) => {
                      const isCurrent = e.slug === episode
                      const cls = `ep-btn w-12 h-12 sm:w-14 sm:h-14 rounded-[var(--radius-cm-btn)] text-cm-meta flex items-center justify-center font-medium${isCurrent ? ' current' : ''}`
                      return isCurrent ? (
                        <span class={cls} aria-current="true" data-ep-slug={e.slug}>{e.name}</span>
                      ) : (
                        <a href={`/xem/${slug}/${e.slug}`} class={cls} data-ep-slug={e.slug}>{e.name}</a>
                      )
                    })
                  }
                </div>
              </div>

              <div class="px-4 py-3 border-t border-cm-border shrink-0">
                <a
                  href={`/phim/${slug}`}
                  class="w-full h-10 inline-flex items-center justify-center rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]"
                >
                  Trang phim
                </a>
              </div>
            </div>
          </>
        )}
      </>
    )
  }

  <script>
    import { addRecent, updateRecentProgress, getRecent, setEpProgress } from '../../../scripts/store'
    import { decorateEpProgress as decorateEpProgressFor } from '../../../scripts/ep-progress'
    import { escapeHTML } from '../../../scripts/cards'
    import { registerPageInit } from '../../../scripts/lifecycle'
    import { imgProxyUrl } from '../../../lib/img'

    registerPageInit(() => {
      const page = document.querySelector<HTMLElement>('.watch-page')
      if (!page) return () => {}

      const slug = page.dataset.slug || ''
      const episode = page.dataset.episode || ''
      const movieName = page.dataset.movieName || ''
      const movieId = Number(page.dataset.movieId)
      const movieThumb = page.dataset.movieThumb || ''
      const movieVote = page.dataset.movieVote || ''
      const epName = page.dataset.epName || ''

      /* ── 5.3: đếm người đang xem (THẬT, không bịa) ──
       * Ping 1 lần khi vào, rồi poll mỗi 60s. Đẩy số vào pill qua
       * window.__nllpIsland.refresh() với `watchers` mới. */
      const presenceAc = new AbortController()
      async function pingPresence(first: boolean) {
        try {
          const res = await fetch(`/api/presence?slug=${encodeURIComponent(slug)}${first ? '&ping=1' : ''}`, {
            signal: presenceAc.signal,
          })
          const data = (await res.json()) as { enabled?: boolean; count?: number }
          if (!data.enabled) return
          const api = window.__nllpIsland as
            | { getMode?: () => string; setMode?: (m: string, d?: Record<string, unknown>) => void }
            | undefined
          if (!api?.getMode || api.getMode() !== 'watch') return
          // Cập nhật lại chế độ watch với số người mới.
          const html = document.documentElement
          api.setMode?.('watch', {
            slug,
            name: movieName,
            thumb: html.dataset.movieThumb || '',
            episodeSlug: html.dataset.episodeSlug || episode,
            episodeName: html.dataset.episodeName || epName,
            epIndex: Number(html.dataset.episodeIndex || 0) || undefined,
            epTotal: Number(html.dataset.episodeTotal || 0) || undefined,
            genres: (html.dataset.movieGenres || '').split('|').filter(Boolean),
            type: html.dataset.movieType || '',
            source: html.dataset.movieSource || 'vsmov',
            watchers: data.count || 0,
          })
        } catch {
          /* bỏ qua lỗi mạng/abort */
        }
      }
      void pingPresence(true)
      window.setInterval(() => void pingPresence(false), 60_000)
      window.addEventListener('pagehide', () => presenceAc.abort(), { once: true })

      let servers: { name: string; items: { name: string; slug: string; embed: string; m3u8?: string }[] }[] = []
      try {
        servers = JSON.parse(page.dataset.servers || '[]')
      } catch {
        servers = []
      }

      /* ── Tiến trình xem "thật" (time-spent, vì iframe embed bên thứ 3 không cho
       *    đọc thời gian phát — không thể seek/lắng nghe ended) ── */
      function parseDurationSeconds(time?: string): number {
        if (!time) return 42 * 60
        let total = 0
        const h = time.match(/(\d+(?:[.,]\d+)?)\s*(?:giờ|g|h)/i)
        const m = time.match(/(\d+(?:[.,]\d+)?)\s*(?:phút|p|m|')/i)
        if (h) total += Number(h[1]) * 3600
        if (m) total += Number(m[1]) * 60
        if (total > 0) return Math.round(total)
        const num = time.match(/(\d+)/)
        return num ? Math.max(30, Number(num[1])) * 60 : 42 * 60
      }
      let duration = parseDurationSeconds(page.dataset.time)

      let elapsed = 0
      let progressActive = false
      let progressTick = 0
      let lastTick = 0

      /* ── Vẽ thanh tiến trình cho từng nút tập (mục 1.4) — xem scripts/ep-progress.ts ── */
      function decorateEpProgress() {
        decorateEpProgressFor(slug)
      }

      function flushProgress() {
        if (elapsed <= 0) return
        const position = Math.min(elapsed, duration * 0.92)
        updateRecentProgress(slug, position, duration)
        // Tiến trình theo TỪNG TẬP (để vẽ vòng ở danh sách tập).
        setEpProgress(slug, episode, position, duration)
        // Đồng bộ tiến trình lên tài khoản (nếu đã đăng nhập) — throttled bên gọi.
        fetch('/api/auth/me', { credentials: 'same-origin' })
          .then((r) => r.json())
          .then((d) => {
            if (!d?.user) return
            return fetch('/api/user/history', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({
                slug,
                name: movieName,
                thumb: movieThumb,
                episode: epName,
                episodeSlug: episode,
                position,
                duration,
              }),
            })
          })
          .catch(() => {})
      }

      function startProgress() {
        if (progressActive) return
        progressActive = true
        const tick = () => {
          if (document.hidden) return
          if (currentMode === 'video' && videoEl) {
            if (Number.isFinite(videoEl.currentTime)) elapsed = videoEl.currentTime
            if (Number.isFinite(videoEl.duration) && videoEl.duration > 0) duration = videoEl.duration
          } else {
            elapsed += 1
          }
          progressTick += 1
          const pos = Math.min(elapsed, duration * 0.92)
          updateRecentProgress(slug, pos, duration)
          if (progressTick % 3 === 0) flushProgress()
        }
        window.setInterval(tick, 10000)
        if (videoEl) {
          const v = videoEl
          const seekToResume = () => {
            try {
              const hist = getRecent()
              const item = hist.find((r) => r.slug === slug && r.episodeSlug === episode)
              if (item && typeof item.position === 'number' && item.position > 20) {
                if (Math.abs(v.currentTime - item.position) > 30) {
                  v.currentTime = Math.min(item.position, v.duration || item.duration || item.position)
                }
              }
            } catch {}
          }
          v.addEventListener('timeupdate', () => {
            if (Number.isFinite(v.currentTime)) elapsed = v.currentTime
            if (Number.isFinite(v.duration) && v.duration > 0) duration = v.duration
            // 5.4: nhịp phát thật (throttle ~400ms) → pill "cắn" theo nhịp.
            if (!v.paused) {
              const now = performance.now()
              if (now - lastTick > 400) {
                lastTick = now
                window.dispatchEvent(new CustomEvent('nllp:player-tick'))
              }
            }
          }, { passive: true })
          v.addEventListener('pause', flushProgress, { passive: true })
          v.addEventListener('ended', () => {
            flushProgress()
            showAutoNext()
          }, { passive: true })
          // Người dùng tua/phát lại → huỷ đếm ngược tự chuyển tập.
          v.addEventListener('seeking', clearAutoNext, { passive: true })
          v.addEventListener('play', () => {
            if (v.currentTime < (v.duration || 0) - 1) clearAutoNext()
          }, { passive: true })
          v.addEventListener('loadeddata', seekToResume, { once: true })
          v.addEventListener('playing', seekToResume, { once: true })
        }
      }

      const onVisibility = () => {
        if (document.hidden) flushProgress()
      }
      document.addEventListener('visibilitychange', onVisibility)
      window.addEventListener('pagehide', flushProgress, { once: true })

      /* ── Lịch sử xem (episode-level, vẫn giữ) ── */
      addRecent({
        id: movieId,
        slug,
        name: movieName,
        thumb: movieThumb,
        episode: epName,
        episodeSlug: episode,
        tmdb_vote: movieVote || undefined,
        position: 0,
        duration,
      })
      fetch('/api/auth/me', { credentials: 'same-origin' })
        .then((r) => r.json())
        .then((d) => {
          if (!d?.user) return
          return fetch('/api/user/history', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              slug,
              name: movieName,
              thumb: movieThumb,
              episode: epName,
              episodeSlug: episode,
            }),
          })
        })
        .catch(() => {})

      /* ── Player ── */
      const stage = document.getElementById('player-stage')
      const playBtn = document.getElementById('player-play')
      const loaderEl = document.getElementById('player-loader')
      let frame: HTMLIFrameElement | null = null
      let pendingEmbed = stage?.dataset.embed || ''
      let pendingM3u8 = stage?.dataset.m3u8 || ''
      let pendingTitle = stage?.dataset.title || ''
      let loaderMinTimer = 0
      let frameLoaded = false

      /* Trạng thái player m3u8 (hls.js) */
      type HlsLevel = { height?: number; name?: string }
      type HlsEventData = { fatal?: boolean; levels?: HlsLevel[]; level?: number }
      type HlsInstance = {
        destroy(): void
        on(event: string, cb: (event: unknown, data: HlsEventData) => void): void
        loadSource(url: string): void
        attachMedia(el: HTMLMediaElement): void
        currentLevel: number
      }
      let videoEl: HTMLVideoElement | null = null
      let hls: HlsInstance | null = null
      let currentMode: 'none' | 'iframe' | 'video' = 'none'
      let hlsLevels: HlsLevel[] = []
      let currentLevel = -1 // -1 = Auto

      /* ── Ghi nhớ tuỳ chọn player: tốc độ / âm lượng / tắt tiếng / mức chất lượng ──
       * Lưu ở localStorage (không đụng schema, dùng được cả khi chưa đăng nhập). */
      interface PlayerPrefs {
        rate?: number
        volume?: number
        muted?: boolean
        level?: number
      }
      const PREFS_KEY = 'nllp:player'
      function loadPrefs(): PlayerPrefs {
        try {
          const raw = localStorage.getItem(PREFS_KEY)
          return raw ? (JSON.parse(raw) as PlayerPrefs) : {}
        } catch {
          return {}
        }
      }
      function savePrefs(patch: PlayerPrefs) {
        try {
          localStorage.setItem(PREFS_KEY, JSON.stringify({ ...loadPrefs(), ...patch }))
        } catch {
          /* ignore */
        }
      }
      /* Áp tuỳ chọn âm lượng/tốc độ cho <video> vừa tạo. */
      function applyPrefsToVideo(v: HTMLVideoElement) {
        const p = loadPrefs()
        if (typeof p.volume === 'number' && p.volume >= 0 && p.volume <= 1) v.volume = p.volume
        if (typeof p.muted === 'boolean') v.muted = p.muted
        if (typeof p.rate === 'number' && p.rate > 0) {
          try {
            v.playbackRate = p.rate
          } catch {
            /* ignore */
          }
        }
      }

      /* ── Chọn chất lượng (mức HLS của hls.js) ── */
      const qdd = document.getElementById('watch-quality-dd')
      const qTrigger = document.getElementById('watch-quality-trigger')
      const qMenu = document.getElementById('watch-quality-menu')
      const qLabel = document.getElementById('watch-quality-label')

      function qualityLabel(l: HlsLevel, i: number): string {
        return l.height ? `${l.height}p` : l.name || `Mức ${i + 1}`
      }
      function closeQualityMenu() {
        qMenu?.classList.remove('open')
        qTrigger?.setAttribute('aria-expanded', 'false')
      }
      function hideQuality() {
        closeQualityMenu()
        qdd?.classList.add('hidden')
      }
      function markQuality(active: number) {
        qMenu?.querySelectorAll<HTMLButtonElement>('button[data-level]').forEach((b) => {
          b.classList.toggle('sort-active', Number(b.dataset.level) === active)
        })
      }
      function selectLevel(level: number) {
        if (!hls) return
        hls.currentLevel = level
        currentLevel = level
        savePrefs({ level })
        if (qLabel) qLabel.textContent = level === -1 ? 'Tự động' : qualityLabel(hlsLevels[level], level)
        markQuality(level)
        closeQualityMenu()
      }
      /* Dựng menu từ danh sách mức vừa parse; ẩn nếu luồng chỉ có 1 mức. */
      function renderQuality() {
        if (!qdd || !qMenu) return
        if (hlsLevels.length < 2) {
          hideQuality()
          return
        }
        const itemCls =
          'watch-quality-item w-full text-left px-3 py-2 rounded-[var(--radius-cm-btn)] text-cm-meta text-cm-text-2 hover:bg-cm-surface hover:text-cm-text transition-colors'
        const rows = [`<button type="button" class="${itemCls}" data-level="-1" role="option">Tự động</button>`]
        hlsLevels.forEach((l, i) => {
          rows.push(`<button type="button" class="${itemCls}" data-level="${i}" role="option">${escapeHTML(qualityLabel(l, i))}</button>`)
        })
        qMenu.innerHTML = rows.join('')
        qMenu.querySelectorAll<HTMLButtonElement>('button[data-level]').forEach((b) => {
          b.addEventListener('click', () => selectLevel(Number(b.dataset.level)))
        })
        // Khôi phục mức chất lượng người dùng đã chọn trước đó (nếu còn hợp lệ).
        const saved = loadPrefs().level
        const restored = typeof saved === 'number' && saved >= -1 && saved < hlsLevels.length ? saved : -1
        currentLevel = restored
        if (restored >= 0 && hls) hls.currentLevel = restored
        if (qLabel) qLabel.textContent = restored === -1 ? 'Tự động' : qualityLabel(hlsLevels[restored], restored)
        markQuality(restored)
        qdd.classList.remove('hidden')
      }

      function maybeHideLoader() {
        if (!loaderEl) return
        if (frameLoaded && loaderMinTimer <= 0) hideLoader()
      }
      function showLoader() {
        if (!loaderEl) return
        loaderEl.classList.add('reel-active')
        loaderEl.classList.remove('hidden')
        frameLoaded = false
        window.clearTimeout(loaderMinTimer)
        loaderMinTimer = window.setTimeout(() => {
          loaderMinTimer = 0
          maybeHideLoader()
        }, 1500)
      }
      function hideLoader() {
        if (!loaderEl) return
        loaderEl.classList.add('hidden')
        loaderEl.classList.remove('reel-active')
      }

      function createFrame(embed: string, title: string) {
        if (!stage) return
        clearStage()
        playBtn?.classList.add('hidden')
        frame = document.createElement('iframe')
        frame.id = 'watch-frame'
        frame.className = 'w-full h-full'
        frame.setAttribute('allowfullscreen', '')
        frame.setAttribute('allow', 'autoplay; fullscreen')
        frame.title = title
        frame.src = embed
        frame.addEventListener('load', () => {
          frameLoaded = true
          maybeHideLoader()
        })
        stage.innerHTML = ''
        stage.appendChild(frame)
        currentMode = 'iframe'
        showLoader()
        startProgress()
      }

      /* Dọn player hiện tại (hls / video / iframe) trước khi phát cái mới */
      function clearStage() {
        if (hls) {
          try {
            hls.destroy()
          } catch {
            /* ignore */
          }
          hls = null
        }
        if (videoEl) {
          try {
            videoEl.pause()
            videoEl.removeAttribute('src')
            videoEl.load()
          } catch {
            /* ignore */
          }
          videoEl = null
        }
        if (frame) {
          frame.remove()
          frame = null
        }
        currentMode = 'none'
        hidePipButton()
        clearAutoNext()
        // Đổi nguồn/tập → bỏ trạng thái chất lượng cũ (sẽ dựng lại khi parse manifest mới).
        hideQuality()
        hlsLevels = []
        currentLevel = -1
      }

      function createVideo(title: string): HTMLVideoElement | null {
        if (!stage) return null
        clearStage()
        playBtn?.classList.add('hidden')
        const v = document.createElement('video')
        v.id = 'watch-video'
        v.className = 'w-full h-full bg-black'
        v.controls = true
        v.playsInline = true
        v.autoplay = true
        v.preload = 'auto'
        v.title = title
        stage.innerHTML = ''
        stage.appendChild(v)
        videoEl = v
        currentMode = 'video'
        applyPrefsToVideo(v)
        // Ghi nhớ thay đổi âm lượng / tắt tiếng / tốc độ.
        const persist = () =>
          savePrefs({ volume: v.volume, muted: v.muted, rate: v.playbackRate })
        v.addEventListener('volumechange', persist, { passive: true })
        v.addEventListener('ratechange', persist, { passive: true })
        wireMediaSession(v, title)
        showPipButton()
        return v
      }

      /* Phát HLS thật (kkphim link_m3u8) bằng <video> + hls.js.
       * Lỗi fatal hoặc không hỗ trợ → tự rơi về embed iframe. */
      async function playHls(m3u8: string, title: string, fallbackEmbed: string) {
        const v = createVideo(title)
        if (!v) return
        startProgress()
        // Ưu tiên hls.js (MSE — Chrome/Firefox/Edge). Lưu ý: Chrome trả về
        // "maybe" cho canPlayType('application/vnd.apple.mpegurl') nên KHÔNG
        // được dùng nó làm điều kiện chọn nhánh native trước.
        try {
          const mod = await import('hls.js')
          const Hls = mod.default
          if (Hls.isSupported()) {
            const instance = new Hls({ enableWorker: true }) as unknown as HlsInstance
            hls = instance
            instance.on(Hls.Events.ERROR, (_evt, data) => {
              if (data?.fatal) {
                console.warn('[player] hls fatal error — chuyển sang embed')
                createFrame(fallbackEmbed, title)
              }
            })
            instance.on(Hls.Events.MANIFEST_PARSED, (_evt, data) => {
              hlsLevels = Array.isArray(data?.levels) ? data.levels : []
              renderQuality()
            })
            instance.on(Hls.Events.LEVEL_SWITCHED, (_evt, data) => {
              // Chế độ Tự động: hiện mức đang phát thực tế cho người dùng biết.
              if (currentLevel === -1 && qLabel) {
                const l = hlsLevels[data?.level ?? -1]
                qLabel.textContent = l ? `Tự động (${qualityLabel(l, data?.level ?? 0)})` : 'Tự động'
              }
            })
            instance.loadSource(m3u8)
            instance.attachMedia(v)
            v.play().catch(() => {})
            return
          }
        } catch (err) {
          console.warn('[player] hls.js load failed — thử native HLS', err)
        }
        // Safari / iOS: HLS gốc.
        if (v.canPlayType('application/vnd.apple.mpegurl')) {
          v.addEventListener('error', () => {
            if (videoEl === v) createFrame(fallbackEmbed, title)
          })
          v.src = m3u8
          v.play().catch(() => {})
          return
        }
        createFrame(fallbackEmbed, title)
      }

      function startPlayback(item: { embed: string; m3u8?: string }, title: string) {
        if (item.m3u8) playHls(item.m3u8, title, item.embed)
        else createFrame(item.embed, title)
      }

      playBtn?.addEventListener('click', () => {
        startPlayback({ embed: pendingEmbed, m3u8: pendingM3u8 || undefined }, pendingTitle)
      })

      if (loaderEl && pendingEmbed) {
        startPlayback({ embed: pendingEmbed, m3u8: pendingM3u8 || undefined }, pendingTitle)
      }

      /* ── Nav prev/next + float ── */
      const navBtn =
        'inline-flex h-10 items-center gap-1.5 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)] px-4'
      const navDisabled =
        'inline-flex h-10 items-center gap-1.5 rounded-[var(--radius-cm-btn)] text-cm-meta text-cm-text-3 opacity-40 px-4'
      const chevL = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.4 7.4L14 6l-6 6 6 6 1.4-1.4L10.8 12l4.6-4.6z"/></svg>'
      const chevR = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 6L8.6 7.4 13.2 12l-4.6 4.6L10 18l6-6-6-6z"/></svg>'

      function epLink(id: string, href: string, text: string, dir: 'prev' | 'next') {
        const icon = dir === 'prev' ? chevL : chevR
        const body = dir === 'prev' ? `${icon}${escapeHTML(text)}` : `${escapeHTML(text)}${icon}`
        return `<a id="${id}" href="${href}" class="${navBtn}">${body}</a>`
      }
      function epEmpty(id: string, text: string, dir: 'prev' | 'next') {
        const icon = dir === 'prev' ? chevL : chevR
        const body = dir === 'prev' ? `${icon}${escapeHTML(text)}` : `${escapeHTML(text)}${icon}`
        return `<span id="${id}" class="${navDisabled}">${body}</span>`
      }

      function renderNav(items: { name: string; slug: string }[], idx: number) {
        const prev = document.getElementById('watch-prev')
        const next = document.getElementById('watch-next')
        const p = idx > 0 ? items[idx - 1] : null
        const n = idx >= 0 && idx < items.length - 1 ? items[idx + 1] : null
        if (prev) prev.outerHTML = p ? epLink('watch-prev', `/xem/${slug}/${p.slug}`, p.name, 'prev') : epEmpty('watch-prev', 'Hết', 'prev')
        if (next) next.outerHTML = n ? epLink('watch-next', `/xem/${slug}/${n.slug}`, n.name, 'next') : epEmpty('watch-next', 'Hết', 'next')
        const float = document.getElementById('watch-next-float') as HTMLAnchorElement | null
        if (float) {
          if (n) {
            float.href = `/xem/${slug}/${n.slug}`
            float.classList.remove('hidden')
          } else {
            float.classList.add('hidden')
          }
        }
      }

      /* ── Drawer ── */
      const drawer = document.getElementById('watch-drawer')
      const veil = document.getElementById('watch-drawer-veil')
      const drawerOpenBtn = document.getElementById('watch-drawer-open')
      const drawerCloseBtn = document.getElementById('watch-drawer-close')
      const drawerGrid = document.getElementById('watch-drawer-grid')
      const drawerCount = document.getElementById('watch-drawer-count')

      // Lưới tập ban đầu do server render → trang trí tiến trình ngay khi vào trang.
      decorateEpProgress()

      function openDrawer() {
        decorateEpProgress() // vẽ lại thanh tiến trình (localStorage có thể vừa đổi)
        drawer?.classList.add('open')
        veil?.classList.add('open')
        document.body.classList.add('overflow-hidden')
      }
      function closeDrawer() {
        drawer?.classList.remove('open')
        veil?.classList.remove('open')
        document.body.classList.remove('overflow-hidden')
      }
      drawerOpenBtn?.addEventListener('click', openDrawer)
      drawerCloseBtn?.addEventListener('click', closeDrawer)
      veil?.addEventListener('click', closeDrawer)

      const serverChips = Array.from(drawer?.querySelectorAll<HTMLButtonElement>('.ep-server') ?? [])
      const ddItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.watch-server-dd-item'))
      const ddMenu = document.getElementById('watch-server-menu')
      const ddTrigger = document.getElementById('watch-server-trigger')
      const ddLabel = document.getElementById('watch-server-label')

      function renderDrawer(server: { name: string; items: { name: string; slug: string }[] }, activeIdx: number) {
        if (!drawerGrid) return
        const items = server.items
        drawerGrid.innerHTML = items
          .map((e, i) => {
            const isCurrent = i === activeIdx
            const cls = `ep-btn w-12 h-12 sm:w-14 sm:h-14 rounded-[var(--radius-cm-btn)] text-cm-meta flex items-center justify-center font-medium${isCurrent ? ' current' : ''}`
            return isCurrent
              ? `<span class="${cls}" aria-current="true" data-ep-slug="${escapeHTML(e.slug)}">${escapeHTML(e.name)}</span>`
              : `<a href="/xem/${slug}/${escapeHTML(e.slug)}" class="${cls}" data-ep-slug="${escapeHTML(e.slug)}">${escapeHTML(e.name)}</a>`
          })
          .join('')
        if (drawerCount) drawerCount.textContent = `(${items.length} tập)`
        decorateEpProgress()
      }

      function selectServer(i: number) {
        const server = servers[i]
        if (!server) return
        let idx = server.items.findIndex((e) => e.slug === episode)
        if (idx < 0) idx = 0
        const ep = server.items[idx]

        const chipActive = 'ep-server px-3.5 py-1.5 rounded-[var(--radius-cm-btn)] text-xs font-medium border sort-active'
        const chipIdle =
          'ep-server px-3.5 py-1.5 rounded-[var(--radius-cm-btn)] text-xs font-medium border border-cm-border bg-cm-surface text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong'
        serverChips.forEach((b) => {
          b.className = Number(b.dataset.server) === i ? chipActive : chipIdle
        })
        ddItems.forEach((b) => {
          b.classList.toggle('sort-active', Number(b.dataset.server) === i)
        })
        if (ddLabel) ddLabel.textContent = server.name
        ddMenu?.classList.remove('open')
        if (ddTrigger) ddTrigger.setAttribute('aria-expanded', 'false')

        if (ep) {
          pendingEmbed = ep.embed
          pendingM3u8 = ep.m3u8 || ''
          pendingTitle = `${movieName} - ${ep.name}`
          // Đang phát → đổi ngay; chưa phát → chỉ đổi nguồn chờ (người dùng bấm play).
          if (frame || videoEl) {
            startPlayback({ embed: ep.embed, m3u8: ep.m3u8 }, pendingTitle)
          }
        }
        renderNav(server.items, idx)
        renderDrawer(server, idx)
      }

      serverChips.forEach((btn) => btn.addEventListener('click', () => selectServer(Number(btn.dataset.server))))
      ddItems.forEach((btn) => btn.addEventListener('click', () => selectServer(Number(btn.dataset.server))))

      /* ── 4.3: đổi nguồn phát từ viên thuốc ──
       * Pill phát `nllp:switch-source` với id nguồn (vsmov/kkphim/nguonc).
       * Ánh xạ id → chỉ số server theo TÊN server (nguồn V3 xuất hiện dưới
       * các tên khác nhau tuỳ phim), rồi tái dùng selectServer(). */
      const SOURCE_ALIAS: Record<string, string[]> = {
        vsmov: ['vsmov', 'vietsub', 'vsmov #1', 'vsmov #2'],
        kkphim: ['kkphim', 'kk', 'phimapi'],
        nguonc: ['nguonc', 'nguồn c', 'nc'],
      }
      function selectSourceById(id: string) {
        const aliases = SOURCE_ALIAS[id] || [id]
        const idx = servers.findIndex((s) =>
          aliases.some((a) => s.name.toLowerCase().includes(a.toLowerCase())),
        )
        if (idx >= 0) {
          selectServer(idx)
          return true
        }
        // Không khớp tên → nếu nguồn có m3u8 riêng thì phát trực tiếp.
        const target = servers.find((s) =>
          aliases.some((a) => s.name.toLowerCase().includes(a.toLowerCase())),
        )
        if (!target && servers[0]) {
          // Fallback: nếu chỉ có 1 server, coi như đổi nguồn không khả dụng.
          return false
        }
        return false
      }
      window.addEventListener('nllp:switch-source', (ev) => {
        const src = (ev as CustomEvent).detail?.source as string
        const ok = selectSourceById(src)
        // Báo lại cho pill biết kết quả (đổi nhãn nguồn / hiện cảnh báo).
        window.dispatchEvent(new CustomEvent('nllp:switch-source-done', { detail: { source: src, ok } }))
      })

      /* ── Pill "Phát tiếp" (chế độ watch) ──
       * Đang ở đúng tập nên KHÔNG điều hướng: cuộn tới player rồi phát nếu
       * overlay "Bấm để phát" còn hiện (chưa phát). Nếu đã phát → chỉ cuộn tới. */
      window.addEventListener('nllp:island-resume', () => {
        const stage = document.getElementById('player-stage')
        stage?.scrollIntoView({ behavior: 'smooth', block: 'center' })
        const pb = document.getElementById('player-play')
        if (pb && !pb.classList.contains('hidden')) pb.click()
      })

      ddTrigger?.addEventListener('click', () => {
        if (!ddMenu) return
        const isOpen = ddMenu.classList.toggle('open')
        ddTrigger.setAttribute('aria-expanded', String(isOpen))
      })
      qTrigger?.addEventListener('click', () => {
        if (!qMenu) return
        const isOpen = qMenu.classList.toggle('open')
        qTrigger.setAttribute('aria-expanded', String(isOpen))
      })
      document.addEventListener('click', (e) => {
        const target = e.target as Node
        if (ddMenu && !ddMenu.contains(target) && ddTrigger && !ddTrigger.contains(target)) {
          ddMenu.classList.remove('open')
          ddTrigger.setAttribute('aria-expanded', 'false')
        }
        if (qMenu && !qMenu.contains(target) && qTrigger && !qTrigger.contains(target)) {
          closeQualityMenu()
        }
      })

      /* ── Picture-in-Picture ── */
      const pipBtn = document.getElementById('watch-pip')
      function pipSupported(): boolean {
        return typeof document !== 'undefined' && 'pictureInPictureEnabled' in document
          ? (document as Document & { pictureInPictureEnabled?: boolean }).pictureInPictureEnabled === true
          : false
      }
      function showPipButton() {
        if (!pipBtn) return
        if (pipSupported()) pipBtn.classList.remove('hidden')
        else pipBtn.classList.add('hidden')
      }
      function hidePipButton() {
        pipBtn?.classList.add('hidden')
      }
      function togglePip() {
        if (!videoEl) return
        const doc = document as Document & {
          pictureInPictureElement?: Element | null
          exitPictureInPicture?: () => Promise<void>
        }
        const v = videoEl as HTMLVideoElement & { requestPictureInPicture?: () => Promise<unknown> }
        try {
          if (doc.pictureInPictureElement) doc.exitPictureInPicture?.().catch(() => {})
          else v.requestPictureInPicture?.().catch(() => {})
        } catch {
          /* ignore */
        }
      }
      pipBtn?.addEventListener('click', togglePip)

      /* ── Media Session: điều khiển từ khoá/màn hình khoá (chỉ <video>) ── */
      function wireMediaSession(v: HTMLVideoElement, title: string) {
        const ms = (navigator as Navigator & { mediaSession?: MediaSession }).mediaSession
        if (!ms) return
        try {
          const artwork = movieThumb
            ? [
                { src: imgProxyUrl(movieThumb, 320), sizes: '320x480', type: 'image/webp' },
              ]
            : []
          ms.metadata = new MediaMetadata({
            title: title || movieName,
            artist: movieName,
            album: 'Nô Lệ Làm Phim',
            artwork,
          })
          const seekBy = (delta: number) => {
            try {
              v.currentTime = Math.max(0, Math.min((v.duration || 1e9), v.currentTime + delta))
            } catch {
              /* ignore */
            }
          }
          ms.setActionHandler('play', () => v.play().catch(() => {}))
          ms.setActionHandler('pause', () => v.pause())
          ms.setActionHandler('seekbackward', () => seekBy(-10))
          ms.setActionHandler('seekforward', () => seekBy(10))
          ms.setActionHandler('nexttrack', () => clickNavLink('watch-next'))
          ms.setActionHandler('previoustrack', () => clickNavLink('watch-prev'))
        } catch {
          /* ignore — một số trình duyệt thiếu action */
        }
      }

      /* ── Tự chuyển tập: sau khi tập hiện tại kết thúc (chỉ <video>), hiện thẻ
       *    đếm ngược và tự đi tiếp; người dùng có thể "Xem ngay" hoặc "Huỷ". ── */
      const AUTONEXT_SECONDS = 10
      let autoNextTimer = 0
      let autoNextEl: HTMLElement | null = null
      function clearAutoNext() {
        if (autoNextTimer) {
          window.clearInterval(autoNextTimer)
          autoNextTimer = 0
        }
        if (autoNextEl) {
          autoNextEl.remove()
          autoNextEl = null
        }
      }
      function showAutoNext() {
        clearAutoNext()
        const next = document.getElementById('watch-next')
        if (!next || next.tagName !== 'A') return
        const wrap = document.createElement('div')
        wrap.className = 'watch-autonext'
        wrap.setAttribute('role', 'status')
        wrap.innerHTML =
          `<span class="watch-autonext-text">Tập tiếp theo sau <span class="watch-autonext-count" data-count>${AUTONEXT_SECONDS}</span>s</span>` +
          `<a class="watch-autonext-go" href="${(next as HTMLAnchorElement).getAttribute('href') || '#'}">Xem ngay</a>` +
          `<button type="button" class="watch-autonext-cancel" data-cancel>Huỷ</button>`
        const playerBox = stage?.parentElement
        ;(playerBox || stage)?.appendChild(wrap)
        autoNextEl = wrap
        wrap.querySelector('[data-cancel]')?.addEventListener('click', () => {
          clearAutoNext()
        })
        const countEl = wrap.querySelector('[data-count]')
        let left = AUTONEXT_SECONDS
        autoNextTimer = window.setInterval(() => {
          left -= 1
          if (countEl) countEl.textContent = String(Math.max(0, left))
          if (left <= 0) {
            clearAutoNext()
            const go = document.getElementById('watch-next')
            if (go && go.tagName === 'A') (go as HTMLAnchorElement).click()
          }
        }, 1000)
      }
      /* ── Điều hướng tập (dùng chung cho Media Session + bàn phím) ── */
      function clickNavLink(id: 'watch-next' | 'watch-prev') {
        const el = document.getElementById(id)
        if (el && el.tagName === 'A') (el as HTMLAnchorElement).click()
      }

      /* ── Keyboard ── */
      function isTyping(): boolean {
        const el = document.activeElement
        if (!el) return false
        const tag = el.tagName
        return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (el as HTMLElement).isContentEditable
      }

      function onKey(e: KeyboardEvent) {
        if (isTyping()) return
        const k = e.key

        if (k === 'Escape') {
          if (drawer?.classList.contains('open')) closeDrawer()
          closeQualityMenu()
          clearAutoNext()
          return
        }

        // Chỉ khi thực sự đang phát bằng <video> mới can thiệp phím của video.
        const videoMode = currentMode === 'video' && videoEl !== null
        const shift = e.shiftKey

        // Chuyển tập: Shift+←/→ ở mọi chế độ; ←/→ khi KHÔNG có <video>
        // (iframe bên thứ ba không cho đọc/ tua thời gian nên giữ nguyên hành vi cũ).
        if (k === 'ArrowLeft' && (shift || !videoMode)) {
          const prev = document.getElementById('watch-prev')
          if (prev && prev.tagName === 'A') {
            e.preventDefault()
            ;(prev as HTMLAnchorElement).click()
          }
          return
        }
        if (k === 'ArrowRight' && (shift || !videoMode)) {
          const next = document.getElementById('watch-next')
          if (next && next.tagName === 'A') {
            e.preventDefault()
            ;(next as HTMLAnchorElement).click()
          }
          return
        }

        if (!videoMode || !videoEl) {
          // Không có video: chỉ còn phím fullscreen cho iframe.
          if (k === 'f' || k === 'F') {
            const f = document.getElementById('watch-frame') as HTMLIFrameElement | null
            if (f && typeof f.requestFullscreen === 'function') {
              e.preventDefault()
              f.requestFullscreen().catch(() => {})
            }
          }
          return
        }

        const v = videoEl
        const seekBy = (delta: number) => {
          const dur = Number.isFinite(v.duration) && v.duration > 0 ? v.duration : Number.MAX_SAFE_INTEGER
          v.currentTime = Math.max(0, Math.min(dur, v.currentTime + delta))
        }
        switch (k) {
          case ' ':
          case 'k':
          case 'K':
            e.preventDefault()
            clearAutoNext()
            if (v.paused) v.play().catch(() => {})
            else v.pause()
            break
          case 'j':
          case 'J':
            e.preventDefault()
            seekBy(-10)
            break
          case 'l':
          case 'L':
            e.preventDefault()
            seekBy(10)
            break
          case 'ArrowLeft':
            e.preventDefault()
            seekBy(-10)
            break
          case 'ArrowRight':
            e.preventDefault()
            seekBy(10)
            break
          case 'ArrowUp':
            e.preventDefault()
            v.volume = Math.min(1, Math.round((v.volume + 0.05) * 100) / 100)
            v.muted = false
            break
          case 'ArrowDown':
            e.preventDefault()
            v.volume = Math.max(0, Math.round((v.volume - 0.05) * 100) / 100)
            break
          case 'm':
          case 'M':
            e.preventDefault()
            v.muted = !v.muted
            break
          case 'n':
          case 'N':
            e.preventDefault()
            clickNavLink('watch-next')
            break
          case 'p':
          case 'P':
            e.preventDefault()
            clickNavLink('watch-prev')
            break
          case 'i':
          case 'I':
            e.preventDefault()
            togglePip()
            break
          case 'f':
          case 'F': {
            e.preventDefault()
            const anyV = v as HTMLVideoElement & { webkitEnterFullscreen?: () => void }
            if (typeof v.requestFullscreen === 'function') {
              if (document.fullscreenElement) document.exitFullscreen().catch(() => {})
              else v.requestFullscreen().catch(() => {})
            } else if (typeof anyV.webkitEnterFullscreen === 'function') {
              anyV.webkitEnterFullscreen()
            }
            break
          }
          default:
            // 0–9: nhảy tới % tương ứng của thời lượng.
            if (/^[0-9]$/.test(k) && Number.isFinite(v.duration) && v.duration > 0) {
              e.preventDefault()
              v.currentTime = v.duration * (Number(k) / 10)
            }
        }
      }
      document.addEventListener('keydown', onKey)

      return () => {
        document.removeEventListener('keydown', onKey)
        document.removeEventListener('visibilitychange', onVisibility)
        clearAutoNext()
      }
    })
  </script>
</BaseLayout>