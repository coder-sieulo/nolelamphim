---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ReportButton from '../../../components/ReportButton.astro'
import ThemeBG from '../../../components/ThemeBG.astro'
import { getMovieDetail, getMovieEpisodes } from '../../../lib/api'
import { imgUrl } from '../../../lib/img'
import { SITE_URL } from '../../../lib/site'
import { breadcrumbLd } from '../../../lib/seo'
import { FaCirclePlay } from 'react-icons/fa6'

const slug = Astro.params.slug ?? ''
const episode = Astro.params.episode ?? ''

const [data, epRes] = await Promise.all([
  getMovieDetail(slug).catch(() => ({ status: false, movie: null })),
  getMovieEpisodes(slug),
])

if (!data.status || !data.movie) {
  return Astro.redirect('/404', 404)
}

const movie = data.movie
const episodes = epRes.status ? epRes.episodes : []

const serverData = episodes.map((s) => ({
  name: s.server_name.trim(),
  items: s.list.map((e) => ({ name: e.name, slug: e.slug, embed: e.embed })),
}))

const currentServer = episodes[0]
const currentList = currentServer?.list ?? []
const currentEpIdx = currentList.findIndex((e) => e.slug === episode)
const currentEp = currentList[currentEpIdx]
const prevEp = currentEpIdx > 0 ? currentList[currentEpIdx - 1] : null
const nextEp = currentEpIdx < currentList.length - 1 ? currentList[currentEpIdx + 1] : null

const pageTitle = movie.name && currentEp ? `${movie.name} - ${currentEp.name}` : movie.name

let embedOrigin = ''
try {
  if (currentEp?.embed) embedOrigin = new URL(currentEp.embed).origin
} catch {}

const breadcrumb = [
  { name: 'Trang chủ', path: '/' },
  { name: movie.name, path: `/phim/${slug}` },
  { name: currentEp?.name ?? episode, path: `/xem/${slug}/${episode}` },
]

// Kinh dị — áp dụng cho mọi phim có tag Kinh Dị
const isHorror = (movie.category ?? []).some((c) => c.slug === 'kinh-di')

// Loader reel đặc biệt
const specialLoader = isHorror
---

<BaseLayout title={pageTitle} description={`Xem ${movie.name} ${currentEp ? `tập ${currentEp.name}` : ''} HD VietSub miễn phí tại Nô Lệ Làm Phim.`} ogImage={`${SITE_URL}/og/${slug}.png`}>
  <script is:inline set:html={breadcrumbLd(breadcrumb)} type="application/ld+json" />
  {embedOrigin && <link rel="preconnect" href={embedOrigin} slot="head" />}
  <ThemeBG name={slug} variant={isHorror ? 'horror' : undefined} />
  {
    !currentEp ? (
      <div class="px-4 md:px-8 py-20 flex flex-col items-center">
        <p class="text-text-secondary text-sm">Không tìm thấy tập phim</p>
        <a href={`/phim/${slug}`} class="mt-4 glass-tile px-5 py-2 rounded-xl text-xs text-text-secondary">
          Quay lại
        </a>
      </div>
    ) : (
      <>
        {/* ── Cảnh báo kinh dị ── */}
        {isHorror && (
          <div id="horror-warning" class="fixed inset-0 z-[120] flex items-center justify-center p-6 pointer-events-auto">
            <div class="absolute inset-0 bg-[#080000]/92 backdrop-blur-sm"></div>
            <div class="relative w-full max-w-lg rounded-2xl overflow-hidden">
              {/* ── Bước 1: cảnh báo kinh dị ── */}
              <div id="horror-step-alert" class="rounded-2xl border border-[#ff2222]/25 bg-[#0d0004]/95 p-8 md:p-10 space-y-6 shadow-[0_0_80px_-20px_rgba(255,0,30,0.35)]">
                <div class="absolute inset-0 bg-gradient-to-b from-[#FF0033]/10 via-transparent to-transparent pointer-events-none"></div>
                <div class="space-y-4">
                  <p class="text-[13px] md:text-[15px] leading-relaxed text-[#ffccaa]">
                    Bạn sắp xem một bộ phim kinh dị siêu biến thái về mặt tâm lý.
                    Nếu bạn có bị giật mình mà ném bay cả điện thoại vào tường
                    thì tự chịu tiền thay màn hình chứ web không đền.
                  </p>
                  <p class="text-[13px] md:text-[15px] leading-relaxed text-[#ffccaa]">
                    Đặc biệt, đội ngũ Dev đang trùm chăn code cái dòng này
                    cũng đang rất sợ, nên đêm nay có bị bóng đè thì tự đi mà niệm chú
                    chứ tuyệt đối không được lên mạng chửi tụi tôi.
                  </p>
                  <p class="text-base md:text-lg font-bold text-[#FF3344] tracking-wide">
                    Bạn có đồng tình không?
                  </p>
                </div>
                <div class="flex gap-3">
                  <button
                    id="horror-agree"
                    type="button"
                    class="flex-1 rounded-xl px-5 py-3 text-sm font-bold tracking-wide bg-gradient-to-br from-[#FF0033] to-[#aa0011] text-white border border-[#FF3344]/40 hover:brightness-125 transition-all"
                  >
                    TOI DONG TINH
                  </button>
                  <button
                    id="horror-decline"
                    type="button"
                    class="flex-1 rounded-xl px-5 py-3 text-sm font-bold tracking-wide bg-[#1a0006] text-[#ff8888] border border-[#ff2222]/25 hover:bg-[#2a0008] transition-all"
                  >
                    TOI KHONG DONG TINH
                  </button>
                </div>
              </div>

              {/* ── Bước 2: hiện cờ 7 màu LGBT ── */}
              <div id="horror-step-pride" class="hidden relative rounded-2xl border border-white/15 bg-[#0c0a12]/97 p-8 md:p-10 space-y-6 shadow-[0_0_60px_-18px_rgba(255,0,200,0.5)] text-center">
                <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-white/6 via-transparent to-transparent pointer-events-none"></div>
                <div class="relative flex justify-center mb-5">
                  <div class="pride-flag-svg relative">
                    <svg width="260" height="150" viewBox="0 0 260 160" fill="none" aria-label="Cờ 7 màu" role="img">
                      <defs>
                        <clipPath id="pride-wave">
                          <path d="M8 20 C 50 8, 90 30, 130 18 C 170 6, 215 28, 250 14 L 252 140 C 215 154, 170 132, 130 144 C 90 156, 50 134, 10 146 Z" />
                        </clipPath>
                      </defs>
                      <g clip-path="url(#pride-wave)">
                        <rect x="0" y="0" width="260" height="23" fill="#FF0000" transform="skewX(0)" />
                        <rect x="0" y="23" width="260" height="23" fill="#FF7F00" />
                        <rect x="0" y="46" width="260" height="23" fill="#FFFF00" />
                        <rect x="0" y="69" width="260" height="23" fill="#00C21F" />
                        <rect x="0" y="92" width="260" height="23" fill="#1A00C2" />
                        <rect x="0" y="115" width="260" height="23" fill="#7B00C2" />
                        <rect x="0" y="138" width="260" height="22" fill="#FF00B0" />
                      </g>
                      <rect x="-2" y="-2" width="258" height="158" rx="4" stroke="rgba(255,255,255,0.25)" fill="none" />
                    </svg>
                    <div class="pride-pole absolute -left-1 top-0 bottom-0 w-[5px] rounded bg-gradient-to-b from-white/70 to-white/30"></div>
                  </div>
                </div>
                <p class="text-base md:text-lg leading-relaxed text-gray-100 font-medium">
                  Cảm ơn bạn đã dũng cảm công khai xu hướng tính dục!
                  <br />
                  Chúc bạn xem phim ma vui vẻ cùng bạn đời.
                </p>
                <button
                  id="horror-oke"
                  type="button"
                  class="inline-block rounded-xl px-10 py-3 text-sm font-bold tracking-wide text-white bg-white/10 border border-white/30 hover:bg-white/20 hover:scale-105 transition-all"
                >
                  Oke
                </button>
              </div>
            </div>
          </div>
        )}

        <div
        class="watch-page px-4 md:px-8 py-6 space-y-4"
        data-slug={slug}
        data-episode={episode}
        data-movie-name={movie.name}
        data-movie-id={movie._id}
        data-movie-thumb={movie.thumb_url || ''}
        data-movie-vote={movie.tmdb?.vote_average || ''}
        data-ep-name={currentEp.name}
        data-servers={serverData.length > 0 ? JSON.stringify(serverData) : '[]'}
      >
        <div class="watch-player">
          <div class="relative rounded-2xl overflow-hidden bg-black glass-frame">
          <div
            id="player-stage"
            class="aspect-video w-full relative"
            data-embed={currentEp.embed}
            data-title={`${movie.name} - ${currentEp.name}`}
          >
            <button
              id="player-play"
              type="button"
              class="absolute inset-0 w-full h-full group"
              aria-label={`Phát ${movie.name} - ${currentEp.name}`}
            >
              <img
                src={imgUrl(movie.thumb_url || movie.poster_url || '', 1600)}
                alt=""
                class="absolute inset-0 w-full h-full object-cover"
                decoding="async"
              />
              <div class="absolute inset-0 bg-black/35 group-hover:bg-black/20 transition-colors"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-16 h-16 md:w-20 md:h-20 rounded-full glass-tile flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                  <FaCirclePlay className="w-7 h-7 md:w-8 md:h-8 text-white ml-1" />
                </div>
              </div>
              <span class="absolute bottom-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full glass-tile text-[11px] font-semibold text-white">
                Bấm để phát
              </span>
            </button>
          </div>
          {
            specialLoader && (
              <div id="player-loader" class="hidden absolute inset-0 z-40 flex flex-col items-center justify-center gap-5" aria-live="polite" role="status">
                <div class="horror-loader relative w-28 h-28 md:w-32 md:h-32">
                  <div class="horror-ring absolute inset-0 rounded-full border-2 border-[#FF0033]/25"></div>
                  <div class="horror-ring absolute inset-2 rounded-full border border-[#FF0033]/40"></div>
                  <div class="horror-eye absolute inset-0 flex items-center justify-center">
                    <div class="horror-pupil w-16 h-16 md:w-[4.5rem] md:h-[4.5rem] rounded-full bg-gradient-to-br from-[#FF0033] to-[#3d0000]"></div>
                    <div class="horror-glint absolute w-5 h-5 rounded-full bg-white/30 blur-[2px] horror-glint-move"></div>
                  </div>
                </div>
                <div class="flex flex-col items-center gap-1.5">
                  <p class="horror-title text-lg md:text-xl font-bold text-[#FF3344] tracking-wide">Đang nạp phim</p>
                  <p class="text-[11px] text-red-200/30 tracking-[0.3em] uppercase">Đèn đã tắt... hãy bình tĩnh</p>
                </div>
                <div class="film-bar w-44 h-1 rounded-full overflow-hidden bg-[#FF0033]/10 relative">
                  <div class="horror-bar h-full rounded-full bg-gradient-to-r from-[#5a0000] via-[#FF0033] to-[#ff6a00]"></div>
                </div>
              </div>
            )
          }
          {
            nextEp && (
              <a
                id="watch-next-float"
                href={`/xem/${slug}/${nextEp.slug}`}
                data-astro-prefetch="load"
                class="absolute bottom-3 right-3 z-20 px-3 py-1.5 rounded-full glass-tile text-white text-[11px] font-medium opacity-80 hover:opacity-100 hover:scale-105 transition-all"
              >
                Tập kế tiếp →
              </a>
            )
          }
        </div>
        </div>

        <div class="content-card px-5 py-4">
          <div class="flex items-center gap-2 text-xs text-text-muted mb-2 flex-wrap">
            <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
            <span>/</span>
            <a href={`/phim/${slug}`} class="hover:text-white transition-colors">{movie.name}</a>
            <span>/</span>
            <span class="text-white">{currentEp.name}</span>
          </div>
          <h1 class="text-lg font-bold text-text-primary">{movie.name} - {currentEp.name}</h1>
        </div>

        {
          serverData.length > 1 && (
            <div id="watch-servers" class="flex gap-2 flex-wrap">
              {
                serverData.map((s, i) => (
                  <button
                   
                    type="button"
                    class={`watch-server px-4 py-2 rounded-xl text-xs font-medium transition-all ${
                      i === 0 ? 'glass-tile-active text-white' : 'glass-tile text-text-secondary'
                    }`}
                    data-server={i}
                  >
                    {s.name}
                  </button>
                ))
              }
            </div>
          )
        }

        <div class="flex items-center gap-3 flex-wrap">
          {
            prevEp ? (
              <a id="watch-prev" href={`/xem/${slug}/${prevEp.slug}`} class="px-5 py-2.5 rounded-xl glass-tile text-text-secondary text-xs hover:text-white">
                ← {prevEp.name}
              </a>
            ) : (
              <span id="watch-prev" class="px-5 py-2.5 rounded-xl text-text-muted text-xs opacity-40">← Hết</span>
            )
          }

          <a href={`/phim/${slug}`} class="px-5 py-2.5 rounded-xl glass-tile text-text-secondary text-xs hover:text-white">
            Danh sách tập
          </a>

          <ReportButton slug={slug} name={movie.name} episode={currentEp.name} />

          {
            nextEp ? (
              <a id="watch-next" href={`/xem/${slug}/${nextEp.slug}`} class="px-5 py-2.5 rounded-xl glass-tile text-text-secondary text-xs hover:text-white">
                {nextEp.name} →
              </a>
            ) : (
              <span id="watch-next" class="px-5 py-2.5 rounded-xl text-text-muted text-xs opacity-40">Hết →</span>
            )
          }
        </div>
      </div>
      </>
    )
  }

  <script>
    import { addRecent } from '../../../scripts/store'
    import { escapeHTML } from '../../../scripts/cards'
    import { registerPageInit } from '../../../scripts/lifecycle'

    registerPageInit(() => {
      const page = document.querySelector<HTMLElement>('.watch-page')
      if (!page) return () => {}

      const warning = document.getElementById('horror-warning')
      if (warning) {
        const slug = page.dataset.slug || ''
        const alertStep = document.getElementById('horror-step-alert')
        const prideStep = document.getElementById('horror-step-pride')
        const agree = document.getElementById('horror-agree')
        const decline = document.getElementById('horror-decline')
        const oke = document.getElementById('horror-oke')
        function closeWarning() {
          warning?.classList.add('hidden')
          document.body.classList.remove('overflow-hidden')
          const play = document.getElementById('player-play') as HTMLButtonElement | null
          play?.click()
        }
        agree?.addEventListener('click', () => {
          alertStep?.classList.add('hidden')
          prideStep?.classList.remove('hidden')
        })
        decline?.addEventListener('click', () => {
          window.location.href = `/phim/${slug}`
        })
        oke?.addEventListener('click', closeWarning)
        document.body.classList.add('overflow-hidden')
      }
      const slug = page.dataset.slug || ''
      const episode = page.dataset.episode || ''
      const movieName = page.dataset.movieName || ''
      const movieId = Number(page.dataset.movieId)
      const movieThumb = page.dataset.movieThumb || ''
      const movieVote = page.dataset.movieVote || ''
      const epName = page.dataset.epName || ''

      let servers: { name: string; items: { name: string; slug: string; embed: string }[] }[] = []
      try {
        servers = JSON.parse(page.dataset.servers || '[]')
      } catch {
        servers = []
      }

      const serverBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('.watch-server'))

      const stage = document.getElementById('player-stage')
      const playBtn = document.getElementById('player-play')
      const loaderEl = document.getElementById('player-loader')
      let frame: HTMLIFrameElement | null = null
      let pendingEmbed = stage?.dataset.embed || ''
      let pendingTitle = stage?.dataset.title || ''
      let loaderMinTimer = 0
      let frameLoaded = false

      function maybeHideLoader() {
        if (!loaderEl) return
        if (frameLoaded && loaderMinTimer <= 0) hideLoader()
      }

      function showLoader() {
        if (!loaderEl) return
        loaderEl.classList.add('reel-active')
        loaderEl.classList.remove('hidden')
        frameLoaded = false
        window.clearTimeout(loaderMinTimer)
        loaderMinTimer = window.setTimeout(() => {
          loaderMinTimer = 0
          maybeHideLoader()
        }, 1500)
      }
      function hideLoader() {
        if (!loaderEl) return
        loaderEl.classList.add('hidden')
        loaderEl.classList.remove('reel-active')
      }

      function createFrame(embed: string, title: string) {
        if (!stage || frame) return
        playBtn?.classList.add('hidden')
        frame = document.createElement('iframe')
        frame.id = 'watch-frame'
        frame.className = 'w-full h-full'
        frame.setAttribute('allowfullscreen', '')
        frame.setAttribute('allow', 'autoplay; fullscreen')
        frame.title = title
        frame.src = embed
        frame.addEventListener('load', () => {
          frameLoaded = true
          maybeHideLoader()
        })
        stage.innerHTML = ''
        stage.appendChild(frame)
        showLoader()
      }

      playBtn?.addEventListener('click', () => {
        createFrame(pendingEmbed, pendingTitle)
      })

      if (loaderEl && pendingEmbed) {
        createFrame(pendingEmbed, pendingTitle)
      }

      addRecent({
        id: movieId,
        slug,
        name: movieName,
        thumb: movieThumb,
        episode: epName,
        episodeSlug: episode,
        tmdb_vote: movieVote || undefined,
      })

      function epLink(id: string, href: string, text: string) {
        return `<a id="${id}" href="${href}" class="px-5 py-2.5 rounded-xl glass-tile text-text-secondary text-xs hover:text-white">${text}</a>`
      }

      function epEmpty(id: string, text: string) {
        return `<span id="${id}" class="px-5 py-2.5 rounded-xl text-text-muted text-xs opacity-40">${text}</span>`
      }

      function renderNav(items: { name: string; slug: string }[], idx: number) {
        const prev = document.getElementById('watch-prev')
        const next = document.getElementById('watch-next')
        const p = idx > 0 ? items[idx - 1] : null
        const n = idx >= 0 && idx < items.length - 1 ? items[idx + 1] : null
        if (prev) prev.outerHTML = p ? epLink('watch-prev', `/xem/${slug}/${p.slug}`, `← ${escapeHTML(p.name)}`) : epEmpty('watch-prev', '← Hết')
        if (next) next.outerHTML = n ? epLink('watch-next', `/xem/${slug}/${n.slug}`, `${escapeHTML(n.name)} →`) : epEmpty('watch-next', 'Hết →')
        const float = document.getElementById('watch-next-float') as HTMLAnchorElement | null
        if (float) {
          if (n) {
            float.href = `/xem/${slug}/${n.slug}`
            float.classList.remove('hidden')
          } else {
            float.classList.add('hidden')
          }
        }
      }

      serverBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const i = Number(btn.dataset.server)
          const server = servers[i]
          if (!server) return
          let idx = server.items.findIndex((e) => e.slug === episode)
          if (idx < 0) idx = 0
          const ep = server.items[idx]
          serverBtns.forEach((b) => {
            const active = Number(b.dataset.server) === i
            b.className = active
              ? `watch-server px-4 py-2 rounded-xl text-xs font-medium transition-all glass-tile-active text-white`
              : `watch-server px-4 py-2 rounded-xl text-xs font-medium transition-all glass-tile text-text-secondary`
          })
          if (ep) {
            pendingEmbed = ep.embed
            pendingTitle = `${movieName} - ${ep.name}`
            if (frame) {
              showLoader()
              frame.addEventListener('load', () => {
                frameLoaded = true
                maybeHideLoader()
              })
              frame.src = ep.embed
              frame.title = pendingTitle
            }
          }
          renderNav(server.items, idx)
        })
      })

      function isTyping(): boolean {
        const el = document.activeElement
        if (!el) return false
        const tag = el.tagName
        return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (el as HTMLElement).isContentEditable
      }

      function onKey(e: KeyboardEvent) {
        if (isTyping()) return
        if (e.key === 'ArrowRight') {
          const next = document.getElementById('watch-next')
          if (next && next.tagName === 'A') {
            e.preventDefault()
            next.click()
          }
        } else if (e.key === 'ArrowLeft') {
          const prev = document.getElementById('watch-prev')
          if (prev && prev.tagName === 'A') {
            e.preventDefault()
            prev.click()
          }
        } else if (e.key === 'f' || e.key === 'F') {
          const f = document.getElementById('watch-frame') as HTMLIFrameElement | null
          if (f && typeof f.requestFullscreen === 'function') {
            e.preventDefault()
            f.requestFullscreen().catch(() => {})
          }
        }
      }
      document.addEventListener('keydown', onKey)

      return () => {
        document.removeEventListener('keydown', onKey)
      }
    })
  </script>
</BaseLayout>
