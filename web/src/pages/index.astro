---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSingle from '../components/HeroSingle.astro'
import ContinueWatching from '../components/ContinueWatching.astro'
import ForYou from '../components/ForYou.astro'
import CategorySection from '../components/CategorySection.astro'
import MovieGrid from '../components/MovieGrid.astro'
import MovieCard from '../components/MovieCard.astro'
import SectionHeader from '../components/ui/SectionHeader.astro'
import { getNewMovies, getSubteam, getMoviesByCategory } from '../lib/api'
import { imgUrl, imgSrcSet } from '../lib/img'
import type { Movie } from '../lib/types'

export const prerender = true
export const revalidate = 60

const [newMovies, subteam] = await Promise.all([
  getNewMovies().catch(() => ({ status: false, items: [], pagination: undefined })),
  getSubteam().catch(() => ({ status: false, items: [], pagination: undefined })),
])

// "Phim đang hot": getNewMovies sắp theo tmdb_vote desc (không có endpoint hot)
const hotMovies = newMovies.items
  .slice()
  .sort((a, b) => (Number(b.tmdb?.vote_average) || 0) - (Number(a.tmdb?.vote_average) || 0))
  .slice(0, 12)

const categorySlugs = [
  { slug: 'hanh-dong', name: 'Hành Động' },
  { slug: 'lang-man', name: 'Lãng Mạn' },
  { slug: 'kinh-di', name: 'Kinh Dị' },
  { slug: 'hoat-hinh', name: 'Hoạt Hình' },
  { slug: 'hai', name: 'Hài' },
  { slug: 'co-trang', name: 'Cổ Trang' },
]

const categoryItems = await Promise.all(
  categorySlugs.map((c) =>
    getMoviesByCategory(c.slug, { limit: 12 })
      .then((d) => ({ slug: c.slug, name: c.name, items: d.items }))
      .catch(() => ({ slug: c.slug, name: c.name, items: [] })),
  ),
)

// ── Hero: banner xoay vòng qua vài phim "top" ──
// Gộp mọi nguồn đã tải ở trang chủ (mới cập nhật + subteam + các thể loại),
// bỏ trùng theo slug rồi chấm điểm: ưu tiên điểm TMDB, phụ theo năm.
const heroPool: Movie[] = []
{
  const seen = new Set<string>()
  for (const m of [...newMovies.items, ...subteam.items, ...categoryItems.flatMap((c) => c.items)]) {
    if (!m || !m.slug || seen.has(m.slug)) continue
    if (!(m.poster_url || m.thumb_url)) continue
    seen.add(m.slug)
    heroPool.push(m)
  }
}
const heroScore = (m: Movie) => {
  const r = Number(m.tmdb?.vote_average) || 0
  const v = Number(m.tmdb?.vote_count) || 0
  // Trung bình có trọng số (IMDb): phim ít lượt bị kéo về mức 7.0 — tránh phim
  // 1–2 lượt bình chọn mà điểm 10 đứng đầu banner.
  const M = 50
  const weighted = v > 0 ? (v / (v + M)) * r + (M / (v + M)) * 7 : 0
  const year = Math.min(Math.max((Number(m.year) || 0) - 2000, 0), 40)
  return weighted * 100 + year
}
const heroMovies: Movie[] = heroPool
  .slice()
  .sort((a, b) => heroScore(b) - heroScore(a))
  .slice(0, 6)
const heroMovie = heroMovies[0] ?? null
const heroImage = heroMovie ? heroMovie.poster_url || heroMovie.thumb_url : ''

const showSubteam = subteam.items.length > 0
---

<BaseLayout>
  <Fragment slot="head">
    {heroImage && (
      <link
        rel="preload"
        as="image"
        href={imgUrl(heroImage, 1600)}
        imagesrcset={imgSrcSet(heroImage)}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
  </Fragment>

  <HeroSingle movies={heroMovies} />

  <div class="px-4 sm:px-6 md:px-8 pb-16">
    {/* 1. Tiếp tục xem — lên đầu trang (brief §06) */}
    <ContinueWatching />

    {/* 2. Dành cho bạn — dựng từ watch history (client), ẩn nếu trống */}
    <ForYou />

    {/* 3. Phim đang hot — getNewMovies sắp theo vote (không có endpoint hot) */}
    {
      hotMovies.length > 0 && (
        <section class="mt-10">
          <SectionHeader title="Phim đang hot" href="/danh-sach/phim-moi-cap-nhat" linkLabel="Xem tất cả" />
          <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none snap-x snap-mandatory">
            {
              hotMovies.map((movie) => (
                <div class="snap-start shrink-0 w-[150px]">
                  <MovieCard movie={movie} dot="hot" />
                </div>
              ))
            }
          </div>
        </section>
      )
    }

    {/* 4. Mới cập nhật — grid đầy đủ + phân trang */}
    {
      newMovies.items.length > 0 && (
        <section class="mt-10">
          <SectionHeader title="Mới cập nhật" />
          <MovieGrid
            initialItems={newMovies.items}
            path="/danh-sach/phim-moi-cap-nhat"
            dot="new"
            totalPages={newMovies.pagination?.totalPages}
          />
        </section>
      )
    }

    {/* 5. Khám phá — Subteam + các row thể loại gộp lại (brief §07, không card) */}
    {
      (showSubteam || categoryItems.some((c) => c.items.length > 0)) && (
        <section class="mt-12">
          <SectionHeader title="Khám phá" href="/the-loai" linkLabel="Tất cả thể loại" />

          {
            showSubteam && (
              <div class="mt-1">
                <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none snap-x snap-mandatory">
                  {
                    subteam.items.slice(0, 10).map((movie) => (
                      <div class="snap-start shrink-0 w-[150px]">
                        <MovieCard movie={movie} dot="hot" />
                      </div>
                    ))
                  }
                </div>
              </div>
            )
          }

          {
            categoryItems.map((c, i) => (
              <CategorySection
                slug={c.slug}
                name={c.name}
                items={c.items}
                className={showSubteam || i > 0 ? 'mt-8' : 'mt-6'}
              />
            ))
          }
        </section>
      )
    }
  </div>
</BaseLayout>