---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ThemeBG from '../../../components/ThemeBG.astro'
import { getSessionUser } from '../../../lib/auth'
import { getRoom } from '../../../lib/rooms'
import { FaDiscord, FaTv, FaCirclePlay, FaClock, FaStop, FaComment, FaSliders, FaLock } from 'react-icons/fa6'
import { FiLogOut } from 'react-icons/fi'

const code = (Astro.params.code || '').toUpperCase()

const user = await getSessionUser(Astro.cookies)
const room = await getRoom(code)

if (!room) {
  return Astro.redirect('/404', 404)
}

const isHost = !!user && user.sub === room.hostId
---

<BaseLayout title={`Xem Chung #${code}`} description="Phòng xem phim cùng nhau trên Nô Lệ Làm Phim." noIndex>
  <ThemeBG name="xem-chung" />
  <main class="px-4 md:px-8 py-6 space-y-4" data-room-page data-code={code} data-host={String(isHost)}>
    <div id="xc-login-overlay" class="hidden fixed inset-0 z-50 flex-col items-center justify-center gap-4 bg-black/75 backdrop-blur-sm">
      <div class="content-card px-8 py-8 text-center max-w-sm mx-4">
        <div class="w-14 h-14 rounded-full glass-tile flex items-center justify-center mb-3 mx-auto text-[#FF6B9D]"><FaLock className="w-6 h-6" /></div>
        <h2 class="text-lg font-bold text-text-primary">Đăng nhập để xem cùng nhau</h2>
        <p class="text-sm text-text-secondary mt-2 mb-5">Bạn cần đăng nhập Discord để tham gia phòng, chat và đồng bộ phim.</p>
        <a href="/api/auth/discord"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-[#5865F2] text-white hover:brightness-110 transition-all">
          <FaDiscord className="w-5 h-5" />
          Đăng nhập bằng Discord
        </a>
        <a href="/xem-chung" class="block mt-3 text-xs text-text-muted hover:text-white transition-colors">← Quay lại trang Xem Chung</a>
      </div>
    </div>
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl glass-tile flex items-center justify-center text-[#FF6B9D]"><FaTv className="w-5 h-5" /></div>
        <div>
          <h1 class="text-lg font-bold text-text-primary">Phòng <span class="font-mono tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-[#FF6B9D] to-[#C44BED]">#{code}</span></h1>
          <p id="xc-status" class="text-xs text-text-muted">Đang tải...</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="xc-share" type="button" class="px-4 py-2 rounded-xl glass-tile text-xs font-medium text-text-secondary hover:text-white transition-colors">
          Sao chép link mời
        </button>
        <a href="/xem-chung" class="px-4 py-2 rounded-xl glass-tile text-xs font-medium text-text-secondary hover:text-white transition-colors">Thoát</a>
      </div>
    </div>

    <div class="grid lg:grid-cols-[1fr_340px] gap-4 items-start">
      <div class="space-y-4 min-w-0">
        <!-- Player -->
        <div class="content-card p-2 md:p-3">
          <div id="player-stage" class="aspect-video w-full relative rounded-xl overflow-hidden bg-black">
            <div id="xc-now-playing" class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-4 p-6 text-center">
              <div class="w-16 h-16 rounded-full glass-tile flex items-center justify-center text-[#FF6B9D]">
                <FaCirclePlay className="w-7 h-7" />
              </div>
              <p id="xc-no-movie-text" class="text-sm text-text-secondary">Chưa có phim nào được phát trong phòng này.</p>
              <p class="text-xs text-text-muted">Host sẽ chọn phim và ấn phát — mọi người xem cùng một nhịp thời gian.</p>
            </div>
            <iframe id="xc-frame" title="Phát phim" class="hidden absolute inset-0 w-full h-full border-0" allow="autoplay; fullscreen; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            <div id="xc-countdown" class="hidden absolute inset-0 z-20 flex-col items-center justify-center bg-black/85">
              <p class="text-4xl md:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#FF6B9D] to-[#C44BED]" id="xc-countdown-num">10</p>
              <p class="text-xs text-text-muted mt-2">Sắp bắt đầu...</p>
              <button id="xc-ready" type="button" class="xc-ready-btn mt-5 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold glass-tile text-text-secondary hover:text-white transition-all">✅ Tôi đã sẵn sàng</button>
              <p id="xc-ready-count" class="hidden text-[11px] text-text-muted mt-2"></p>
            </div>
            <div id="xc-buffering" class="hidden absolute inset-0 z-30 items-center justify-center bg-black/60">
              <div class="w-8 h-8 rounded-full border-2 border-white/20 border-t-[#C44BED] animate-spin"></div>
            </div>
          </div>
        </div>

        <!-- Now playing info -->
        <div id="xc-movie-info" class="content-card px-5 py-4 hidden">
          <div class="flex items-center gap-3">
            <img id="xc-thumb" alt="" class="w-16 h-[4.5rem] rounded-lg object-cover shrink-0" />
            <div class="min-w-0">
              <h2 id="xc-movie-name" class="font-bold text-text-primary text-sm truncate"></h2>
              <p id="xc-ep-name" class="text-xs text-text-muted"></p>
              <p id="xc-clock" class="text-xs text-text-secondary font-mono mt-1"></p>
            </div>
            <div class="ml-auto shrink-0">
              <button id="xc-resync" type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl glass-tile text-xs font-medium text-text-secondary hover:text-white transition-all disabled:opacity-40" disabled><FaTv className="w-3.5 h-3.5" /> Tái đồng bộ</button>
            </div>
          </div>
        </div>

        <!-- Host controls -->
        <div id="xc-host-panel" class="content-card px-5 py-4 space-y-3 hidden">
          <h3 class="text-sm font-bold text-text-primary flex items-center gap-2"><FaSliders className="w-3.5 h-3.5 text-[#FF6B9D]" /> Host</h3>
          <div>
            <input
              id="xc-lookup"
              type="text"
              placeholder="Gõ tên phim để chọn..."
              autocomplete="off"
              class="w-full px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-[#C44BED]/50"
            />
            <div id="xc-lookup-res" class="hidden mt-2 w-full max-h-72 overflow-y-auto rounded-xl glass-tile border border-white/10"></div>
          </div>
          <div id="xc-ep-picker" class="hidden space-y-3">
            <div class="flex items-center gap-3 p-3 rounded-xl glass-tile">
              <img id="xc-pick-thumb" alt="" class="w-16 h-[4.5rem] rounded-lg object-cover shrink-0" />
              <div class="min-w-0">
                <p id="xc-pick-name" class="text-sm font-bold text-text-primary truncate"></p>
                <p id="xc-pick-meta" class="text-[11px] text-text-muted"></p>
              </div>
            </div>
            <div>
              <p class="text-[11px] font-semibold text-text-muted uppercase tracking-wide mb-1.5 px-1">Chọn tập</p>
              <div id="xc-ep-grid" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-1.5 max-h-48 overflow-y-auto p-1"></div>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <button id="xc-play-now" type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-gradient-to-r from-[#FF6B9D] to-[#C44BED] text-white hover:brightness-110 disabled:opacity-40 transition-all" disabled><FaCirclePlay className="w-3.5 h-3.5" /> Phát ngay (10s)</button>
            <button id="xc-schedule" type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold glass-tile text-text-secondary hover:text-white disabled:opacity-40 transition-all" disabled><FaClock className="w-3.5 h-3.5" /> Đặt giờ chiếu</button>
            <button id="xc-stop" type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold glass-tile text-text-muted hover:text-white disabled:opacity-40 transition-all"><FaStop className="w-3 h-3" /> Kết thúc</button>
          </div>
          <div id="xc-schedule-pick" class="hidden flex items-center gap-2">
            <input id="xc-schedule-dt" type="datetime-local" class="px-3 py-2 rounded-xl bg-white/5 border border-white/10 text-xs text-text-primary flex-1 min-w-0" />
            <button id="xc-schedule-confirm" type="button" class="px-4 py-2 rounded-xl glass-tile-active text-xs font-bold text-white">Đặt</button>
          </div>
          <p id="xc-host-error" class="hidden text-xs text-red-400"></p>
        </div>
      </div>

      <!-- Chat column -->
      <div class="content-card flex flex-col min-h-[30rem] lg:min-h-0 lg:h-[calc(100vh-12rem)]">
        <div class="flex items-center justify-between px-5 py-3 border-b border-white/5">
          <h3 class="text-sm font-bold text-text-primary flex items-center gap-2"><FaComment className="w-3.5 h-3.5 text-[#FF6B9D]" /> Chat</h3>
          <span id="xc-members-pop" class="text-xs text-text-muted"></span>
        </div>
        <div id="xc-login-gate" class="hidden flex-1 flex flex-col items-center justify-center gap-3 p-6 text-center">
          <p class="text-sm text-text-secondary">Đăng nhập Discord để tham gia chat và xem.</p>
          <a href="/api/auth/discord"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-[#5865F2] text-white hover:brightness-110 transition-all">
            <FaDiscord className="w-5 h-5" />
            Đăng nhập bằng Discord
          </a>
        </div>
        <div id="xc-chat" class="flex-1 overflow-y-auto px-4 py-3 space-y-2 min-h-[18rem]"></div>
        <form id="xc-chat-form" class="flex gap-2 p-3 border-t border-white/5">
          <input id="xc-chat-input" type="text" maxlength="500" placeholder="Nhắn gì đó..." autocomplete="off"
            class="flex-1 min-w-0 px-3 py-2 rounded-xl bg-white/5 border border-white/10 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-[#C44BED]/50" />
          <button type="submit" class="px-4 py-2 rounded-xl glass-tile-active text-xs font-bold text-white">Gửi</button>
        </form>
      </div>
    </div>
  </main>

  <script>
    import { registerPageInit } from '../../../scripts/lifecycle'

    interface Member { id: string; username: string; global_name?: string | null; avatar?: string | null }
    interface ChatMsg { id: string; userId: string; username: string; avatar?: string | null; text: string; ts: number }
    interface Movie { slug: string; movieName: string; epName: string; episode: string; thumb: string; embed: string; hash?: string; host?: string; frameDur?: number; frameCount?: number; frameUrl?: string }
    interface Room {
      code: string; status: string; hostId: string; members: Member[];
      movie: Movie | null; startTime: number; endedAt: number;
      chat: ChatMsg[]; muted: Record<string, boolean>; banned: Record<string, boolean>;
      ready: Record<string, boolean>;
    }

    function escapeHTML(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string)
    }

    function avatarUrl(id: string, avatar?: string | null): string {
      return avatar ? `https://cdn.discordapp.com/avatars/${id}/${avatar}.png?size=64` : '/logo.png'
    }

    registerPageInit(() => {
      const page = document.querySelector<HTMLElement>('[data-room-page]')
      if (!page) return () => {}
      const code = page.dataset.code || ''

      let room: Room | null = null
      let isHost = page.dataset.host === 'true'
      let _userId = ''
      let selectedMovie: { slug: string; movieName: string; episode: string; epName: string; thumb: string; embed: string } | null = null

      const $ = (id: string) => document.getElementById(id)

      // ── NTP: đo chênh lệch đồng hồ server ~ client ──
      let clockOffset = 0
      async function syncClock(): Promise<void> {
        try {
          const t0 = Date.now()
          const r = await fetch('/api/xem-chung/time', { cache: 'no-store' }).catch(() => null)
          const t1 = Date.now()
          if (!r) return
          const d = await r.json()
          if (d && typeof d.ts === 'number') {
            clockOffset = d.ts - (t0 + t1) / 2
          }
        } catch {
          /* giữ offset cũ */
        }
      }
      const nowMs = () => Date.now() + clockOffset

      function statusText(): string {
        if (!room) return 'Đang tải...'
        const n = room.members.length
        if (room.status === 'ended') return 'Phòng đã kết thúc'
        if (room.status === 'playing') return `● Đang chiếu • ${n} người`
        if (room.status === 'scheduled' && room.movie) {
          const remain = Math.max(0, Math.round((room.startTime - nowMs()) / 1000))
          return `Bắt đầu lúc ${new Date(room.startTime).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })} • còn ${remain}s • ${n} người`
        }
        return room.movie ? `Sẵn sàng • ${n} người` : `Chưa chiếu • ${n} người`
      }

      function fmtClock(ms: number): string {
        const s = Math.floor(ms / 1000)
        const d = Math.floor((ms % 1000) / 100)
        const pad = (x: number) => String(x).padStart(2, '0')
        return `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}.${d}`
      }

      async function whoami() {
        try {
          const r = await fetch('/api/auth/me', { credentials: 'same-origin' })
          const d = await r.json()
          _userId = d.user?.id || d.user?.sub || ''
        } catch { _userId = '' }
        const loggedIn = !!_userId
        const overlay = $('xc-login-overlay')
        if (overlay) {
          overlay.classList.toggle('hidden', loggedIn)
          overlay.classList.toggle('flex', !loggedIn)
          overlay.classList.toggle('flex-col', !loggedIn)
        }
        const gate = $('xc-login-gate')
        const chatBox = $('xc-chat')
        const chatFormEl = $('xc-chat-form')
        const hostPanelEl = $('xc-host-panel')
        if (gate) gate.classList.toggle('hidden', loggedIn)
        if (chatBox) chatBox.classList.toggle('hidden', !loggedIn)
        if (chatFormEl) chatFormEl.classList.toggle('hidden', !loggedIn)
        if (hostPanelEl && !loggedIn) hostPanelEl.classList.add('hidden')
        if (!loggedIn && room && room.status === 'scheduled' && room.movie) {
          const noText = $('xc-no-movie-text')
          if (noText) noText.textContent = 'Đăng nhập Discord để xem cùng mọi người.'
        }
      }

      async function refresh(): Promise<boolean> {
        try {
          const r = await fetch(`/api/xem-chung/${code}`, { credentials: 'same-origin' })
          const d = await r.json()
          if (!d.ok) { window.location.href = '/xem-chung'; return false }
          room = d.room
          isHost = !!d.isHost
          $('xc-host-panel')?.classList.toggle('hidden', !isHost)
          return true
        } catch { return false }
      }

      function renderAll() {
        const st = $('xc-status')
        if (st) st.textContent = statusText()
        const members = $('xc-members-pop')
        if (members && room) members.textContent = room.members.map((m) => m.global_name || m.username).join(', ') || '—'
        const movie = room?.movie
        const info = $('xc-movie-info')
        const nowPlaying = $('xc-now-playing')
        const noText = $('xc-no-movie-text')
        const frame = $('xc-frame') as HTMLImageElement | null
        if (!movie) {
          if (nowPlaying) nowPlaying.classList.remove('hidden')
          if (noText) noText.textContent = 'Chưa có phim nào được phát trong phòng này.'
          if (info) info.classList.add('hidden')
          if (frame) frame.classList.add('hidden')
          $('xc-countdown')?.classList.add('hidden')
          return
        }
        if (info) info.classList.remove('hidden')
        if (noText) noText.textContent = 'Đang chờ phát theo lịch của host.'
        const th = $('xc-thumb') as HTMLImageElement | null
        if (th && movie.thumb) th.src = movie.thumb
        const mn = $('xc-movie-name')
        if (mn) mn.textContent = movie.movieName
        const en = $('xc-ep-name')
        if (en) en.textContent = `${movie.epName} • ${movie.movieName}`
        const resync = $('xc-resync') as HTMLButtonElement | null
        if (resync && room) resync.disabled = room.status !== 'playing'
        // ready đếm: host auto-ready, khách cần bấm
        updateReadyUI()
        renderChat()
      }

      function updateReadyUI() {
        const r = room
        if (!r) return
        const count = $('xc-ready-count')
        const btn = $('xc-ready') as HTMLButtonElement | null
        if (!count || !btn) return
        const audience = r.members.filter((m) => m.id !== r.hostId)
        const readyN = audience.filter((m) => (r.ready || {})[m.id]).length
        btn.dataset.checked = (r.ready || {})[_userId] ? '1' : ''
        count.classList.toggle('hidden', audience.length === 0)
        if (audience.length > 0) {
          const names = audience.filter((m) => (r.ready || {})[m.id]).map((m) => m.global_name || m.username).join(', ')
          count.textContent = `Sẵn sàng ${readyN}/${audience.length}${names ? ' • ' + names : ''}`
        }
        btn.textContent = (r.ready || {})[_userId] ? '✅ Đã sẵn sàng' : '✅ Tôi đã sẵn sàng'
      }

      function renderChat() {
        const box = $('xc-chat')
        if (!box || !room) return
        box.innerHTML = room.chat.map((m) => `
          <div class="flex items-start gap-2">
            <img src="${avatarUrl(m.userId, m.avatar)}" alt="" class="w-6 h-6 rounded-full shrink-0" loading="lazy" />
            <div class="min-w-0">
              <div class="flex items-baseline gap-2">
                <span class="text-[11px] font-bold ${m.userId === room?.hostId ? 'text-transparent bg-clip-text bg-gradient-to-r from-[#FF6B9D] to-[#C44BED]' : 'text-text-secondary'}">${escapeHTML(m.username)}${m.userId === room?.hostId ? ' • host' : ''}</span>
                <span class="text-[10px] text-text-muted">${new Date(m.ts).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</span>
                ${isHost && m.userId !== room?.hostId ? `
                  <button class="xc-mute text-[10px] px-1.5 py-0.5 rounded glass-tile text-text-muted hover:text-white" data-id="${m.userId}" title="Mute">🔇</button>
                  <button class="xc-ban text-[10px] px-1.5 py-0.5 rounded glass-tile text-text-muted hover:text-red-400" data-id="${m.userId}" title="Cấm">🚫</button>
                ` : ''}
              </div>
              <p class="text-sm text-text-primary break-words">${escapeHTML(m.text)}</p>
            </div>
          </div>
        `).join('')
        box.scrollTop = box.scrollHeight
        box.querySelectorAll<HTMLButtonElement>('.xc-mute').forEach((b) => b.addEventListener('click', () => mod(b.dataset.id || '', 'mute')))
        box.querySelectorAll<HTMLButtonElement>('.xc-ban').forEach((b) => b.addEventListener('click', () => mod(b.dataset.id || '', 'ban')))
      }

      async function mod(targetId: string, action: 'mute' | 'ban') {
        const r = await fetch(`/api/xem-chung/${code}/mod`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: targetId, action }),
        }).catch(() => null)
        if (!r) return
        const d = await r.json()
        if (d.room) { room = d.room; renderAll() }
      }

      // ── Clock player (iframe embed) ──
      let timer = 0

      const frameEl = () => $('xc-frame') as HTMLIFrameElement | null
      const buffering = () => $('xc-buffering')

      function playingNow(): boolean {
        if (!room || !room.movie || room.status === 'ended' || room.status === 'open') return false
        if (room.startTime <= 0) return false
        return room.startTime <= nowMs()
      }

      function drawFrame() {
        const f = frameEl()
        const nowPlaying = $('xc-now-playing')
        const cd = $('xc-countdown')
        if (!playingNow()) {
          // Phim đã chọn nhưng chưa tới giờ (scheduled) — chỉ ẩn, GIỮ iframe src
          // để không phải load lại từ đầu (tránh lệch đồng hồ làm reset phim).
          const keepAlive = !!room?.movie && (room.status === 'scheduled' || room.status === 'playing')
          if (f) {
            f.classList.add('hidden')
            if (!keepAlive && f.src) f.removeAttribute('src')
          }
          if (nowPlaying) nowPlaying.classList.remove('hidden')
          if (cd) { cd.classList.add('hidden'); cd.classList.remove('flex'); cd.classList.remove('flex-col'); }
          const buf = buffering()
          if (buf) { buf.classList.add('hidden'); buf.classList.remove('flex'); }
          return
        }
        // countdown display (negative = playing)
        if (room && room.startTime > nowMs() && room.status === 'scheduled') {
          const remain = Math.max(0, Math.ceil((room.startTime - nowMs()) / 1000))
          const num = $('xc-countdown-num')
          if (num) num.textContent = String(remain)
          if (cd) { cd.classList.remove('hidden'); cd.classList.add('flex'); cd.classList.add('flex-col'); }
          if (nowPlaying) nowPlaying.classList.add('hidden')
          return
        }
        if (cd) { cd.classList.add('hidden'); cd.classList.remove('flex'); }
        if (nowPlaying) nowPlaying.classList.add('hidden')
        if (!room || !room.movie || !f) return
        const emb = room.movie.embed
        if (!emb) return
        if (f.dataset.src === emb) return
        f.dataset.src = emb
        const buf = buffering()
        if (buf) { buf.classList.remove('hidden'); buf.classList.add('flex'); }
        f.src = emb
        f.onload = () => {
          if (buf) { buf.classList.add('hidden'); buf.classList.remove('flex'); }
        }
        f.classList.remove('hidden')
      }

      function tickClock() {
        if (playingNow() && room?.movie) {
          const cl = $('xc-clock')
          if (cl) cl.textContent = fmtClock(nowMs() - room.startTime)
        }
      }

      // ── Host: lookup movie ──
      const lookup = $('xc-lookup') as HTMLInputElement | null
      const lookupRes = $('xc-lookup-res')
      let lookupTimer = 0
      let pickEpisodes: { name: string; slug: string; embed: string }[] = []
      const epPicker = $('xc-ep-picker')
      const epGrid = $('xc-ep-grid')
      if (lookup) {
        lookup.addEventListener('input', () => {
          window.clearTimeout(lookupTimer)
          lookupTimer = window.setTimeout(async () => {
            const q = lookup.value.trim()
            if (!q || !lookupRes) { lookupRes?.classList.add('hidden'); return }
            const r = await fetch(`/api/xem-chung/lookup?q=${encodeURIComponent(q)}`, { credentials: 'same-origin' }).catch(() => null)
            if (!r) return
            const d = await r.json()
            const res = (d.results || []).slice(0, 6)
            if (!lookupRes) return
            if (!res.length) {
              lookupRes.innerHTML = '<p class="px-4 py-2 text-xs text-text-muted">Không tìm thấy phim.</p>'
              lookupRes.classList.remove('hidden')
              return
            }
            lookupRes.innerHTML = res.map((mv: any) => `
              <button type="button" class="xc-pick block w-full text-left px-3 py-2.5 hover:bg-white/5 transition-colors" data-slug="${escapeHTML(mv.slug)}" data-name="${escapeHTML(mv.name)}" data-thumb="${escapeHTML(mv.thumb || '')}">
                <span class="flex items-center gap-3">
                  ${mv.thumb ? `<img src="${escapeHTML(mv.thumb)}" alt="" loading="lazy" decoding="async" class="w-9 h-13 rounded-md object-cover shrink-0 bg-bg-card glass-frame" />` : '<span class="w-9 shrink-0"></span>'}
                  <span class="min-w-0">
                    <span class="block text-sm text-text-primary truncate">${escapeHTML(mv.name)}</span>
                    <span class="block text-[11px] text-text-muted">${mv.episodes.length} tập</span>
                  </span>
                </span>
              </button>
            `).join('')
            lookupRes.classList.remove('hidden')
            lookupRes.querySelectorAll<HTMLButtonElement>('.xc-pick').forEach((b) => {
              b.addEventListener('click', async () => {
                const mv = { slug: b.dataset.slug || '', name: b.dataset.name || '', thumb: b.dataset.thumb || '' }
                lookupRes.classList.add('hidden')
                lookup.value = mv.name
                selectedMovie = null
                // load episodes into picker
                const r = await fetch(`/api/episodes?slug=${encodeURIComponent(mv.slug)}`, { credentials: 'same-origin' }).catch(() => null)
                if (!r) return
                const d = await r.json()
                const episodes = d.status ? (d.episodes || []).flatMap((s: any) => s.list.map((e: any) => ({ name: e.name, slug: e.slug, embed: e.embed }))) : []
                pickEpisodes = episodes
                $('xc-host-error')?.classList.add('hidden')
                if (!episodes.length) {
                  $('xc-ep-picker')?.classList.add('hidden')
                  hostErr('Không lấy được tập phim.')
                  return
                }
                renderEpPicker(mv)
              })
            })
          }, 350)
        })
      }

      function renderEpPicker(mv: { slug: string; name: string; thumb: string }) {
        if (!epPicker || !epGrid) return
        const thumbEl = $('xc-pick-thumb') as HTMLImageElement | null
        const nameEl = $('xc-pick-name')
        const metaEl = $('xc-pick-meta')
        if (thumbEl) thumbEl.src = mv.thumb || '/logo.png'
        if (nameEl) nameEl.textContent = mv.name
        if (metaEl) metaEl.textContent = `${pickEpisodes.length} nguồn/tập`
        epGrid.innerHTML = pickEpisodes.map((ep, i) => `
          <button type="button" class="xc-ep-btn px-1.5 py-2 rounded-lg text-[11px] font-medium glass-tile text-text-secondary hover:text-white hover:bg-white/10 transition-colors truncate" data-index="${i}" title="${escapeHTML(ep.name)}">
            ${escapeHTML(ep.name)}
          </button>
        `).join('')
        epPicker.classList.remove('hidden')
        epGrid.querySelectorAll<HTMLButtonElement>('.xc-ep-btn').forEach((b) => {
          b.addEventListener('click', () => {
            const ep = pickEpisodes[Number(b.dataset.index || 0)]
            if (!ep) return
            selectedMovie = { slug: mv.slug, movieName: mv.name, episode: ep.slug, epName: ep.name, thumb: mv.thumb, embed: ep.embed }
            epGrid.querySelectorAll('.xc-ep-btn').forEach((x) => {
              x.classList.remove('bg-white/10', 'text-white')
            })
            b.classList.add('bg-white/10', 'text-white')
            $('xc-play-now')?.removeAttribute('disabled')
            $('xc-schedule')?.removeAttribute('disabled')
          })
        })
      }

      function hostErr(msg: string) {
        const el = $('xc-host-error')
        if (!el) return
        el.textContent = msg
        el.classList.remove('hidden')
      }

      async function startMovie(scheduleStart: number) {
        if (!selectedMovie) return hostErr('Chọn phim trước.')
        const r = await fetch(`/api/xem-chung/${code}/movie`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...selectedMovie, scheduleStart }),
        }).catch(() => null)
        if (!r) return hostErr('Lỗi kết nối server.')
        const d = await r.json()
        if (!d.ok) return hostErr(d.error || 'Thất bại.')
        $('xc-schedule-pick')?.classList.add('hidden')
        $('xc-ep-picker')?.classList.add('hidden')
        room = d.room
        renderAll()
      }

      $('xc-play-now')?.addEventListener('click', () => startMovie(nowMs() + 10_000))
      $('xc-schedule')?.addEventListener('click', () => $('xc-schedule-pick')?.classList.toggle('hidden'))
      $('xc-schedule-confirm')?.addEventListener('click', () => {
        const dt = ($('xc-schedule-dt') as HTMLInputElement | null)?.value
        if (!dt) return hostErr('Chọn thời gian chiếu.')
        const at = new Date(dt).getTime()
        if (at <= nowMs()) return hostErr('Thời gian phải ở tương lai.')
        startMovie(at)
      })
      $('xc-ready')?.addEventListener('click', async () => {
        const was = !!(room && (room.ready || {})[_userId])
        const r = await fetch(`/api/xem-chung/${code}/ready`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ready: !was }),
        }).catch(() => null)
        if (!r) return
        const d = await r.json()
        if (d.room) { room = d.room; renderAll() }
      })
      $('xc-resync')?.addEventListener('click', () => {
        const f = frameEl()
        if (!f) return
        const emb = room?.movie?.embed
        if (!emb) return
        if (f.dataset.src) {
          f.removeAttribute('src')
          f.dataset.src = ''
        }
        f.src = emb
        f.dataset.src = emb
        f.classList.remove('hidden')
      })
      $('xc-stop')?.addEventListener('click', async () => {
        const r = await fetch(`/api/xem-chung/${code}/end`, { method: 'POST', credentials: 'same-origin' }).catch(() => null)
        if (!r) return
        const d = await r.json()
        if (d.room) { room = d.room; renderAll() }
      })

      // chat
      $('xc-chat-form')?.addEventListener('submit', async (e) => {
        e.preventDefault()
        const inp = $('xc-chat-input') as HTMLInputElement | null
        if (!inp || !inp.value.trim()) return
        const text = inp.value
        inp.value = ''
        const r = await fetch(`/api/xem-chung/${code}/chat`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text }),
        }).catch(() => null)
        if (!r) return
        const d = await r.json()
        if (d.room) { room = d.room; renderChat() }
      })

      $('xc-share')?.addEventListener('click', () => {
        navigator.clipboard?.writeText(window.location.href).then(() => {
          const btn = $('xc-share')
          if (btn) { const o = btn.textContent; btn.textContent = 'Đã chép ✓'; window.setTimeout(() => { btn.textContent = o }, 1600) }
        }).catch(() => {})
      })

      void whoami()
      void syncClock()
      void refresh().then((ok) => { if (ok) renderAll() })
      window.setInterval(() => { void syncClock() }, 60_000)

      window.setInterval(() => { drawFrame(); tickClock() }, 250)
      window.setInterval(() => {
        void refresh().then((ok) => { if (ok) renderAll() })
      }, 3000)

      return () => {
        window.clearInterval(timer)
        window.clearTimeout(lookupTimer)
      }
    })
  </script>
</BaseLayout>