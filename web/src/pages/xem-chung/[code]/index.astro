---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ThemeBG from '../../../components/ThemeBG.astro'
import { getSessionUser } from '../../../lib/auth'
import { getRoom } from '../../../lib/rooms'
import { FaTv, FaCirclePlay, FaClock, FaStop, FaComment, FaSliders, FaLock, FaChevronLeft } from 'react-icons/fa6'

const code = (Astro.params.code || '').toUpperCase()

const user = await getSessionUser(Astro.cookies)
const room = await getRoom(code)

if (!room) {
  return Astro.redirect('/404', 404)
}

const isHost = !!user && user.sub === room.hostId
---

<BaseLayout title={`Xem Chung #${code}`} description="Phòng xem phim cùng nhau trên Nô Lệ Làm Phim." noIndex>
  <ThemeBG name="xem-chung" />
  <main class="px-4 sm:px-6 md:px-8 py-6 pb-14 lg:pb-12 space-y-4" data-room-page data-code={code} data-host={String(isHost)}>
    <div id="xc-login-overlay" class="hidden fixed inset-0 z-50 flex-col items-center justify-center gap-4 bg-cm-bg/80">
      <div class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-modal)] px-8 py-8 text-center max-w-sm mx-4">
        <div class="w-14 h-14 rounded-full bg-cm-surface border border-cm-border flex items-center justify-center mb-3 mx-auto text-cm-accent"><FaLock className="w-6 h-6" /></div>
        <h2 class="text-lg font-bold text-cm-text">Đăng nhập để xem cùng nhau</h2>
        <p class="text-cm-body text-cm-text-2 mt-2 mb-5">Bạn cần đăng nhập để tham gia phòng, chat và đồng bộ phim.</p>
        <button type="button" data-auth-open
          class="inline-flex items-center gap-2 h-12 px-6 rounded-[var(--radius-cm-btn)] text-cm-body font-bold bg-cm-accent text-white hover:bg-cm-accent-hover transition-colors duration-[var(--duration-cm)]">
          Đăng nhập
        </button>
        <a href="/xem-chung" class="flex items-center justify-center gap-1 mt-3 text-cm-meta text-cm-text-3 hover:text-cm-text transition-colors duration-[var(--duration-cm)]">
          <FaChevronLeft className="w-3 h-3" />
          Quay lại trang Xem Chung
        </a>
      </div>
    </div>
    <div id="xc-blocked-overlay" class="hidden fixed inset-0 z-50 flex-col items-center justify-center gap-4 bg-cm-bg/80">
      <div class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-modal)] px-8 py-8 text-center max-w-sm mx-4">
        <div class="w-14 h-14 rounded-full bg-cm-surface border border-cm-border flex items-center justify-center mb-3 mx-auto text-cm-accent"><FaLock className="w-6 h-6" /></div>
        <h2 class="text-lg font-bold text-cm-text">Buổi công chiếu đã bắt đầu</h2>
        <p class="text-cm-body text-cm-text-2 mt-2 mb-2">Suất này đã lên sóng — ai vào muộn không xem ghé được giữa chừng.</p>
        <p id="xc-blocked-info" class="text-cm-meta text-cm-text-3 mb-5"></p>
        <a href="/xem-chung"
          class="inline-flex items-center gap-2 h-12 px-6 rounded-[var(--radius-cm-btn)] text-cm-body font-bold bg-cm-accent text-white hover:bg-cm-accent-hover transition-colors duration-[var(--duration-cm)]">
          <FaTv className="w-5 h-5" />
          Đến buổi công chiếu khác
        </a>
        <a href="/xem-chung" class="flex items-center justify-center gap-1 mt-3 text-cm-meta text-cm-text-3 hover:text-cm-text transition-colors duration-[var(--duration-cm)]">
          <FaChevronLeft className="w-3 h-3" />
          Quay lại trang Xem Chung
        </a>
      </div>
    </div>
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border flex items-center justify-center text-cm-accent"><FaTv className="w-5 h-5" /></div>
        <div>
          <h1 class="text-lg font-bold text-cm-text">Phòng <span class="font-mono tracking-widest text-cm-accent">#{code}</span></h1>
          <p id="xc-status" class="text-cm-meta text-cm-text-3">Đang tải...</p>
          <p id="xc-guest-note" class="hidden mt-1.5 text-[11px] text-cm-accent"></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="xc-share" type="button" class="h-10 px-4 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-cm-meta font-medium text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]">
          Sao chép link mời
        </button>
        <a href="/xem-chung" class="h-10 px-4 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-cm-meta font-medium text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]">Thoát</a>
      </div>
    </div>

    <div class="grid lg:grid-cols-[1fr_340px] gap-4 items-start">
      <div class="space-y-4 min-w-0">
        <!-- Player -->
        <div class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] p-2 md:p-3">
          <div id="player-stage" class="aspect-video w-full relative rounded-[var(--radius-cm-card)] overflow-hidden bg-black">
            <div id="xc-now-playing" class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-4 p-6 text-center">
              <div class="w-16 h-16 rounded-full bg-cm-surface border border-cm-border flex items-center justify-center text-cm-accent">
                <FaCirclePlay className="w-7 h-7" />
              </div>
              <p id="xc-no-movie-text" class="text-cm-body text-cm-text-2">Chưa có suất chiếu nào trong phòng này.</p>
              <p class="text-cm-meta text-cm-text-3">Admin sẽ công chiếu phim theo lịch — mọi người vào phòng trước giờ chiếu.</p>
            </div>
            <iframe id="xc-frame" title="Phát phim" class="hidden absolute inset-0 w-full h-full border-0" allow="autoplay; fullscreen; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            <div id="xc-countdown" class="hidden absolute inset-0 z-20 flex-col items-center justify-center bg-[#08081a]/90">
              <div class="relative flex items-center justify-center w-40 h-40 md:w-48 md:h-48">
                <svg class="xc-countdown-ring absolute inset-0 w-full h-full -rotate-90 text-cm-accent" viewBox="0 0 100 100">
                  <circle cx="50" cy="50" r="46" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="4" />
                  <circle id="xc-countdown-ring-bar" cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-dasharray="289" stroke-dashoffset="0" />
                </svg>
                <span id="xc-countdown-num" class="text-6xl md:text-7xl font-black text-white tracking-tight leading-none">10</span>
              </div>
              <p class="text-cm-body md:text-base font-semibold text-white mt-4">Sắp công chiếu...</p>
              <p class="text-[11px] text-cm-text-3 mt-1">Phim sẽ tự động phát đồng bộ khi tới giờ</p>
            </div>
            <div id="xc-buffering" class="hidden absolute inset-0 z-30 items-center justify-center bg-black/60">
              <div class="w-8 h-8 rounded-full border-2 border-white/20 border-t-cm-accent animate-spin"></div>
            </div>
            <div id="xc-sync-badge" class="hidden absolute top-3 left-3 z-40 px-2.5 py-1 rounded-full bg-black/65 border border-white/15 text-[11px] font-medium text-white"></div>
          </div>
        </div>

        <!-- Now playing info -->
        <div id="xc-movie-info" class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] px-5 py-4 hidden">
          <div class="flex items-center gap-3">
            <img id="xc-thumb" alt="" class="w-16 h-[4.5rem] rounded-[var(--radius-cm-btn)] object-cover shrink-0 border border-cm-border" />
            <div class="min-w-0">
              <h2 id="xc-movie-name" class="font-bold text-cm-text text-cm-body truncate"></h2>
              <p id="xc-ep-name" class="text-cm-meta text-cm-text-3"></p>
              <p id="xc-clock" class="text-cm-meta text-cm-text-2 font-mono mt-1"></p>
            </div>
            <div class="ml-auto shrink-0">
              <button id="xc-resync" type="button" class="inline-flex items-center gap-1.5 h-10 px-3 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-cm-meta font-medium text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-all duration-[var(--duration-cm)] disabled:opacity-40" disabled><FaTv className="w-3.5 h-3.5" /> Tái đồng bộ</button>
            </div>
          </div>
        </div>

        <!-- Host controls -->
        <div id="xc-host-panel" class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] px-5 py-4 space-y-3 hidden">
          <h3 class="text-cm-body font-bold text-cm-text flex items-center gap-2"><FaSliders className="w-3.5 h-3.5 text-cm-accent" /> Host</h3>
          <div>
            <input
              id="xc-lookup"
              type="text"
              placeholder="Gõ tên phim để chọn..."
              autocomplete="off"
              class="w-full px-4 h-11 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-body text-cm-text placeholder:text-cm-text-3 focus:outline-none focus:border-cm-accent/60 transition-colors duration-[var(--duration-cm)]"
            />
            <div id="xc-lookup-res" class="hidden mt-2 w-full max-h-72 overflow-y-auto rounded-[var(--radius-cm-card)] bg-cm-elevated border border-cm-border shadow-[var(--shadow-cm-up)]"></div>
          </div>
          <div id="xc-ep-picker" class="hidden space-y-3">
            <div class="flex items-center gap-3 p-3 rounded-[var(--radius-cm-card)] bg-cm-surface border border-cm-border">
              <img id="xc-pick-thumb" alt="" class="w-16 h-[4.5rem] rounded-[var(--radius-cm-btn)] object-cover shrink-0" />
              <div class="min-w-0">
                <p id="xc-pick-name" class="text-cm-body font-bold text-cm-text truncate"></p>
                <p id="xc-pick-meta" class="text-[11px] text-cm-text-3"></p>
              </div>
            </div>
            <div>
              <p class="text-[11px] font-semibold text-cm-text-3 uppercase tracking-wide mb-1.5 px-1">Chọn tập</p>
              <div id="xc-ep-grid" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-1.5 max-h-48 overflow-y-auto p-1"></div>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <button id="xc-play-now" type="button" class="inline-flex items-center gap-1.5 h-11 px-4 rounded-[var(--radius-cm-btn)] text-cm-meta font-bold bg-cm-accent text-white hover:bg-cm-accent-hover disabled:opacity-40 transition-all duration-[var(--duration-cm)]" disabled><FaCirclePlay className="w-3.5 h-3.5" /> Phát ngay (10s)</button>
            <button id="xc-schedule" type="button" class="inline-flex items-center gap-1.5 h-11 px-4 rounded-[var(--radius-cm-btn)] text-cm-meta font-bold border border-cm-border bg-cm-surface text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong disabled:opacity-40 transition-all duration-[var(--duration-cm)]" disabled><FaClock className="w-3.5 h-3.5" /> Đặt giờ chiếu</button>
            <button id="xc-stop" type="button" class="inline-flex items-center gap-1.5 h-11 px-4 rounded-[var(--radius-cm-btn)] text-cm-meta font-bold border border-cm-border bg-cm-surface text-cm-text-3 hover:text-cm-text hover:border-cm-border-strong disabled:opacity-40 transition-all duration-[var(--duration-cm)]"><FaStop className="w-3 h-3" /> Kết thúc</button>
          </div>
          <div id="xc-schedule-pick" class="hidden flex items-center gap-2">
            <input id="xc-schedule-dt" type="datetime-local" class="h-11 px-3 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-meta text-cm-text flex-1 min-w-0 focus:border-cm-accent/60" />
            <button id="xc-schedule-confirm" type="button" class="h-11 px-4 rounded-[var(--radius-cm-btn)] text-cm-meta font-bold bg-cm-accent text-white hover:bg-cm-accent-hover transition-all duration-[var(--duration-cm)]">Đặt</button>
          </div>
          <p id="xc-host-error" class="hidden text-cm-meta text-red-400"></p>
        </div>
      </div>

      <!-- Chat column -->
      <div class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] flex flex-col min-h-[30rem] lg:min-h-0 lg:h-[calc(100vh-12rem)]">
        <div class="flex items-center justify-between px-5 py-3 border-b border-cm-border">
          <h3 class="text-cm-body font-bold text-cm-text flex items-center gap-2"><FaComment className="w-3.5 h-3.5 text-cm-accent" /> Chat</h3>
          <span id="xc-members-pop" class="text-cm-meta text-cm-text-3"></span>
        </div>
        <div id="xc-login-gate" class="hidden flex-1 flex flex-col items-center justify-center gap-3 p-6 text-center">
          <p class="text-cm-body text-cm-text-2">Đăng nhập để tham gia chat và xem.</p>
          <button type="button" data-auth-open
            class="inline-flex items-center gap-2 h-11 px-5 rounded-[var(--radius-cm-btn)] text-cm-body font-bold bg-cm-accent text-white hover:bg-cm-accent-hover transition-colors duration-[var(--duration-cm)]">
            Đăng nhập
          </button>
        </div>
        <div id="xc-chat" class="flex-1 overflow-y-auto px-4 py-3 space-y-2 min-h-[18rem]"></div>
        <form id="xc-chat-form" class="flex gap-2 p-3 border-t border-cm-border">
          <input id="xc-chat-input" type="text" maxlength="500" placeholder="Nhắn gì đó..." autocomplete="off"
            class="flex-1 min-w-0 h-10 px-3 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-body text-cm-text placeholder:text-cm-text-3 focus:outline-none focus:border-cm-accent/60 transition-colors duration-[var(--duration-cm)]" />
          <button type="submit" class="h-10 px-4 rounded-[var(--radius-cm-btn)] text-cm-meta font-bold bg-cm-accent text-white hover:bg-cm-accent-hover transition-all duration-[var(--duration-cm)]">Gửi</button>
        </form>
      </div>
    </div>
  </main>

  <script>
    import { registerPageInit } from '../../../scripts/lifecycle'
    import { getMe } from '../../../scripts/session'

    interface Member { id: string; username: string; global_name?: string | null; avatar?: string | null }
    interface ChatMsg { id: string; userId: string; username: string; avatar?: string | null; text: string; ts: number }
    interface Movie { slug: string; movieName: string; epName: string; episode: string; thumb: string; embed: string; m3u8?: string; hash?: string; host?: string; frameDur?: number; frameCount?: number; frameUrl?: string }
    interface RoomSync { playing: boolean; time: number; at: number; rate: number; seq: number; by: string }
    interface Room {
      code: string; status: string; hostId: string; members: Member[];
      movie: Movie | null; startTime: number; endedAt: number;
      chat: ChatMsg[]; muted: Record<string, boolean>; banned: Record<string, boolean>;
      ready: Record<string, boolean>; sync?: RoomSync;
    }

    function escapeHTML(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string)
    }

    function avatarUrl(id: string, avatar?: string | null): string {
      return avatar ? `https://cdn.discordapp.com/avatars/${id}/${avatar}.png?size=64` : '/logo-64.png'
    }

    const ICON_MUTE =
      '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5zM15.5 12a3.5 3.5 0 0 0-2-3.15v6.3a3.5 3.5 0 0 0 2-3.15zM13.5 2v2.06a7 7 0 0 1 4.5 6.44 7 7 0 0 1-4.5 6.44V19a9 9 0 0 0 6-8.5A9 9 0 0 0 13.5 2z"/></svg>'
    const ICON_BAN =
      '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 0 1 6.32 12.9L5.1 7.68A8 8 0 0 1 12 4zM4 12a8 8 0 0 1 1.68-4.9l12.22 12.22A8 8 0 0 1 4 12z"/></svg>'

    // ── Guest: danh tính xem ké được tạo 1 lần + cache localStorage ──
    const GUEST_KEY = 'nllp_guest'
    function loadGuest(): { id: string; name: string } {
      try {
        const raw = localStorage.getItem(GUEST_KEY)
        if (raw) {
          const g = JSON.parse(raw)
          if (g && /^[a-zA-Z0-9]{12,32}$/.test(g.id) && g.name) return g
        }
      } catch {}
      const id = Array.from(crypto.getRandomValues(new Uint8Array(8)), (b) => b.toString(16).padStart(2, '0')).join('')
      const name = 'Khách-' + Math.floor(1000 + Math.random() * 9000)
      const g = { id, name }
      try { localStorage.setItem(GUEST_KEY, JSON.stringify(g)) } catch {}
      return g
    }
    const guest = loadGuest()
    const guestHeaders = (): Record<string, string> => ({
      'x-guest-id': guest.id,
      'x-guest-name': guest.name,
    })

    registerPageInit(() => {
      const page = document.querySelector<HTMLElement>('[data-room-page]')
      if (!page) return () => {}
      const code = page.dataset.code || ''

      let room: Room | null = null
      let isHost = page.dataset.host === 'true'
      let _userId = ''
      let selectedMovie: { slug: string; movieName: string; episode: string; epName: string; thumb: string; embed: string; m3u8?: string } | null = null

      const $ = (id: string) => document.getElementById(id)

      // ── NTP: đo chênh lệch đồng hồ server ~ client ──
      let clockOffset = 0
      let cdWindowStart = 0
      let cdWindowTarget = 0
      async function syncClock(): Promise<void> {
        try {
          const t0 = Date.now()
          const r = await fetch('/api/xem-chung/time', { cache: 'no-store' }).catch(() => null)
          const t1 = Date.now()
          if (!r) return
          const d = await r.json()
          if (d && typeof d.ts === 'number') {
            clockOffset = d.ts - (t0 + t1) / 2
          }
        } catch {
          /* giữ offset cũ */
        }
      }
      const nowMs = () => Date.now() + clockOffset

      function statusText(): string {
        if (!room) return 'Đang tải...'
        const n = room.members.length
        if (room.status === 'ended') return 'Buổi công chiếu đã kết thúc'
        if (room.status === 'playing') return `Đang công chiếu • ${n} người`
        if (room.status === 'scheduled' && room.movie) {
          const remain = Math.max(0, Math.round((room.startTime - nowMs()) / 1000))
          return `Công chiếu lúc ${new Date(room.startTime).toLocaleString('vi-VN', { weekday: 'short', hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' })} • còn ${remain}s • ${n} người`
        }
        return room.movie ? `Đã chọn phim • ${n} người` : `Chưa có suất chiếu • ${n} người`
      }

      function fmtClock(ms: number): string {
        const s = Math.floor(ms / 1000)
        const d = Math.floor((ms % 1000) / 100)
        const pad = (x: number) => String(x).padStart(2, '0')
        return `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}.${d}`
      }

      async function whoami() {
        let discordUser = false
        try {
          const { user } = await getMe()
          _userId = user?.id || ''
          discordUser = !!_userId
        } catch { _userId = '' }
        // Guest: coi như "đã xác minh người xem" để mở chat/xem, nhưng KHÔNG phải host.
        if (!discordUser) _userId = 'nllp-guest:' + guest.id
        const overlay = $('xc-login-overlay')
        if (overlay) overlay.classList.add('hidden')
        const gate = $('xc-login-gate')
        const chatBox = $('xc-chat')
        const chatFormEl = $('xc-chat-form')
        const hostPanelEl = $('xc-host-panel')
        const guestNote = $('xc-guest-note')
        if (gate) gate.classList.add('hidden')
        if (chatBox) chatBox.classList.remove('hidden')
        if (chatFormEl) chatFormEl.classList.remove('hidden')
        if (hostPanelEl) hostPanelEl.classList.add('hidden')
        if (guestNote) {
          if (discordUser) guestNote.classList.add('hidden')
          else guestNote.innerHTML = `Đang xem với tư cách <b>${escapeHTML(guest.name)}</b> — chỉ admin mới được host phòng.`
        }
      }

      async function refresh(): Promise<boolean> {
        try {
          const r = await fetch(`/api/xem-chung/${code}`, { credentials: 'same-origin' })
          const d = await r.json()
          if (!d.ok) { window.location.href = '/xem-chung'; return false }
          room = d.room
          isHost = !!d.isHost
          $('xc-host-panel')?.classList.toggle('hidden', !isHost)
          return true
        } catch { return false }
      }

      function renderAll() {
        const st = $('xc-status')
        if (st) st.textContent = statusText()
        const members = $('xc-members-pop')
        if (members && room) members.textContent = room.members.map((m) => m.global_name || m.username).join(', ') || '—'
        const movie = room?.movie
        const info = $('xc-movie-info')
        const nowPlaying = $('xc-now-playing')
        const noText = $('xc-no-movie-text')
        const frame = $('xc-frame') as HTMLImageElement | null
        if (!movie) {
          if (nowPlaying) nowPlaying.classList.remove('hidden')
          if (noText) noText.textContent = 'Chưa có phim nào được phát trong phòng này.'
          if (info) info.classList.add('hidden')
          if (frame) frame.classList.add('hidden')
          $('xc-countdown')?.classList.add('hidden')
          return
        }
        if (info) info.classList.remove('hidden')
        if (noText) noText.textContent = 'Đang chờ giờ công chiếu theo lịch của admin.'
        const th = $('xc-thumb') as HTMLImageElement | null
        if (th && movie.thumb) th.src = movie.thumb
        const mn = $('xc-movie-name')
        if (mn) mn.textContent = movie.movieName
        const en = $('xc-ep-name')
        if (en) en.textContent = `${movie.epName} • ${movie.movieName}`
        // Preset từ trang phim: phim đã chọn sẵn (chưa phát), host chỉ bấm Phát/Đặt giờ
        if (room && isHost && room.status === 'open' && room.movie && !selectedMovie) {
          const m = room.movie
          const preset: { slug: string; movieName: string; episode: string; epName: string; thumb: string; embed: string; m3u8?: string } = {
            slug: m.slug,
            movieName: m.movieName,
            episode: m.episode,
            epName: m.epName,
            thumb: m.thumb,
            embed: m.embed,
            m3u8: m.m3u8,
          }
          selectedMovie = preset
          pickEpisodes = [{ name: preset.epName, slug: preset.episode, embed: preset.embed, m3u8: preset.m3u8 }]
          renderEpPicker({ slug: preset.slug, name: preset.movieName, thumb: preset.thumb })
          const first = epGrid?.querySelector<HTMLButtonElement>('.xc-ep-btn[data-index="0"]')
          first?.classList.add('bg-cm-elevated', 'text-cm-text', 'border-cm-border-strong')
          $('xc-play-now')?.removeAttribute('disabled')
          $('xc-schedule')?.removeAttribute('disabled')
        }
        const resync = $('xc-resync') as HTMLButtonElement | null
        if (resync && room) resync.disabled = room.status !== 'playing'
        renderChat()
      }

      function renderChat() {
        const box = $('xc-chat')
        if (!box || !room) return
        box.innerHTML = room.chat.map((m) => `
          <div class="flex items-start gap-2">
            <img src="${avatarUrl(m.userId, m.avatar)}" alt="" class="w-6 h-6 rounded-full shrink-0" loading="lazy" />
            <div class="min-w-0">
              <div class="flex items-baseline gap-2">
                <span class="text-[11px] font-bold ${m.userId === room?.hostId ? 'text-cm-accent' : 'text-cm-text-2'}">${escapeHTML(m.username)}${m.userId === room?.hostId ? ' • host' : ''}</span>
                <span class="text-[10px] text-cm-text-3">${new Date(m.ts).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</span>
                ${isHost && m.userId !== room?.hostId ? `
                  <button class="xc-mute text-[10px] px-1.5 py-0.5 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-cm-text-3 hover:text-cm-text hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]" data-id="${m.userId}" title="Tắt tiếng">${ICON_MUTE}</button>
                  <button class="xc-ban text-[10px] px-1.5 py-0.5 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-cm-text-3 hover:text-red-400 hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]" data-id="${m.userId}" title="Cấm">${ICON_BAN}</button>
                ` : ''}
              </div>
              <p class="text-cm-body text-cm-text break-words">${escapeHTML(m.text)}</p>
            </div>
          </div>
        `).join('')
        box.scrollTop = box.scrollHeight
        box.querySelectorAll<HTMLButtonElement>('.xc-mute').forEach((b) => b.addEventListener('click', () => mod(b.dataset.id || '', 'mute')))
        box.querySelectorAll<HTMLButtonElement>('.xc-ban').forEach((b) => b.addEventListener('click', () => mod(b.dataset.id || '', 'ban')))
      }

      async function mod(targetId: string, action: 'mute' | 'ban') {
        const r = await fetch(`/api/xem-chung/${code}/mod`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: targetId, action }),
        }).catch(() => null)
        if (!r) return
        const d = await r.json()
        if (d.room) { room = d.room; renderAll() }
      }

      // ── Clock player (iframe embed) ──
      let timer = 0

      const frameEl = () => $('xc-frame') as HTMLIFrameElement | null
      const buffering = () => $('xc-buffering')

      function playingNow(): boolean {
        if (!room || !room.movie || room.status === 'ended' || room.status === 'open') return false
        if (room.startTime <= 0) return false
        return room.startTime <= nowMs()
      }

      // ── Player m3u8 (<video> + hls.js) — điều kiện để sync thật ──
      type HlsLike = {
        destroy(): void
        loadSource(url: string): void
        attachMedia(el: HTMLMediaElement): void
        /** -1 = Auto; >=0 = ép cứng level tương ứng. */
        currentLevel: number
        on(event: string, cb: (evt: unknown, data: { fatal?: boolean }) => void): void
      }
      let videoEl: HTMLVideoElement | null = null
      let hls: HlsLike | null = null
      let playerMode: 'none' | 'iframe' | 'video' = 'none'
      let m3u8Failed = ''
      let hostSeq = 0
      let hlsLevels: Array<{ index: number; height?: number; name: string }> = []
      let currentLevel = -1
      let qualityWrap: HTMLDivElement | null = null

      function destroyVideo(): void {
        if (hls) { try { hls.destroy() } catch { /* ignore */ } hls = null }
        if (videoEl) {
          try { videoEl.pause(); videoEl.removeAttribute('src'); videoEl.load() } catch { /* ignore */ }
          videoEl.remove()
          videoEl = null
        }
        if (qualityWrap) {
          qualityWrap.remove()
          qualityWrap = null
        }
        hlsLevels = []
        currentLevel = -1
        playerMode = 'none'
      }

      function renderQualityUI(): void {
        if (!isHost || !hls || !videoEl) return
        if (qualityWrap) {
          qualityWrap.remove()
          qualityWrap = null
        }
        if (hlsLevels.length === 0) return
        const stageEl = $('player-stage')
        if (!stageEl) return
        const wrap = document.createElement('div')
        wrap.className = 'absolute top-12 right-3 z-40 hidden sm:block'
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'px-2.5 py-1 rounded-full bg-black/60 border border-white/15 text-[11px] font-medium text-white hover:bg-black/70 transition-colors'
        const update = () => {
          const cur = hlsLevels.find((l) => l.index === currentLevel)
          btn.textContent = cur ? `Chất lượng: ${cur.name}` : 'Chất lượng: Tự động'
        }
        update()
        const menu = document.createElement('div')
        menu.className = 'absolute right-0 mt-1 min-w-[140px] rounded-[var(--radius-cm-card)] bg-cm-surface/95 border border-cm-border shadow-xl hidden flex-col overflow-hidden'
        const add = (label: string, level: number) => {
          const it = document.createElement('button')
          it.type = 'button'
          it.className = 'px-2.5 py-1.5 text-left text-[11px] hover:bg-cm-elevated text-cm-text'
          it.textContent = label
          it.addEventListener('click', () => {
            currentLevel = level
            ;(hls as any).currentLevel = level
            menu.classList.add('hidden')
            update()
          })
          menu.appendChild(it)
        }
        add('Tự động', -1)
        for (const l of [...hlsLevels].sort((a,b)=>(b.height||0)-(a.height||0))) {
          add(l.name, l.index)
        }
        btn.addEventListener('click', (e) => {
          e.stopPropagation()
          menu.classList.toggle('hidden')
        })
        document.addEventListener('click', (e) => {
          if (!wrap.contains(e.target as Node)) menu.classList.add('hidden')
        }, { once: true })
        wrap.appendChild(btn)
        wrap.appendChild(menu)
        qualityWrap = wrap
        stageEl.appendChild(wrap)
      }

      function updateQualityUI(): void {
        if (!qualityWrap) return
        const btn = qualityWrap.querySelector('button') as HTMLButtonElement | null
        if (btn) {
          const cur = hlsLevels.find((l) => l.index === currentLevel)
          btn.textContent = cur ? `Chất lượng: ${cur.name}` : 'Chất lượng: Tự động'
        }
      }

      async function playNextEpisode(): Promise<void> {
        if (!isHost || !room?.movie) return
        const slug = room.movie.slug
        let episodes: Array<{ name: string; slug: string; embed: string; m3u8?: string }> = []
        try {
          const r = await fetch(`/api/episodes?slug=${encodeURIComponent(slug)}`, { credentials: 'same-origin' })
          if (r.ok) {
            const d = await r.json()
            episodes = (d.episodes || []).flatMap((s: any) => (s.list || []).map((e: any) => ({ name: e.name, slug: e.slug, embed: e.embed, m3u8: e.m3u8 })))
          }
        } catch {}
        if (!episodes.length) return
        const cur = room.movie.episode
        const idx = episodes.findIndex((e) => e.slug === cur)
        const next = idx >= 0 && idx < episodes.length - 1 ? episodes[idx + 1] : null
        if (!next) return
        try {
          await fetch(`/api/xem-chung/${code}/movie`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              slug: room.movie.slug,
              movieName: room.movie.movieName,
              episode: next.slug,
              epName: next.name,
              thumb: room.movie.thumb,
              embed: next.embed,
              m3u8: next.m3u8,
              scheduleStart: Date.now() + 2000,
            }),
          })
        } catch {}
      }

      function onVideoFatal(m3: string): void {
        m3u8Failed = m3
        destroyVideo()
      }

      async function ensureVideo(m3u8: string): Promise<void> {
        if (playerMode === 'video' && videoEl && videoEl.dataset.src === m3u8) return
        destroyVideo()
        const stage = $('player-stage')
        if (!stage) return
        const v = document.createElement('video')
        v.id = 'xc-video'
        v.className = 'absolute inset-0 w-full h-full bg-black'
        v.setAttribute('playsinline', '')
        v.autoplay = true
        v.preload = 'auto'
        v.controls = isHost
        v.dataset.src = m3u8
        videoEl = v
        playerMode = 'video'
        stage.appendChild(v)
        if (isHost) {
          const bump = () => { hostSeq++; void pushSync() }
          v.addEventListener('play', bump)
          v.addEventListener('pause', bump)
          v.addEventListener('seeked', bump)
          v.addEventListener('ratechange', bump)
          v.addEventListener('ended', () => {
            void playNextEpisode()
          }, { once: true })
        }
        const buf = buffering()
        if (buf) { buf.classList.remove('hidden'); buf.classList.add('flex') }
        v.addEventListener('playing', () => { if (buf) { buf.classList.add('hidden'); buf.classList.remove('flex') } })
        try {
          const mod = await import('hls.js')
          const Hls = mod.default
          if (Hls.isSupported()) {
            const inst = new Hls({ enableWorker: true }) as unknown as HlsLike
            hls = inst
            inst.loadSource(m3u8)
            inst.attachMedia(v)
            inst.on(Hls.Events.ERROR, (_e: unknown, data: { fatal?: boolean }) => {
              if (data?.fatal && videoEl === v) { console.warn('[room] hls fatal → embed'); onVideoFatal(m3u8) }
            })
            inst.on(Hls.Events.LEVELS_UPDATED, (_evt: unknown, data: any) => {
              const levels = (data.levels || []) as any[]
              hlsLevels = levels.map((l, idx) => ({ index: idx, height: l.height, name: l.height ? `${l.height}p` : `Level ${idx + 1}` }))
              renderQualityUI()
            })
            inst.on(Hls.Events.LEVEL_SWITCHED, (_evt: unknown, data: any) => {
              currentLevel = (data as any).level ?? inst.currentLevel ?? -1
              updateQualityUI()
            })
            void v.play().catch(() => {})
            return
          }
        } catch (err) {
          console.warn('[room] hls.js load failed', err)
        }
        if (v.canPlayType('application/vnd.apple.mpegurl')) {
          v.addEventListener('error', () => { if (videoEl === v) onVideoFatal(m3u8) })
          v.src = m3u8
          void v.play().catch(() => {})
          return
        }
        onVideoFatal(m3u8)
      }

      // ── Sync: host là nguồn thời gian, member bám theo ──
      async function pushSync(): Promise<void> {
        if (!isHost || !videoEl) return
        try {
          await fetch(`/api/xem-chung/${code}/sync`, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              playing: !videoEl.paused && !videoEl.ended,
              time: Number.isFinite(videoEl.currentTime) ? videoEl.currentTime : 0,
              rate: videoEl.playbackRate || 1,
              seq: hostSeq,
            }),
          })
        } catch { /* ignore */ }
      }

      function renderSyncBadge(): void {
        const el = $('xc-sync-badge')
        if (!el) return
        if (playerMode !== 'video') { el.classList.add('hidden'); return }
        el.classList.remove('hidden')
        el.textContent = isHost ? '● Phát cho phòng' : '◈ Bám host'
      }

      /** Member: kéo currentTime/play-pause về khớp host. */
      function applyFollow(): void {
        if (isHost || !videoEl || !room?.sync) return
        const s = room.sync
        const elapsed = s.playing ? (Date.now() - s.at) / 1000 * (s.rate || 1) : 0
        let expected = Math.max(0, s.time + elapsed)
        const dur = videoEl.duration
        if (Number.isFinite(dur) && dur > 1) expected = Math.min(expected, dur - 1)
        if (Math.abs(videoEl.currentTime - expected) > 0.6) {
          try { videoEl.currentTime = expected } catch { /* ignore */ }
        }
        if (s.playing && videoEl.paused) void videoEl.play().catch(() => {})
        if (!s.playing && !videoEl.paused) videoEl.pause()
      }

      async function pollSyncLoop(): Promise<void> {
        if (isHost || playerMode !== 'video') return
        try {
          const r = await fetch(`/api/xem-chung/${code}/sync`, { credentials: 'same-origin' })
          const d = await r.json()
          if (d?.ok && room) { room.sync = d.sync ?? undefined; applyFollow() }
        } catch { /* ignore */ }
      }

      function drawFrame() {
        const f = frameEl()
        const nowPlaying = $('xc-now-playing')
        const cd = $('xc-countdown')
        const upcoming = !!room?.movie && room.status === 'scheduled' && room.startTime > nowMs()
        if (!playingNow() && !upcoming) {
          // Phim đã chọn nhưng chưa tới giờ (scheduled) — chỉ ẩn, GIỮ iframe src
          // để không phải load lại từ đầu (tránh lệch đồng hồ làm reset phim).
          const keepAlive = !!room?.movie && (room.status === 'scheduled' || room.status === 'playing')
          if (f) {
            f.classList.add('hidden')
            if (!keepAlive && f.src) f.removeAttribute('src')
          }
          if (nowPlaying) nowPlaying.classList.remove('hidden')
          if (cd) { cd.classList.add('hidden'); cd.classList.remove('flex'); cd.classList.remove('flex-col'); }
          const buf = buffering()
          if (buf) { buf.classList.add('hidden'); buf.classList.remove('flex'); }
          return
        }
        // countdown display (scheduled, chưa tới giờ)
        if (upcoming) {
          if (!room) return
          const remain = Math.max(0, Math.ceil((room.startTime - nowMs()) / 1000))
          const num = $('xc-countdown-num')
          if (num) num.textContent = String(remain)
          // Ring tỉ lệ: bắt đầu từ 100% và rút dần về 0 khi tới giờ chiếu
          if (cdWindowTarget !== room.startTime) {
            cdWindowTarget = room.startTime
            cdWindowStart = nowMs()
          }
          const total = Math.max(1, cdWindowTarget - cdWindowStart)
          const elapsed = Math.max(0, nowMs() - cdWindowStart)
          const frac = Math.min(1, elapsed / total)
          const ringBar = $('xc-countdown-ring-bar') as unknown as SVGCircleElement | null
          if (ringBar) ringBar.style.strokeDashoffset = String(Math.round(289 * (1 - frac)))
          if (cd) { cd.classList.remove('hidden'); cd.classList.add('flex'); cd.classList.add('flex-col'); }
          if (nowPlaying) nowPlaying.classList.add('hidden')
          if (f) f.classList.add('hidden')
          return
        }
        if (cd) { cd.classList.add('hidden'); cd.classList.remove('flex'); }
        if (nowPlaying) nowPlaying.classList.add('hidden')
        if (room && room.movie && room.movie.m3u8 && room.movie.m3u8 !== m3u8Failed) {
          if (f) f.classList.add('hidden')
          void ensureVideo(room.movie.m3u8)
          return
        }
        if (videoEl) destroyVideo()
        if (!room || !room.movie || !f) return
        const emb = room.movie.embed
        if (!emb) return
        if (f.dataset.src === emb) return
        f.dataset.src = emb
        const buf = buffering()
        if (buf) { buf.classList.remove('hidden'); buf.classList.add('flex'); }
        f.src = emb
        f.onload = () => {
          if (buf) { buf.classList.add('hidden'); buf.classList.remove('flex'); }
        }
        f.classList.remove('hidden')
      }

      function tickClock() {
        if (playingNow() && room?.movie) {
          const cl = $('xc-clock')
          if (cl) cl.textContent = fmtClock(nowMs() - room.startTime)
        }
        // Cập nhật đếm ngược "còn Xs" trên trạng thái phòng mượt theo từng tick
        if (room && room.status === 'scheduled' && room.movie) {
          const stEl = $('xc-status')
          if (stEl) stEl.textContent = statusText()
        }
      }

      // ── Host: lookup movie ──
      const lookup = $('xc-lookup') as HTMLInputElement | null
      const lookupRes = $('xc-lookup-res')
      let lookupTimer = 0
      let pickEpisodes: { name: string; slug: string; embed: string; m3u8?: string }[] = []
      const epPicker = $('xc-ep-picker')
      const epGrid = $('xc-ep-grid')
      if (lookup) {
        lookup.addEventListener('input', () => {
          window.clearTimeout(lookupTimer)
          lookupTimer = window.setTimeout(async () => {
            const q = lookup.value.trim()
            if (!q || !lookupRes) { lookupRes?.classList.add('hidden'); return }
            const r = await fetch(`/api/xem-chung/lookup?q=${encodeURIComponent(q)}`, { credentials: 'same-origin' }).catch(() => null)
            if (!r) return
            const d = await r.json()
            const res = (d.results || []).slice(0, 6)
            if (!lookupRes) return
            if (!res.length) {
              lookupRes.innerHTML = '<p class="px-4 py-2 text-cm-meta text-cm-text-3">Không tìm thấy phim.</p>'
              lookupRes.classList.remove('hidden')
              return
            }
            lookupRes.innerHTML = res.map((mv: any) => `
              <button type="button" class="xc-pick block w-full text-left px-3 py-2.5 hover:bg-cm-surface transition-colors duration-[var(--duration-cm)]" data-slug="${escapeHTML(mv.slug)}" data-name="${escapeHTML(mv.name)}" data-thumb="${escapeHTML(mv.thumb || '')}">
                <span class="flex items-center gap-3">
                  ${mv.thumb ? `<img src="${escapeHTML(mv.thumb)}" alt="" loading="lazy" decoding="async" class="w-9 h-13 rounded-[var(--radius-cm-btn)] object-cover shrink-0 bg-cm-bg-2 border border-cm-border" />` : '<span class="w-9 shrink-0"></span>'}
                  <span class="min-w-0">
                    <span class="block text-cm-body text-cm-text truncate">${escapeHTML(mv.name)}</span>
                    <span class="block text-[11px] text-cm-text-3">${mv.episodes.length} tập</span>
                  </span>
                </span>
              </button>
            `).join('')
            lookupRes.classList.remove('hidden')
            lookupRes.querySelectorAll<HTMLButtonElement>('.xc-pick').forEach((b) => {
              b.addEventListener('click', async () => {
                const mv = { slug: b.dataset.slug || '', name: b.dataset.name || '', thumb: b.dataset.thumb || '' }
                lookupRes.classList.add('hidden')
                lookup.value = mv.name
                selectedMovie = null
                // load episodes into picker
                const r = await fetch(`/api/episodes?slug=${encodeURIComponent(mv.slug)}`, { credentials: 'same-origin' }).catch(() => null)
                if (!r) return
                const d = await r.json()
                const episodes = d.status ? (d.episodes || []).flatMap((s: any) => s.list.map((e: any) => ({ name: e.name, slug: e.slug, embed: e.embed, m3u8: e.m3u8 }))) : []
                pickEpisodes = episodes
                $('xc-host-error')?.classList.add('hidden')
                if (!episodes.length) {
                  $('xc-ep-picker')?.classList.add('hidden')
                  hostErr('Không lấy được tập phim.')
                  return
                }
                renderEpPicker(mv)
              })
            })
          }, 350)
        })
      }

      function renderEpPicker(mv: { slug: string; name: string; thumb: string }) {
        if (!epPicker || !epGrid) return
        const thumbEl = $('xc-pick-thumb') as HTMLImageElement | null
        const nameEl = $('xc-pick-name')
        const metaEl = $('xc-pick-meta')
        if (thumbEl) thumbEl.src = mv.thumb || '/logo-64.png'
        if (nameEl) nameEl.textContent = mv.name
        if (metaEl) metaEl.textContent = `${pickEpisodes.length} nguồn/tập`
        epGrid.innerHTML = pickEpisodes.map((ep, i) => `
          <button type="button" class="xc-ep-btn px-1.5 py-2 rounded-[var(--radius-cm-btn)] text-[11px] font-medium border border-cm-border bg-cm-surface text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)] truncate" data-index="${i}" title="${escapeHTML(ep.name)}">
            ${escapeHTML(ep.name)}
          </button>
        `).join('')
        epPicker.classList.remove('hidden')
        epGrid.querySelectorAll<HTMLButtonElement>('.xc-ep-btn').forEach((b) => {
          b.addEventListener('click', () => {
            const ep = pickEpisodes[Number(b.dataset.index || 0)]
            if (!ep) return
            selectedMovie = { slug: mv.slug, movieName: mv.name, episode: ep.slug, epName: ep.name, thumb: mv.thumb, embed: ep.embed, m3u8: ep.m3u8 }
            epGrid.querySelectorAll('.xc-ep-btn').forEach((x) => {
              x.classList.remove('bg-cm-elevated', 'text-cm-text', 'border-cm-border-strong')
            })
            b.classList.add('bg-cm-elevated', 'text-cm-text', 'border-cm-border-strong')
            $('xc-play-now')?.removeAttribute('disabled')
            $('xc-schedule')?.removeAttribute('disabled')
          })
        })
      }

      function hostErr(msg: string) {
        const el = $('xc-host-error')
        if (!el) return
        el.textContent = msg
        el.classList.remove('hidden')
      }

      async function startMovie(scheduleStart: number) {
        if (!selectedMovie) return hostErr('Chọn phim trước.')
        const r = await fetch(`/api/xem-chung/${code}/movie`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...selectedMovie, scheduleStart }),
        }).catch(() => null)
        if (!r) return hostErr('Lỗi kết nối server.')
        const d = await r.json()
        if (!d.ok) return hostErr(d.error || 'Thất bại.')
        $('xc-schedule-pick')?.classList.add('hidden')
        $('xc-ep-picker')?.classList.add('hidden')
        room = d.room
        renderAll()
      }

      $('xc-play-now')?.addEventListener('click', () => startMovie(nowMs() + 10_000))
      $('xc-schedule')?.addEventListener('click', () => $('xc-schedule-pick')?.classList.toggle('hidden'))
      $('xc-schedule-confirm')?.addEventListener('click', () => {
        const dt = ($('xc-schedule-dt') as HTMLInputElement | null)?.value
        if (!dt) return hostErr('Chọn thời gian chiếu.')
        const at = new Date(dt).getTime()
        if (at <= nowMs()) return hostErr('Thời gian phải ở tương lai.')
        startMovie(at)
      })
      $('xc-resync')?.addEventListener('click', () => {
        if (playerMode === 'video') {
          if (isHost) void pushSync()
          else void pollSyncLoop()
          return
        }
        const f = frameEl()
        if (!f) return
        const emb = room?.movie?.embed
        if (!emb) return
        if (f.dataset.src) {
          f.removeAttribute('src')
          f.dataset.src = ''
        }
        f.src = emb
        f.dataset.src = emb
        f.classList.remove('hidden')
      })
      $('xc-stop')?.addEventListener('click', async () => {
        const r = await fetch(`/api/xem-chung/${code}/end`, { method: 'POST', credentials: 'same-origin' }).catch(() => null)
        if (!r) return
        const d = await r.json()
        if (d.room) { room = d.room; renderAll() }
      })

      // chat
      $('xc-chat-form')?.addEventListener('submit', async (e) => {
        e.preventDefault()
        const inp = $('xc-chat-input') as HTMLInputElement | null
        if (!inp || !inp.value.trim()) return
        const text = inp.value
        inp.value = ''
        const r = await fetch(`/api/xem-chung/${code}/chat`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', ...guestHeaders() },
          body: JSON.stringify({ text }),
        }).catch(() => null)
        if (!r) return
        const d = await r.json()
        if (d.room) { room = d.room; renderChat() }
      })

      $('xc-share')?.addEventListener('click', () => {
        navigator.clipboard?.writeText(window.location.href).then(() => {
          const btn = $('xc-share')
          if (btn) { const o = btn.textContent; btn.textContent = 'Đã chép'; window.setTimeout(() => { btn.textContent = o }, 1600) }
        }).catch(() => {})
      })

      void whoami()
      void syncClock()
      void refresh().then((ok) => { if (ok) renderAll() })
      // Tự thêm mình vào phòng (kể cả guest qua link share) để count member chuẩn.
      // Nếu buổi công chiếu đã bắt đầu và mình là người mới → hiện overlay chặn.
      fetch(`/api/xem-chung/${code}/join`, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', ...guestHeaders() },
      })
        .then((r) => r.json().catch(() => null))
        .then((d) => {
          if (d && d.blocked === true) {
            const info = $('xc-blocked-info')
            const movieName = room?.movie?.movieName
            if (info) info.textContent = movieName
              ? `Phim: ${movieName} — bắt đầu ${room?.status === 'ended' ? 'đã chiếu xong' : new Date(room?.startTime || 0).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit' })}.`
              : 'Hãy xem lịch chiếu ở trang Xem Chung để bắt kịp buổi sau.'
            const ov = $('xc-blocked-overlay')
            if (ov) { ov.classList.remove('hidden'); ov.classList.add('flex', 'flex-col') }
          }
        })
        .catch(() => {})
      const clockTimer = window.setInterval(() => { void syncClock() }, 60_000)
      const refreshTimer = window.setInterval(() => {
        void refresh().then((ok) => { if (ok) renderAll() })
      }, 3000)
      // Host = nguồn thời gian (đẩy mốc mỗi 1s); member đọc + bám theo.
      const pushTimer = window.setInterval(() => { if (isHost) void pushSync() }, 1000)
      const pollTimer = window.setInterval(() => { void pollSyncLoop() }, 1000)

      timer = window.setInterval(() => {
        drawFrame()
        tickClock()
        renderSyncBadge()
        if (!isHost) applyFollow()
      }, 250)

      return () => {
        window.clearInterval(timer)
        window.clearInterval(clockTimer)
        window.clearInterval(refreshTimer)
        window.clearInterval(pushTimer)
        window.clearInterval(pollTimer)
        window.clearTimeout(lookupTimer)
        destroyVideo()
      }
    })
  </script>
</BaseLayout>