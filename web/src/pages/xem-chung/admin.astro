---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ThemeBG from '../../components/ThemeBG.astro'
import { getSessionUser, isAdmin } from '../../lib/auth'
import { FaCalendarCheck, FaFilm, FaMagnifyingGlass, FaPlus, FaRotate } from 'react-icons/fa6'

const user = await getSessionUser(Astro.cookies)
if (!user || !isAdmin(user)) {
  return Astro.redirect('/xem-chung', 307)
}
---

<BaseLayout title="Quản trị Công chiếu" description="Dashboard quản trị buổi công chiếu Xem Chung." noIndex>
  <ThemeBG name="xem-chung" />
  <main class="px-4 sm:px-6 md:px-8 py-6 pb-24 lg:pb-12 max-w-5xl mx-auto" data-admin-page data-room-code="">
    <div class="flex items-center justify-between gap-3 flex-wrap mb-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border flex items-center justify-center text-cm-accent"><FaCalendarCheck className="w-5 h-5" /></div>
        <div>
          <h1 class="text-lg font-bold text-cm-text">Quản trị buổi công chiếu</h1>
          <p class="text-cm-meta text-cm-text-3">Tạo lịch chiếu & quản lý phòng — chỉ admin xem được.</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="xc-refresh" type="button" class="inline-flex items-center gap-1.5 h-10 px-3 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-cm-meta font-medium text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]"><FaRotate className="w-3 h-3" /> Làm mới</button>
        <a href="/xem-chung" class="inline-flex items-center h-10 px-3 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-cm-meta font-medium text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]">Trang Xem Chung</a>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-4 items-start mb-6">
      <!-- Tạo buổi công chiếu -->
      <div class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] p-5 space-y-3">
        <h2 class="text-cm-body font-bold text-cm-text flex items-center gap-2"><FaPlus className="w-3.5 h-3.5 text-cm-accent" /> Tạo buổi công chiếu</h2>

        <div class="relative">
          <FaMagnifyingGlass className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-cm-text-3" />
          <input
            id="xc-lookup"
            type="text"
            placeholder="Gõ tên phim để tìm..."
            autocomplete="off"
            class="w-full pl-10 pr-4 h-11 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-body text-cm-text placeholder:text-cm-text-3 focus:outline-none focus:border-cm-accent/60 transition-colors duration-[var(--duration-cm)]"
          />
          <div id="xc-lookup-res" class="hidden absolute left-0 right-0 top-full mt-2 z-30 max-h-72 overflow-y-auto rounded-[var(--radius-cm-card)] bg-cm-elevated border border-cm-border shadow-[var(--shadow-cm-up)]"></div>
        </div>

        <div id="xc-ep-picker" class="hidden space-y-2">
          <div class="flex items-center gap-3 p-3 rounded-[var(--radius-cm-card)] bg-cm-surface border border-cm-border">
            <img id="xc-pick-thumb" alt="" class="w-14 h-20 rounded-[var(--radius-cm-btn)] object-cover shrink-0 bg-cm-bg-2 border border-cm-border" />
            <div class="min-w-0">
              <p id="xc-pick-name" class="text-cm-body font-bold text-cm-text truncate"></p>
              <p id="xc-pick-meta" class="text-[11px] text-cm-text-3"></p>
            </div>
          </div>
          <p class="text-[11px] font-semibold text-cm-text-3 uppercase tracking-wide mb-1 px-1">Chọn tập/nguồn</p>
          <div id="xc-ep-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-1.5 max-h-44 overflow-y-auto p-1"></div>
        </div>

        <div id="xc-schedule-pick" class="hidden space-y-3 pt-1">
          <div>
            <p class="text-[11px] font-semibold text-cm-text-3 uppercase tracking-wide mb-1.5 px-1">Giờ công chiếu (giờ địa phương)</p>
            <input id="xc-schedule-dt" type="datetime-local" class="w-full px-4 h-11 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-body text-cm-text focus:outline-none focus:border-cm-accent/60 transition-colors duration-[var(--duration-cm)]" />
          </div>
          <div>
            <p class="text-[11px] font-semibold text-cm-text-3 uppercase tracking-wide mb-1.5 px-1">Mã phòng (tuỳ chọn, 4–8 ký tự)</p>
            <input id="xc-code"
              type="text"
              maxlength="8"
              autocapitalize="characters"
              autocomplete="off"
              placeholder="VD: MMA404"
              class="w-full px-4 h-11 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-body text-cm-text uppercase tracking-widest placeholder:text-cm-text-3 placeholder:normal-case focus:outline-none focus:border-cm-accent/60 transition-colors duration-[var(--duration-cm)]"
            />
          </div>
          <button id="xc-create" type="button" class="w-full h-12 rounded-[var(--radius-cm-btn)] text-cm-body font-bold bg-cm-accent text-white hover:bg-cm-accent-hover disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-[var(--duration-cm)]">Tạo lịch công chiếu</button>
          <p id="xc-create-msg" class="hidden text-cm-meta text-red-400"></p>
        </div>
      </div>

      <!-- Danh sách phòng -->
      <div class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] p-5">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-cm-body font-bold text-cm-text flex items-center gap-2"><FaFilm className="w-3.5 h-3.5 text-cm-accent" /> Phòng công chiếu</h2>
          <span id="xc-count" class="text-[11px] text-cm-text-3"></span>
        </div>
        <div id="xc-rooms" class="space-y-2 max-h-[34rem] overflow-y-auto pr-1">
          <p class="text-cm-meta text-cm-text-3 py-6 text-center">Đang tải...</p>
        </div>
      </div>
    </div>

    <!-- Link chia sẻ nổi -->
    <div id="xc-share-toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-[var(--radius-cm-btn)] bg-cm-elevated border border-cm-border text-cm-body font-semibold text-cm-text shadow-[var(--shadow-cm-up)]"></div>
  </main>

  <script>
    import { registerPageInit } from '../../scripts/lifecycle'

    interface AdminMovie { slug: string; name: string; thumb: string }
    interface AdminEp { name: string; slug: string; embed: string; m3u8?: string }
    interface AdminRoom {
      code: string; status: string; hostId: string; members: { id: string; username: string; global_name?: string | null }[];
      movie: { slug: string; movieName: string; epName: string; episode: string; thumb: string; embed: string } | null;
      startTime: number; endedAt: number; createdAt: number;
    }

    function escapeHTML(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string)
    }

    const ICON_LINK =
      '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10.59 13.41c.41.39.41 1.03 0 1.42-.39.39-1.03.39-1.42 0a5.001 5.001 0 0 1 0-7.07l3.54-3.54a5.001 5.001 0 0 1 7.07 0 5.001 5.001 0 0 1 0 7.07l-1.49 1.49c.01-.82-.12-1.64-.4-2.42l.47-.48a2.982 2.982 0 0 0 0-4.24 2.982 2.982 0 0 0-4.24 0l-3.53 3.53a2.982 2.982 0 0 0 0 4.24l.26.26zM13.41 10.59a1.003 1.003 0 0 0-1.42 0 1.003 1.003 0 0 0 0 1.42l.01.01a5.001 5.001 0 0 1 0 7.07l-3.54 3.54a5.001 5.001 0 0 1-7.07 0 5.001 5.001 0 0 1 0-7.07l1.49-1.49c-.01.82.12 1.64.4 2.42l-.47.48a2.982 2.982 0 0 0 0 4.24 2.982 2.982 0 0 0 4.24 0l3.53-3.53a2.982 2.982 0 0 0 0-4.24z"/></svg>'
    const ICON_STOP =
      '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>'
    const ICON_TRASH =
      '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 7h12l-.9 12.6a2 2 0 0 1-2 1.9H8.9a2 2 0 0 1-2-1.9L6 7zm3 .6l.5 11.4h1l-.4-11.4H9zm3 0v11.4h1V7.6h-1zm3 0l-.4 11.4h1l.5-11.4H15zM9 3h6v2H9V3z"/></svg>'
    const ICON_CLOCK =
      '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm-.6-12h1.8v4.4l3.6 2.1-.9 1.5-4.5-2.7V8z"/></svg>'

    registerPageInit(() => {
      const page = document.querySelector<HTMLElement>('[data-admin-page]')
      if (!page) return () => {}

      let selected: { movie: AdminMovie; ep: AdminEp } | null = null
      let rooms: AdminRoom[] = []

      const $ = (id: string) => document.getElementById(id)

      function showMsg(msg: string) {
        const el = $('xc-create-msg')
        if (!el) return
        el.textContent = msg
        el.classList.remove('hidden')
      }
      function fmtDT(ms: number): string {
        if (!ms) return '—'
        return new Date(ms).toLocaleString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })
      }
      function fmtRemain(ms: number): string {
        const s = Math.max(0, Math.round((ms - Date.now()) / 1000))
        if (s >= 3600) return `${Math.floor(s / 3600)}g ${Math.floor((s % 3600) / 60)}p`
        if (s >= 60) return `${Math.floor(s / 60)}p ${s % 60}s`
        return `${s}s`
      }
      function statusBadge(r: AdminRoom): string {
        const pill = 'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[10px] font-bold'
        if (r.status === 'ended') return `<span class="${pill} bg-cm-surface text-cm-text-3 border border-cm-border">Đã kết thúc</span>`
        if (r.status === 'playing') return `<span class="${pill} bg-emerald-500/10 text-emerald-400 border border-emerald-500/15"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Đang công chiếu</span>`
        if (r.status === 'scheduled') return `<span class="${pill} bg-cm-surface text-cm-accent border border-cm-border">${ICON_CLOCK}Sắp chiếu</span>`
        return `<span class="${pill} bg-cm-surface text-cm-text-3 border border-cm-border">Mở tự do</span>`
      }

      function renderRooms() {
        const list = $('xc-rooms')
        const count = $('xc-count')
        if (!list) return
        if (count) count.textContent = `${rooms.length} phòng`
        if (!rooms.length) {
          list.innerHTML = '<p class="text-cm-meta text-cm-text-3 py-6 text-center">Chưa có phòng nào. Tạo buổi công chiếu ở bên trái.</p>'
          return
        }
        list.innerHTML = rooms.map((r) => `
          <div class="rounded-[var(--radius-cm-card)] bg-cm-surface border border-cm-border p-3">
            <div class="flex items-center justify-between gap-2">
              <div class="min-w-0">
                <p class="text-cm-body font-bold text-cm-text truncate flex items-center gap-2">
                  ${escapeHTML(r.movie?.movieName || 'Phòng trống')}
                  ${statusBadge(r)}
                </p>
                <p class="text-[11px] text-cm-text-3 mt-0.5 truncate">#${r.code} ${r.movie?.epName ? '• ' + escapeHTML(r.movie.epName) : ''}</p>
                <p class="text-[11px] text-cm-text-2 mt-0.5">
                  ${r.status === 'scheduled' ? `Chiếu lúc <b class="text-cm-text">${fmtDT(r.startTime)}</b> • còn <b class="text-cm-accent">${fmtRemain(r.startTime)}</b>` : r.status === 'playing' ? `Đang phát từ ${fmtDT(r.startTime)}` : '—'}
                  • ${r.members.length} người
                </p>
              </div>
            </div>
            <div class="flex items-center gap-1.5 mt-2 flex-wrap">
              <button type="button" class="xc-copy inline-flex items-center gap-1 px-2.5 h-8 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-[11px] font-medium text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]" data-code="${r.code}">${ICON_LINK}Link</button>
              <button type="button" class="xc-goto inline-flex items-center gap-1 px-2.5 h-8 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-[11px] font-medium text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]" data-code="${r.code}">Vào phòng</button>
              ${r.status !== 'ended' ? `<button type="button" class="xc-end inline-flex items-center gap-1 px-2.5 h-8 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-[11px] font-medium text-cm-text-3 hover:text-cm-text hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]" data-code="${r.code}">${ICON_STOP}Kết thúc</button>` : ''}
              <button type="button" class="xc-del inline-flex items-center gap-1 px-2.5 h-8 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-[11px] font-medium text-red-400 hover:text-red-300 hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]" data-code="${r.code}">${ICON_TRASH}Xoá</button>
            </div>
          </div>
        `).join('')
        list.querySelectorAll<HTMLButtonElement>('.xc-copy').forEach((b) => b.addEventListener('click', () => copyLink(b.dataset.code || '')))
        list.querySelectorAll<HTMLButtonElement>('.xc-goto').forEach((b) => b.addEventListener('click', () => { window.location.href = `/xem-chung/${b.dataset.code}` }))
        list.querySelectorAll<HTMLButtonElement>('.xc-end').forEach((b) => b.addEventListener('click', () => endRoom(b.dataset.code || '')))
        list.querySelectorAll<HTMLButtonElement>('.xc-del').forEach((b) => b.addEventListener('click', () => delRoom(b.dataset.code || '')))
      }

      async function refreshRooms() {
        try {
          const r = await fetch('/api/xem-chung/admin', { credentials: 'same-origin', cache: 'no-store' })
          const d = await r.json()
          if (d.ok && Array.isArray(d.rooms)) rooms = d.rooms
        } catch {}
        renderRooms()
      }

      function copyLink(code: string) {
        const url = `${window.location.origin}/xem-chung/${code}`
        navigator.clipboard?.writeText(url).then(() => toast('Đã chép link phòng #' + code)).catch(() => {})
      }
      function toast(msg: string) {
        const el = $('xc-share-toast')
        if (!el) return
        el.textContent = msg
        el.classList.remove('hidden')
        window.setTimeout(() => el.classList.add('hidden'), 1600)
      }

      async function endRoom(code: string) {
        await fetch(`/api/xem-chung/admin/${code}`, { method: 'POST', credentials: 'same-origin' }).catch(() => {})
        await refreshRooms()
      }
      async function delRoom(code: string) {
        if (!confirm(`Xoá hẳn phòng #${code}?`)) return
        await fetch(`/api/xem-chung/admin/${code}`, { method: 'DELETE', credentials: 'same-origin' }).catch(() => {})
        await refreshRooms()
      }

      // ── Tìm phim ──
      const lookup = $('xc-lookup') as HTMLInputElement | null
      const lookupRes = $('xc-lookup-res')
      let lookupTimer = 0
      let episodes: AdminEp[] = []
      if (lookup) {
        lookup.addEventListener('input', () => {
          window.clearTimeout(lookupTimer)
          lookupTimer = window.setTimeout(async () => {
            const q = lookup.value.trim()
            if (!q || !lookupRes) { lookupRes?.classList.add('hidden'); return }
            const r = await fetch(`/api/xem-chung/lookup?q=${encodeURIComponent(q)}`, { credentials: 'same-origin' }).catch(() => null)
            if (!r) return
            const d = await r.json()
            const res = (d.results || []).slice(0, 6)
            if (!lookupRes) return
            if (!res.length) {
              lookupRes.innerHTML = '<p class="px-4 py-2 text-cm-meta text-cm-text-3">Không tìm thấy phim.</p>'
              lookupRes.classList.remove('hidden')
              return
            }
            lookupRes.innerHTML = res.map((mv: AdminMovie) => `
              <button type="button" class="xc-mv block w-full text-left px-3 py-2.5 hover:bg-cm-surface transition-colors duration-[var(--duration-cm)]" data-slug="${escapeHTML(mv.slug)}" data-name="${escapeHTML(mv.name)}" data-thumb="${escapeHTML(mv.thumb || '')}">
                <span class="flex items-center gap-3">
                  ${mv.thumb ? `<img src="${escapeHTML(mv.thumb)}" alt="" loading="lazy" decoding="async" class="w-8 h-11 rounded-[var(--radius-cm-btn)] object-cover shrink-0 bg-cm-bg-2 border border-cm-border" />` : '<span class="w-8 shrink-0"></span>'}
                  <span class="min-w-0">
                    <span class="block text-cm-body text-cm-text truncate">${escapeHTML(mv.name)}</span>
                    <span class="block text-[11px] text-cm-text-3">Chọn phim</span>
                  </span>
                </span>
              </button>
            `).join('')
            lookupRes.classList.remove('hidden')
            lookupRes.querySelectorAll<HTMLButtonElement>('.xc-mv').forEach((b) => {
              b.addEventListener('click', async () => {
                const mv: AdminMovie = { slug: b.dataset.slug || '', name: b.dataset.name || '', thumb: b.dataset.thumb || '' }
                lookupRes.classList.add('hidden')
                lookup.value = mv.name
                const r = await fetch(`/api/episodes?slug=${encodeURIComponent(mv.slug)}`, { credentials: 'same-origin' }).catch(() => null)
                if (!r) return
                const d = await r.json()
                episodes = d.status ? (d.episodes || []).flatMap((s: any) => s.list.map((e: any) => ({ name: e.name, slug: e.slug, embed: e.embed, m3u8: e.m3u8 }))) : []
                showMsg('')
                if (!episodes.length) {
                  $('xc-ep-picker')?.classList.add('hidden')
                  $('xc-schedule-pick')?.classList.add('hidden')
                  showMsg('Phim này không có nguồn phát.')
                  return
                }
                renderEpPicker(mv)
              })
            })
          }, 350)
        })
        lookup.addEventListener('click', () => { if (lookup.value && lookup.value === selected?.movie.name) return })
      }

      function renderEpPicker(mv: AdminMovie) {
        const pk = $('xc-ep-picker')
        const grid = $('xc-ep-grid')
        if (!pk || !grid) return
        const thumbEl = $('xc-pick-thumb') as HTMLImageElement | null
        const nameEl = $('xc-pick-name')
        const metaEl = $('xc-pick-meta')
        if (thumbEl) thumbEl.src = mv.thumb || '/logo.png'
        if (nameEl) nameEl.textContent = mv.name
        if (metaEl) metaEl.textContent = `${episodes.length} nguồn/tập`
        grid.innerHTML = episodes.map((ep, i) => `
          <button type="button" class="xc-ep px-1.5 py-2 rounded-[var(--radius-cm-btn)] text-[11px] font-medium border border-cm-border bg-cm-surface text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)] truncate" data-index="${i}" title="${escapeHTML(ep.name)}">
            ${escapeHTML(ep.name)}
          </button>
        `).join('')
        pk.classList.remove('hidden')
        grid.querySelectorAll<HTMLButtonElement>('.xc-ep').forEach((b) => {
          b.addEventListener('click', () => {
            const ep = episodes[Number(b.dataset.index || 0)]
            if (!ep) return
            selected = { movie: mv, ep }
            grid.querySelectorAll('.xc-ep').forEach((x) => x.classList.remove('border-cm-border-strong', 'text-cm-text', 'bg-cm-elevated'))
            b.classList.add('border-cm-border-strong', 'text-cm-text', 'bg-cm-elevated')
            if (metaEl) metaEl.textContent = `${mv.name} • ${ep.name}`
            $('xc-schedule-pick')?.classList.remove('hidden')
          })
        })
      }

      // ── Tạo ──
      $('xc-create')?.addEventListener('click', async () => {
        if (!selected) return showMsg('Chọn phim + tập trước.')
        const dt = ($('xc-schedule-dt') as HTMLInputElement | null)?.value
        if (!dt) return showMsg('Chọn giờ công chiếu.')
        const at = new Date(dt).getTime()
        if (!(at > Date.now())) return showMsg('Giờ công chiếu phải ở tương lai.')
        const btn = $('xc-create') as HTMLButtonElement | null
        if (btn) { btn.disabled = true; btn.textContent = 'Đang tạo...' }
        const r = await fetch('/api/xem-chung/admin', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            code: ($('xc-code') as HTMLInputElement | null)?.value.trim().toUpperCase() || '',
            slug: selected.movie.slug,
            movieName: selected.movie.name,
            epName: selected.ep.name,
            episode: selected.ep.slug,
            thumb: selected.movie.thumb,
            embed: selected.ep.embed,
            m3u8: selected.ep.m3u8,
            startTime: at,
          }),
        }).catch(() => null)
        if (btn) { btn.disabled = false; btn.textContent = 'Tạo lịch công chiếu' }
        if (!r) return showMsg('Không kết nối được server.')
        const d = await r.json()
        if (!d.ok || !d.room) return showMsg(d.error || 'Tạo thất bại.')
        toast(`Đã tạo phòng #${d.room.code}. Link đã chép vào clipboard.`)
        navigator.clipboard?.writeText(`${window.location.origin}/xem-chung/${d.room.code}`).catch(() => {})
        selected = null
        const inp = $('xc-code') as HTMLInputElement | null
        if (inp) inp.value = ''
        $('xc-ep-picker')?.classList.add('hidden')
        $('xc-schedule-pick')?.classList.add('hidden')
        if (lookup) lookup.value = ''
        await refreshRooms()
      })

      $('xc-refresh')?.addEventListener('click', () => void refreshRooms())
      window.setInterval(() => void refreshRooms(), 8000)
      void refreshRooms()
    })
  </script>
</BaseLayout>