---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { FaFilm, FaLink, FaDiscord } from 'react-icons/fa6'
---

<BaseLayout title="Xem Chung" description="Tạo phòng xem phim cùng bạn bè tại Nô Lệ Làm Phim." noIndex>
  <main class="flex-1" data-grid-page>
    <div class="px-4 md:px-8 py-10 max-w-2xl mx-auto">
      <div class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-text-primary">Xem Chung</h1>
        <p class="text-text-secondary text-sm mt-2">
          Tạo phòng riêng, mời bạn bè bằng mã — mọi người cùng xem một bộ phim, không ai tua được.
          Chỉ phát sóng theo lịch của host.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div class="content-card p-5">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-9 h-9 rounded-xl glass-tile flex items-center justify-center text-[#FF6B9D]"><FaFilm className="w-5 h-5" /></div>
            <div>
              <h2 class="text-base font-bold text-text-primary">Tạo phòng</h2>
              <p class="text-xs text-text-muted">Bạn là host, quyết định phim + giờ chiếu</p>
            </div>
          </div>
          <button id="xc-create" type="button"
            class="w-full px-5 py-3 rounded-xl text-sm font-bold tracking-wide bg-gradient-to-r from-[#FF6B9D] to-[#C44BED] text-white hover:brightness-110 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
            Tạo phòng mới
          </button>
        </div>

        <div class="content-card p-5">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-9 h-9 rounded-xl glass-tile flex items-center justify-center text-[#FF6B9D]"><FaLink className="w-5 h-5" /></div>
            <div>
              <h2 class="text-base font-bold text-text-primary">Vào phòng</h2>
              <p class="text-xs text-text-muted">Nhập mã phòng được bạn bè gửi</p>
            </div>
          </div>
          <form id="xc-join" class="flex gap-2">
            <input
              id="xc-code"
              type="text"
              inputmode="text"
              autocapitalize="characters"
              autocomplete="off"
              maxlength="6"
              placeholder="ABC123"
              class="flex-1 min-w-0 px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-sm text-text-primary uppercase tracking-widest placeholder:text-text-muted placeholder:normal-case focus:outline-none focus:border-[#C44BED]/50 disabled:opacity-50"
            />
            <button type="submit"
              class="px-5 py-3 rounded-xl text-sm font-bold glass-tile-active text-white hover:brightness-110 transition-all disabled:opacity-50">
              Vào
            </button>
          </form>
          <p id="xc-error" class="hidden mt-3 text-xs text-red-400"></p>
        </div>
      </div>

      <div id="xc-login-note" class="hidden mt-6 p-4 rounded-xl glass-tile text-center">
        <p class="text-sm text-text-secondary mb-3">Cần đăng nhập Discord để xem cùng nhau.</p>
        <a id="xc-login-btn" href="/api/auth/discord"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-[#5865F2] text-white hover:brightness-110 transition-all">
          <FaDiscord className="w-5 h-5" />
          Đăng nhập bằng Discord
        </a>
      </div>

      <div id="xc-profile" class="hidden mt-6 p-4 rounded-xl glass-tile flex items-center gap-3">
        <img id="xc-avatar" alt="" class="w-11 h-11 rounded-full" />
        <div class="min-w-0">
          <p id="xc-name" class="text-sm font-bold text-text-primary truncate"></p>
          <p id="xc-logged" class="text-xs text-emerald-400">✓ Đã đăng nhập — bạn có thể tạo hoặc vào phòng</p>
        </div>
      </div>

      <div id="xc-my" class="hidden mt-6">
        <h3 class="text-sm font-bold text-text-primary mb-3">Phòng của tôi</h3>
        <div id="xc-my-list" class="grid gap-2"></div>
      </div>
    </div>
  </main>

  <script>
    import { registerPageInit } from '../../scripts/lifecycle'

    registerPageInit(() => {
      const root = document.querySelector('[data-grid-page]')
      if (!root) return () => {}
      const createBtn = document.getElementById('xc-create') as HTMLButtonElement | null
      const joinForm = document.getElementById('xc-join') as HTMLFormElement | null
      const codeInput = document.getElementById('xc-code') as HTMLInputElement | null
      const errorEl = document.getElementById('xc-error') as HTMLElement | null
      const loginNote = document.getElementById('xc-login-note') as HTMLElement | null
      const profileBox = document.getElementById('xc-profile') as HTMLElement | null
      const avatarEl = document.getElementById('xc-avatar') as HTMLImageElement | null
      const nameEl = document.getElementById('xc-name') as HTMLElement | null
      const myBox = document.getElementById('xc-my') as HTMLElement | null
      const myList = document.getElementById('xc-my-list') as HTMLElement | null

      let authed = false

      // Guest: cache danh tính xem ké trên trình duyệt
      const GUEST_KEY = 'nllp_guest'
      function loadGuest(): { id: string; name: string } {
        try {
          const raw = localStorage.getItem(GUEST_KEY)
          if (raw) {
            const g = JSON.parse(raw)
            if (g && /^[a-zA-Z0-9]{12,32}$/.test(g.id) && g.name) return g
          }
        } catch {}
        const id = Array.from(crypto.getRandomValues(new Uint8Array(8)), (b) => b.toString(16).padStart(2, '0')).join('')
        const name = 'Khách-' + Math.floor(1000 + Math.random() * 9000)
        const g = { id, name }
        try { localStorage.setItem(GUEST_KEY, JSON.stringify(g)) } catch {}
        return g
      }
      const guest = loadGuest()

      function showErr(msg: string) {
        if (!errorEl) return
        errorEl.textContent = msg
        errorEl.classList.remove('hidden')
      }

      interface MeUser { id: string; username: string; global_name?: string | null; avatar?: string | null }

      async function whoami(): Promise<MeUser | null> {
        try {
          const r = await fetch('/api/auth/me', { credentials: 'same-origin' })
          const d = await r.json()
          return d.user?.id ? d.user as MeUser : null
        } catch {
          return null
        }
      }

      function setAuthed(authedState: boolean, user: MeUser | null) {
        authed = authedState
        if (createBtn) createBtn.disabled = !authed
        if (loginNote) {
          // Cho phép guest VÀO phòng; chỉ tạo phòng/làm host mới cần đăng nhập.
          loginNote.classList.toggle('hidden', authed)
          loginNote.innerHTML = `<p class="text-sm text-text-secondary mb-3">Vào với tư cách <b class="text-text-primary">${escapeName(guest.name)}</b> (xem + chat được). Đăng nhập Discord để <b class="text-text-primary">tạo phòng / làm host</b>.</p>
            <a href="/api/auth/discord" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-[#5865F2] text-white hover:brightness-110 transition-all">
            Đăng nhập bằng Discord</a>`
        }
        if (!profileBox) return
        profileBox.classList.toggle('hidden', !authed)
        if (authed && avatarEl && nameEl && user) {
          avatarEl.src = user.avatar
            ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=96`
            : '/logo.png'
          nameEl.textContent = user.global_name || user.username
        }
      }

      function escapeName(s: string): string {
        return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string)
      }

      async function go(code: string) {
        if (!/^[A-Z0-9]{4,8}$/.test(code)) {
          showErr('Mã phòng không hợp lệ.')
          return
        }
        const r = await fetch(`/api/xem-chung/${code}/join`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'x-guest-id': guest.id, 'x-guest-name': guest.name },
        }).catch(() => null)
        if (!r) return showErr('Không kết nối được server.')
        const d = await r.json()
        if (!d.ok || !d.room) return showErr(d.error || 'Không thể vào phòng.')
        window.location.href = `/xem-chung/${d.room.code}`
      }

      async function loadMy(user: MeUser) {
        if (!myBox || !myList) return
        try {
          const res = await fetch('/api/xem-chung/mine', { credentials: 'same-origin' })
          const data = await res.json()
          const codes: string[] = data?.codes || []
          myBox.classList.remove('hidden')
          if (!codes.length) {
            myList.innerHTML = '<p class="text-xs text-text-muted">Bạn chưa tham gia phòng nào.</p>'
            return
          }
          myList.innerHTML = codes.map((c) => `
            <a href="/xem-chung/${c}" class="flex items-center justify-between px-4 py-3 rounded-xl glass-tile text-sm hover:bg-white/5 transition-colors">
              <span class="font-mono tracking-widest">${c}</span>
              <span class="text-xs text-text-muted">Vào phòng →</span>
            </a>
          `).join('')
        } catch {}
      }

      createBtn?.addEventListener('click', async () => {
        if (!authed) {
          showErr('Bạn chưa đăng nhập. Hãy đăng nhập Discord để tạo phòng.')
          return
        }
        createBtn.disabled = true
        createBtn.textContent = 'Đang tạo...'
        const r = await fetch('/api/xem-chung', { method: 'POST', credentials: 'same-origin' }).catch(() => null)
        if (!r) {
          createBtn.disabled = false
          createBtn.textContent = 'Tạo phòng mới'
          return showErr('Không kết nối được server.')
        }
        const d = await r.json()
        createBtn.disabled = false
        createBtn.textContent = 'Tạo phòng mới'
        if (!d.ok || !d.room) return showErr(d.error || 'Tạo phòng thất bại.')
        window.location.href = `/xem-chung/${d.room.code}`
      })

      joinForm?.addEventListener('submit', (e) => {
        e.preventDefault()
        if (codeInput) go(codeInput.value.trim().toUpperCase())
      })

      void whoami().then((user) => {
        setAuthed(!!user, user)
        if (user) void loadMy(user)
      })
    })
  </script>
</BaseLayout>