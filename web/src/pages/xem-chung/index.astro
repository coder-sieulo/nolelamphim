---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { FaFilm, FaLink, FaGaugeHigh } from 'react-icons/fa6'
---

<BaseLayout title="Xem Chung" description="Tạo phòng xem phim cùng bạn bè tại Nô Lệ Làm Phim." noIndex cache="public">
  <main class="flex-1" data-grid-page>
    <div class="px-4 sm:px-6 md:px-8 py-10 pb-24 lg:pb-12 max-w-2xl mx-auto">
      <div class="mb-8">
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <div>
            <h1 class="text-2xl md:text-3xl font-bold text-cm-text">Xem Chung</h1>
            <p class="text-cm-text-2 text-cm-body mt-2">
              Tạo phòng riêng, mời bạn bè bằng mã — mọi người cùng xem một bộ phim, không ai tua được.
              Chỉ phát sóng theo lịch của host.
            </p>
          </div>
          <a id="xc-admin-link" href="/xem-chung/admin"
            class="hidden items-center gap-1.5 h-10 px-4 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface text-cm-meta font-bold text-cm-accent hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]">
            <FaGaugeHigh className="w-3.5 h-3.5" /> Dashboard công chiếu
          </a>
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] p-5">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-9 h-9 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border flex items-center justify-center text-cm-accent"><FaFilm className="w-5 h-5" /></div>
            <div>
              <h2 class="text-cm-body font-bold text-cm-text">Tạo phòng</h2>
              <p class="text-cm-meta text-cm-text-3">Bạn là host, quyết định phim + giờ chiếu</p>
            </div>
          </div>
          <button id="xc-create" type="button"
            class="w-full h-12 rounded-[var(--radius-cm-btn)] text-cm-body font-bold tracking-wide bg-cm-accent text-white hover:bg-cm-accent-hover transition-all duration-[var(--duration-cm)] disabled:opacity-50 disabled:cursor-not-allowed">
            Tạo phòng mới
          </button>
        </div>

        <div class="bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] p-5">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-9 h-9 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border flex items-center justify-center text-cm-accent"><FaLink className="w-5 h-5" /></div>
            <div>
              <h2 class="text-cm-body font-bold text-cm-text">Vào phòng</h2>
              <p class="text-cm-meta text-cm-text-3">Nhập mã phòng được bạn bè gửi</p>
            </div>
          </div>
          <form id="xc-join" class="flex gap-2">
            <input
              id="xc-code"
              type="text"
              inputmode="text"
              autocapitalize="characters"
              autocomplete="off"
              maxlength="6"
              placeholder="ABC123"
              class="flex-1 min-w-0 px-4 h-12 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-body text-cm-text uppercase tracking-widest placeholder:text-cm-text-3 placeholder:normal-case focus:outline-none focus:border-cm-accent/60 disabled:opacity-50 transition-colors duration-[var(--duration-cm)]"
            />
            <button type="submit"
              class="px-5 h-12 rounded-[var(--radius-cm-btn)] text-cm-body font-bold bg-cm-accent text-white hover:bg-cm-accent-hover transition-all duration-[var(--duration-cm)] disabled:opacity-50">
              Vào
            </button>
          </form>
          <p id="xc-error" class="hidden mt-3 text-cm-meta text-red-400"></p>
        </div>
      </div>

      <div id="xc-login-note" class="hidden mt-6 p-4 rounded-[var(--radius-cm-card)] bg-cm-surface border border-cm-border text-center"></div>

      <div id="xc-profile" class="hidden mt-6 p-4 rounded-[var(--radius-cm-card)] bg-cm-surface border border-cm-border flex items-center gap-3">
        <img id="xc-avatar" alt="" class="w-11 h-11 rounded-full border border-cm-border" />
        <div class="min-w-0">
          <p id="xc-name" class="text-cm-body font-bold text-cm-text truncate"></p>
          <p id="xc-logged" class="text-cm-meta text-emerald-400 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg>
            Đã đăng nhập — bạn có thể tạo hoặc vào phòng
          </p>
        </div>
      </div>

      <div id="xc-my" class="hidden mt-6">
        <h3 class="text-cm-body font-bold text-cm-text mb-3">Phòng của tôi</h3>
        <div id="xc-my-list" class="grid gap-2"></div>
      </div>
    </div>
  </main>

  <script>
    import { registerPageInit } from '../../scripts/lifecycle'
    import { getMe } from '../../scripts/session'

    registerPageInit(() => {
      const root = document.querySelector('[data-grid-page]')
      if (!root) return () => {}
      const createBtn = document.getElementById('xc-create') as HTMLButtonElement | null
      const joinForm = document.getElementById('xc-join') as HTMLFormElement | null
      const codeInput = document.getElementById('xc-code') as HTMLInputElement | null
      const errorEl = document.getElementById('xc-error') as HTMLElement | null
      const loginNote = document.getElementById('xc-login-note') as HTMLElement | null
      const profileBox = document.getElementById('xc-profile') as HTMLElement | null
      const avatarEl = document.getElementById('xc-avatar') as HTMLImageElement | null
      const nameEl = document.getElementById('xc-name') as HTMLElement | null
      const myBox = document.getElementById('xc-my') as HTMLElement | null
      const myList = document.getElementById('xc-my-list') as HTMLElement | null

      let authed = false

      // Guest: cache danh tính xem ké trên trình duyệt
      const GUEST_KEY = 'nllp_guest'
      function loadGuest(): { id: string; name: string } {
        try {
          const raw = localStorage.getItem(GUEST_KEY)
          if (raw) {
            const g = JSON.parse(raw)
            if (g && /^[a-zA-Z0-9]{12,32}$/.test(g.id) && g.name) return g
          }
        } catch {}
        const id = Array.from(crypto.getRandomValues(new Uint8Array(8)), (b) => b.toString(16).padStart(2, '0')).join('')
        const name = 'Khách-' + Math.floor(1000 + Math.random() * 9000)
        const g = { id, name }
        try { localStorage.setItem(GUEST_KEY, JSON.stringify(g)) } catch {}
        return g
      }
      const guest = loadGuest()

      function showErr(msg: string) {
        if (!errorEl) return
        errorEl.textContent = msg
        errorEl.classList.remove('hidden')
      }

      interface MeUser { id: string; username: string; global_name?: string | null; avatar?: string | null }

      async function whoami(): Promise<{ user: MeUser | null; admin: boolean }> {
        try {
          const { user, admin } = await getMe()
          return { user: user?.id ? (user as MeUser) : null, admin }
        } catch {
          return { user: null, admin: false }
        }
      }

      function setAuthed(authedState: boolean, user: MeUser | null, admin = false) {
        authed = authedState
        const canCreate = authed && admin
        if (createBtn) createBtn.disabled = !canCreate
        const adminLink = document.getElementById('xc-admin-link')
        if (adminLink) adminLink.classList.toggle('hidden', !admin)
        if (adminLink) adminLink.classList.toggle('flex', admin)
        if (loginNote) {
          // Chỉ admin tạo phòng/làm host; người khác vào xem dưới tư cách guest.
          loginNote.classList.toggle('hidden', canCreate)
          const guestOrUser = authed ? escapeName(user?.global_name || user?.username || '') : escapeName(guest.name)
          loginNote.innerHTML = `<p class="text-cm-body text-cm-text-2 mb-3">Vào với tư cách <b class="text-cm-text">${guestOrUser}</b> (xem + chat được). Chỉ admin mới được tạo phòng / làm host.</p>
            ${authed ? '' : '<button type="button" data-auth-open class="inline-flex items-center gap-2 h-11 px-5 rounded-[var(--radius-cm-btn)] text-cm-body font-bold bg-cm-accent text-white hover:bg-cm-accent-hover transition-colors duration-[var(--duration-cm)]">Đăng nhập</button>'}`
        }
        if (!profileBox) return
        profileBox.classList.toggle('hidden', !authed)
        if (authed && avatarEl && nameEl && user) {
          avatarEl.src = user.avatar
            ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=96`
            : '/logo-64.png'
          nameEl.textContent = user.global_name || user.username
        }
      }

      function escapeName(s: string): string {
        return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string)
      }

      async function go(code: string) {
        if (!/^[A-Z0-9]{4,8}$/.test(code)) {
          showErr('Mã phòng không hợp lệ.')
          return
        }
        const r = await fetch(`/api/xem-chung/${code}/join`, {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'x-guest-id': guest.id, 'x-guest-name': guest.name },
        }).catch(() => null)
        if (!r) return showErr('Không kết nối được server.')
        const d = await r.json()
        if (!d.ok || !d.room) return showErr(d.error || 'Không thể vào phòng.')
        window.location.href = `/xem-chung/${d.room.code}`
      }

      async function loadMy() {
        if (!myBox || !myList) return
        try {
          const res = await fetch('/api/xem-chung/mine', { credentials: 'same-origin' })
          const data = await res.json()
          const codes: string[] = data?.codes || []
          myBox.classList.remove('hidden')
          if (!codes.length) {
            myList.innerHTML = '<p class="text-cm-meta text-cm-text-3">Bạn chưa tham gia phòng nào.</p>'
            return
          }
          myList.innerHTML = codes.map((c) => `
            <a href="/xem-chung/${c}" class="flex items-center justify-between px-4 h-12 rounded-[var(--radius-cm-card)] bg-cm-surface border border-cm-border text-cm-body hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]">
              <span class="font-mono tracking-widest text-cm-text">${c}</span>
              <span class="flex items-center gap-1 text-cm-meta text-cm-text-3">
                Vào phòng
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 6L8.6 7.4 13.2 12l-4.6 4.6L10 18l6-6-6-6z"/></svg>
              </span>
            </a>
          `).join('')
        } catch {}
      }

      createBtn?.addEventListener('click', async () => {
        if (!authed) {
          showErr('Bạn chưa đăng nhập. Hãy đăng nhập Discord để tạo phòng.')
          return
        }
        createBtn.disabled = true
        createBtn.textContent = 'Đang tạo...'
        const r = await fetch('/api/xem-chung', { method: 'POST', credentials: 'same-origin' }).catch(() => null)
        if (!r) {
          createBtn.disabled = false
          createBtn.textContent = 'Tạo phòng mới'
          return showErr('Không kết nối được server.')
        }
        const d = await r.json()
        createBtn.disabled = false
        createBtn.textContent = 'Tạo phòng mới'
        if (!d.ok || !d.room) return showErr(d.error || 'Tạo phòng thất bại.')
        window.location.href = `/xem-chung/${d.room.code}`
      })

      joinForm?.addEventListener('submit', (e) => {
        e.preventDefault()
        if (codeInput) go(codeInput.value.trim().toUpperCase())
      })

void whoami().then(({ user, admin }) => {
        setAuthed(!!user, user, admin)
        if (user) void loadMy()
      })
    })
  </script>
</BaseLayout>