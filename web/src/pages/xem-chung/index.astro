---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Xem Chung" description="Tạo phòng xem phim cùng bạn bè tại Nô Lệ Làm Phim." noIndex>
  <main class="flex-1" data-grid-page>
    <div class="px-4 md:px-8 py-10 max-w-2xl mx-auto">
      <div class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-text-primary">Xem Chung</h1>
        <p class="text-text-secondary text-sm mt-2">
          Tạo phòng riêng, mời bạn bè bằng mã — mọi người cùng xem một bộ phim, không ai tua được.
          Chỉ phát sóng theo lịch của host.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div class="content-card p-5">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-9 h-9 rounded-xl glass-tile flex items-center justify-center text-lg">🎬</div>
            <div>
              <h2 class="text-base font-bold text-text-primary">Tạo phòng</h2>
              <p class="text-xs text-text-muted">Bạn là host, quyết định phim + giờ chiếu</p>
            </div>
          </div>
          <button id="xc-create" type="button"
            class="w-full px-5 py-3 rounded-xl text-sm font-bold tracking-wide bg-gradient-to-r from-[#FF6B9D] to-[#C44BED] text-white hover:brightness-110 transition-all disabled:opacity-50">
            Tạo phòng mới
          </button>
        </div>

        <div class="content-card p-5">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-9 h-9 rounded-xl glass-tile flex items-center justify-center text-lg">🔗</div>
            <div>
              <h2 class="text-base font-bold text-text-primary">Vào phòng</h2>
              <p class="text-xs text-text-muted">Nhập mã phòng được bạn bè gửi</p>
            </div>
          </div>
          <form id="xc-join" class="flex gap-2">
            <input
              id="xc-code"
              type="text"
              inputmode="text"
              autocapitalize="characters"
              autocomplete="off"
              maxlength="6"
              placeholder="ABC123"
              class="flex-1 min-w-0 px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-sm text-text-primary uppercase tracking-widest placeholder:text-text-muted placeholder:normal-case focus:outline-none focus:border-[#C44BED]/50"
            />
            <button type="submit"
              class="px-5 py-3 rounded-xl text-sm font-bold glass-tile-active text-white hover:brightness-110 transition-all">
              Vào
            </button>
          </form>
          <p id="xc-error" class="hidden mt-3 text-xs text-red-400"></p>
        </div>
      </div>

      <div id="xc-login-note" class="hidden mt-6 p-4 rounded-xl glass-tile text-center">
        <p class="text-sm text-text-secondary mb-3">Cần đăng nhập Discord để xem cùng nhau.</p>
        <a id="xc-login-btn" href="/api/auth/discord"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-[#5865F2] text-white hover:brightness-110 transition-all">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.036A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.373-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.1.248.198.374.292a.077.077 0 0 1-.006.129c-.597.345-1.226.635-1.873.892a.077.077 0 0 0-.04.106c.36.699.772 1.364 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          Đăng nhập bằng Discord
        </a>
      </div>

      <div id="xc-my" class="hidden mt-8">
        <h3 class="text-sm font-bold text-text-primary mb-3">Phòng của tôi</h3>
        <div id="xc-my-list" class="grid gap-2"></div>
      </div>
    </div>
  </main>

  <script>
    import { registerPageInit } from '../../scripts/lifecycle'

    registerPageInit(() => {
      const root = document.querySelector('[data-grid-page]')
      if (!root) return () => {}
      const createBtn = document.getElementById('xc-create') as HTMLButtonElement | null
      const joinForm = document.getElementById('xc-join') as HTMLFormElement | null
      const codeInput = document.getElementById('xc-code') as HTMLInputElement | null
      const errorEl = document.getElementById('xc-error') as HTMLElement | null
      const loginNote = document.getElementById('xc-login-note') as HTMLElement | null
      const myBox = document.getElementById('xc-my') as HTMLElement | null
      const myList = document.getElementById('xc-my-list') as HTMLElement | null

      function showErr(msg: string) {
        if (!errorEl) return
        errorEl.textContent = msg
        errorEl.classList.remove('hidden')
      }

      async function whoami(): Promise<boolean> {
        try {
          const r = await fetch('/api/auth/me', { credentials: 'same-origin' })
          const d = await r.json()
          return !!(d.user && d.user.sub)
        } catch {
          return false
        }
      }

      async function go(code: string) {
        if (!/^[A-Z0-9]{4,8}$/.test(code)) {
          showErr('Mã phòng không hợp lệ.')
          return
        }
        const r = await fetch(`/api/xem-chung/${code}/join`, { method: 'POST', credentials: 'same-origin' }).catch(() => null)
        if (!r) return showErr('Không kết nối được server.')
        const d = await r.json()
        if (!d.ok || !d.room) return showErr(d.error || 'Không thể vào phòng.')
        window.location.href = `/xem-chung/${d.room.code}`
      }

      async function loadMy() {
        if (!myBox || !myList) return
        try {
          const r = await fetch('/api/auth/me', { credentials: 'same-origin' })
          const d = await r.json()
          if (!(d.user && d.user.sub)) {
            loginNote?.classList.remove('hidden')
            return
          }
          const res = await fetch('/api/xem-chung/mine', { credentials: 'same-origin' })
          const data = await res.json()
          const codes: string[] = data?.codes || []
          myBox.classList.remove('hidden')
          if (!codes.length) {
            myList.innerHTML = '<p class="text-xs text-text-muted">Bạn chưa tham gia phòng nào.</p>'
            return
          }
          myList.innerHTML = codes.map((c) => `
            <a href="/xem-chung/${c}" class="flex items-center justify-between px-4 py-3 rounded-xl glass-tile text-sm hover:bg-white/5 transition-colors">
              <span class="font-mono tracking-widest">${c}</span>
              <span class="text-xs text-text-muted">Vào phòng →</span>
            </a>
          `).join('')
        } catch {}
      }

      createBtn?.addEventListener('click', async () => {
        createBtn.disabled = true
        createBtn.textContent = 'Đang tạo...'
        const r = await fetch('/api/xem-chung', { method: 'POST', credentials: 'same-origin' }).catch(() => null)
        if (!r) {
          createBtn.disabled = false
          createBtn.textContent = 'Tạo phòng mới'
          return showErr('Không kết nối được server. Bạn đã đăng nhập Discord chưa?')
        }
        const d = await r.json()
        createBtn.disabled = false
        createBtn.textContent = 'Tạo phòng mới'
        if (!d.ok || !d.room) return showErr(d.error || 'Tạo phòng thất bại.')
        window.location.href = `/xem-chung/${d.room.code}`
      })

      joinForm?.addEventListener('submit', (e) => {
        e.preventDefault()
        if (codeInput) go(codeInput.value.trim().toUpperCase())
      })

      loadMy()
    })
  </script>
</BaseLayout>