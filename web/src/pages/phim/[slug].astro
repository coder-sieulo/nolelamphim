---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SimilarMovies from '../../components/SimilarMovies.astro'
import MovieComments from '../../components/MovieComments.astro'
import FavoriteButton from '../../components/FavoriteButton.astro'
import EpisodeList from '../../components/EpisodeList.astro'
import Reveal from '../../components/Reveal.astro'
import RatingBox from '../../components/RatingBox.astro'
import ShareButton from '../../components/ShareButton.astro'
import XemChungButton from '../../components/XemChungButton.astro'
import ReportButton from '../../components/ReportButton.astro'
import ThemeBG from '../../components/ThemeBG.astro'
import { getMovieDetail, getMovieEpisodes } from '../../lib/api'
import { imgUrl } from '../../lib/img'
import { SITE_URL } from '../../lib/site'
import { breadcrumbLd } from '../../lib/seo'
import { getSessionUser, isAdmin } from '../../lib/auth'
import { getComments } from '../../lib/comments'
import { FaPlay, FaArrowLeft, FaXmark } from 'react-icons/fa6'

const slug = Astro.params.slug ?? ''

const [data, epRes] = await Promise.all([
  getMovieDetail(slug).catch(() => ({ status: false, movie: null })),
  getMovieEpisodes(slug),
])

if (!data.status || !data.movie) {
  return Astro.redirect('/404', 404)
}

const movie = data.movie
const episodes = epRes.status ? epRes.episodes : []
const viewer = await getSessionUser(Astro.cookies)
const canHost = isAdmin(viewer)
const commentData = await getComments(slug, 20, 0)

const metaTitle = movie.name
const metaDescription = movie.content
  ? movie.content.replace(/<[^>]*>/g, '').slice(0, 160)
  : `Xem phim ${movie.name} ${movie.year ? movie.year : ''} HD VietSub miễn phí.`
const image = movie.poster_url || movie.thumb_url
const metaKeywords = [
  movie.name,
  movie.origin_name,
  ...(Array.isArray(movie.category) ? movie.category.map((c) => c.name) : []),
].filter(Boolean).join(', ')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Movie',
  name: movie.name,
  alternateName: movie.origin_name,
  description: movie.content ? movie.content.replace(/<[^>]*>/g, '').slice(0, 300) : undefined,
  image: image || undefined,
  url: `${SITE_URL}/phim/${slug}`,
  year: movie.year,
  duration: movie.time,
  genre: Array.isArray(movie.category) ? movie.category.map((c) => c.name) : undefined,
  director: Array.isArray(movie.director) ? movie.director.map((d) => ({ '@type': 'Person', name: d })) : undefined,
  actor: Array.isArray(movie.actor) ? movie.actor.map((a) => ({ '@type': 'Person', name: a })) : undefined,
}

const chips = [movie.year, movie.quality, movie.lang, movie.time, movie.status].filter(Boolean)

function formatViewCount(v: number): string {
  if (v >= 1_000_000) return `${(v / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`
  if (v >= 1_000) return `${(v / 1_000).toFixed(1).replace(/\.0$/, '')}K`
  return String(v)
}

const tmdbVote = movie.tmdb?.vote_average && Number(movie.tmdb?.vote_average) > 0 ? movie.tmdb.vote_average : ''
const imdbId = movie.imdb?.id || ''

let keywordsList: string[] = []
if (movie.keywords) {
  keywordsList = Array.isArray(movie.keywords) ? movie.keywords : movie.keywords.split(', ')
}

const breadcrumb = [
  { name: 'Trang chủ', path: '/' },
  { name: movie.name, path: `/phim/${slug}` },
]
const ogImage = `${SITE_URL}/og/${slug}.png`

function youtubeEmbedUrl(url: string | null | undefined): string {
  if (!url) return ''
  try {
    const u = new URL(url)
    if (u.hostname === 'youtu.be') {
      return u.pathname.slice(1) ? `https://www.youtube-nocookie.com/embed/${u.pathname.slice(1)}` : ''
    }
    if (u.hostname.endsWith('youtube.com')) {
      const id = u.searchParams.get('v') || ''
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : url
    }
    if (u.hostname.endsWith('youtube-nocookie.com')) return url
    return ''
  } catch {
    return ''
  }
}

const trailerEmbed = youtubeEmbedUrl(movie.trailer_url)
---

<BaseLayout title={metaTitle} description={metaDescription} keywords={metaKeywords} ogImage={ogImage}>
  <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />
  <script is:inline set:html={breadcrumbLd(breadcrumb)} type="application/ld+json" />
  <ThemeBG name={slug} />

  <div class="px-4 md:px-8 py-6">
    <div class="relative h-[35vh] md:h-[45vh] rounded-2xl overflow-hidden mb-6 glass-frame">
      {
        image ? (
          <img
            src={imgUrl(image, 1600)}
            alt={movie.name}
            class="w-full h-full object-cover ken-burns"
          />
        ) : (
          <div class="w-full h-full bg-bg-card flex items-center justify-center text-text-muted">
            No image
          </div>
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-bg-dark via-bg-dark/30 to-transparent" />
    </div>

    <Reveal>
      <div class="space-y-5">
        <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
          <div class="min-w-0 flex-1 basis-52">
            <h1 class="text-xl sm:text-2xl font-bold text-text-primary">{movie.name}</h1>
            {movie.origin_name && <p class="text-sm text-text-muted mt-1">{movie.origin_name}</p>}
          </div>
          <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
            {trailerEmbed && (
              <button
                id="trailer-open"
                type="button"
                class="px-4 py-2 rounded-xl text-xs font-medium transition-all duration-200 glass-tile text-text-secondary hover:text-white"
                data-embed={trailerEmbed}
              >
                <FaPlay className="w-3.5 h-3.5 inline-block mr-1 -mt-0.5" />
                Trailer
              </button>
            )}
            <RatingBox slug={slug} name={movie.name} />
            {canHost && <XemChungButton slug={slug} name={movie.name} thumb={image || ''} servers={episodes} />}
            <ShareButton slug={slug} name={movie.name} />
            <ReportButton slug={slug} name={movie.name} />
            <FavoriteButton id={movie._id} name={movie.name} slug={slug} thumb={movie.thumb_url || ''} vote={movie.tmdb?.vote_average} />
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {
            chips.map((chip) => (
              <span class="px-3 py-1 rounded-lg glass-chip text-text-secondary text-xs">
                {chip}
              </span>
            ))
          }
          {
            movie.view != null && movie.view > 0 && (
              <span class="px-3 py-1 rounded-lg glass-chip text-text-secondary text-xs">
                {formatViewCount(movie.view)} lượt xem
              </span>
            )
          }
          {
            tmdbVote && (
              <span class="px-3 py-1 rounded-lg glass-chip text-text-secondary text-xs">
                ★ TMDB {tmdbVote}
              </span>
            )
          }
          {
            imdbId && (
              <a
                href={`https://www.imdb.com/title/${imdbId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-1 rounded-lg glass-chip text-text-secondary text-xs hover:text-white transition-colors"
              >
                IMDb
              </a>
            )
          }
          {
            movie.sub_docquyen && (
              <span class="px-3 py-1 rounded-lg bg-gradient-to-r from-[#FF6B9D]/15 to-[#4A9EFF]/15 text-[#FF6B9D] text-xs font-medium">
                Vietsub độc quyền
              </span>
            )
          }
          {
            movie.episode_current && (
              <span class="px-3 py-1 rounded-lg bg-gradient-to-r from-[#FF6B9D]/15 to-[#4A9EFF]/15 text-[#FF6B9D] text-xs font-medium">
                {movie.episode_current}
              </span>
            )
          }
        </div>

        {
          movie.content && (
            <div class="content-card px-5 py-4">
              <h3 class="text-sm font-semibold text-text-primary mb-2">Nội dung</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{movie.content}</p>
            </div>
          )
        }

        {
          movie.actor && (
            <div>
              <h3 class="text-sm font-semibold text-text-primary mb-2">Diễn viên</h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                {Array.isArray(movie.actor) ? movie.actor.join(', ') : movie.actor}
              </p>
            </div>
          )
        }

        {
          movie.director && (
            <div>
              <h3 class="text-sm font-semibold text-text-primary mb-2">Đạo diễn</h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                {Array.isArray(movie.director) ? movie.director.join(', ') : movie.director}
              </p>
            </div>
          )
        }

        {
          movie.category && movie.category.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {
                Array.isArray(movie.category) &&
                  movie.category.map((cat) => (
                    <a
                     
                      href={`/the-loai/${typeof cat === 'string' ? cat : cat.slug}`}
                      class="px-3 py-1.5 rounded-xl glass-tile text-text-muted text-xs"
                    >
                      {typeof cat === 'string' ? cat : cat.name}
                    </a>
                  ))
              }
            </div>
          )
        }

        {
          keywordsList.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {
                keywordsList.slice(0, 10).map((kw) => (
                  <a
                    href={`/search?q=${encodeURIComponent(kw)}`}
                    class="px-2.5 py-1 rounded-lg glass-chip text-text-muted text-[10px]"
                  >
                    {kw}
                  </a>
                ))
              }
            </div>
          )
        }

        {
          episodes.length > 0 && <EpisodeList slug={slug} servers={episodes} />
        }

        <SimilarMovies categories={movie.category ?? []} excludeSlug={slug} />

        <MovieComments slug={slug} comments={commentData.comments} total={commentData.total} user={viewer} isAdmin={canHost} />

        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl glass-tile text-text-secondary text-xs"
        >
          <FaArrowLeft className="w-3.5 h-3.5" />
          Quay lại
        </a>
      </div>
    </Reveal>
  </div>

  {trailerEmbed && (
    <div
      id="trailer-modal"
      class="hidden fixed inset-0 z-[80] flex items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-label="Xem trailer"
    >
      <div id="trailer-backdrop" class="absolute inset-0 bg-black/85"></div>
      <div class="relative w-full max-w-3xl aspect-video rounded-2xl overflow-hidden glass-frame bg-black">
        <button
          id="trailer-close"
          type="button"
          class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-black/70 text-white/80 flex items-center justify-center hover:bg-black/90 transition-colors"
          aria-label="Đóng trailer"
        >
          <FaXmark className="w-4 h-4" />
        </button>
        <iframe
          id="trailer-frame"
          title={`Trailer ${movie.name}`}
          class="w-full h-full"
          allow="autoplay; encrypted-media; fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  import { registerPageInit } from '../../scripts/lifecycle'

  registerPageInit(() => {
    const openBtn = document.getElementById('trailer-open')
    const modal = document.getElementById('trailer-modal')
    const closeBtn = document.getElementById('trailer-close')
    const backdrop = document.getElementById('trailer-backdrop')
    const frame = document.getElementById('trailer-frame') as HTMLIFrameElement | null
    if (!openBtn || !modal) return () => {}
    const src = openBtn.dataset.embed || ''

    function show(v: boolean) {
      modal?.classList.toggle('hidden', !v)
      if (v && frame && src) frame.src = src
      else if (!v && frame) frame.src = ''
    }

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') show(false)
    }

    openBtn.addEventListener('click', () => show(true))
    closeBtn?.addEventListener('click', () => show(false))
    backdrop?.addEventListener('click', () => show(false))
    document.addEventListener('keydown', onKey)
    return () => {
      show(false)
      document.removeEventListener('keydown', onKey)
    }
  })
</script>
