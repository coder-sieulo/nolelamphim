---
/**
 * Trang chi tiết phim — CINEMA MINIMAL (Phase 4).
 * Backdrop 1 lớp, CTA row tối thiểu, tabs nội dung, sidebar thông tin kỹ thuật,
 * CTA sticky dưới cùng trên mobile. Không glass/gradient.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Tabs from '../../components/Tabs.astro'
import SimilarMovies from '../../components/SimilarMovies.astro'
import MovieComments from '../../components/MovieComments.astro'
import FavoriteButton from '../../components/FavoriteButton.astro'
import EpisodeList from '../../components/EpisodeList.astro'
import RatingBox from '../../components/RatingBox.astro'
import ShareButton from '../../components/ShareButton.astro'
import XemChungButton from '../../components/XemChungButton.astro'
import ReportButton from '../../components/ReportButton.astro'
import ThemeBG from '../../components/ThemeBG.astro'
import Breadcrumb from '../../components/ui/Breadcrumb.astro'
import { getMovieDetail, getMovieEpisodes } from '../../lib/api.server'
import { ratingStats } from '../../lib/catalogue'
import { imgUrl, imgProxyUrl, imgSrcSet } from '../../lib/img'
import { SITE_URL } from '../../lib/site'
import { breadcrumbLd } from '../../lib/seo'
import { FaPlay, FaArrowLeft } from 'react-icons/fa6'
import { slugifyName } from '../../lib/slugify'

/**
 * 4.2 — HTML của trang này phải **công khai thật** (byte-identical với mọi người
 * dùng) để bật cache CDN. Vì vậy KHÔNG đọc session/cookie ở SSR nữa:
 *
 *  - Không gọi `getSessionUser` / `isAdmin` / `getComments`.
 *  - Phần theo người dùng (bình luận, nút XemChung cho admin, yêu thích, đánh giá,
 *    "tiếp tục xem") do client lo qua `/api/auth/me` + API tương ứng.
 *
 * ⚠️ Tuyệt đối không thêm lại `Astro.cookies`/session vào file này.
 */
const slug = Astro.params.slug ?? ''

const [data, epRes] = await Promise.all([
  getMovieDetail(slug).catch(() => ({ status: false, movie: null })),
  getMovieEpisodes(slug),
])

if (!data.status || !data.movie) {
  return Astro.redirect('/404', 404)
}

const movie = data.movie
const episodes = epRes.status ? epRes.episodes : []
const communityRating = await ratingStats(slug).catch(() => null)

const metaTitle = movie.name
const metaDescription = movie.content
  ? movie.content.replace(/<[^>]*>/g, '').slice(0, 160)
  : `Xem phim ${movie.name} ${movie.year ? movie.year : ''} HD VietSub miễn phí.`
const image = movie.poster_url || movie.thumb_url
const metaKeywords = [
  movie.name,
  movie.origin_name,
  ...(Array.isArray(movie.category) ? movie.category.map((c) => c.name) : []),
].filter(Boolean).join(', ')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Movie',
  name: movie.name,
  alternateName: movie.origin_name,
  description: movie.content ? movie.content.replace(/<[^>]*>/g, '').slice(0, 300) : undefined,
  image: image || undefined,
  url: `${SITE_URL}/phim/${slug}`,
  year: movie.year,
  duration: movie.time,
  genre: Array.isArray(movie.category) ? movie.category.map((c) => c.name) : undefined,
  director: Array.isArray(movie.director) ? movie.director.map((d) => ({ '@type': 'Person', name: d })) : undefined,
  actor: Array.isArray(movie.actor) ? movie.actor.map((a) => ({ '@type': 'Person', name: a })) : undefined,
  // Điểm cộng đồng (3.5): chỉ khai báo khi thật có lượt đánh giá — Google phạt
  // `aggregateRating` rỗng/không khớp nội dung hiển thị.
  ...(communityRating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: communityRating.average,
          ratingCount: communityRating.count,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
}

function formatViewCount(v: number): string {
  if (v >= 1_000_000) return `${(v / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`
  if (v >= 1_000) return `${(v / 1_000).toFixed(1).replace(/\.0$/, '')}K`
  return String(v)
}

const tmdbVote = movie.tmdb?.vote_average && Number(movie.tmdb?.vote_average) > 0 ? movie.tmdb.vote_average : ''
const imdbId = movie.imdb?.id || ''

let keywordsList: string[] = []
if (movie.keywords) {
  keywordsList = Array.isArray(movie.keywords) ? movie.keywords : movie.keywords.split(', ')
}

const breadcrumb = [
  { name: 'Trang chủ', path: '/' },
  { name: movie.name, path: `/phim/${slug}` },
]

const crumbItems = [
  { label: 'Trang chủ', href: '/' },
  { label: movie.name, href: `/phim/${slug}` },
]
const ogImage = `${SITE_URL}/og/${slug}.png`

function youtubeEmbedUrl(url: string | null | undefined): string {
  if (!url) return ''
  try {
    const u = new URL(url)
    if (u.hostname === 'youtu.be') {
      return u.pathname.slice(1) ? `https://www.youtube-nocookie.com/embed/${u.pathname.slice(1)}` : ''
    }
    if (u.hostname.endsWith('youtube.com')) {
      const id = u.searchParams.get('v') || ''
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : url
    }
    if (u.hostname.endsWith('youtube-nocookie.com')) return url
    return ''
  } catch {
    return ''
  }
}

const trailerEmbed = youtubeEmbedUrl(movie.trailer_url)

/* ─── Dữ liệu layout ─── */
const firstEpisode = episodes[0]?.list?.[0]
const watchHref = firstEpisode?.slug ? `/xem/${slug}/${firstEpisode.slug}` : ''

const hasActor = Array.isArray(movie.actor) && movie.actor.length > 0
const hasDirector = Array.isArray(movie.director) && movie.director.length > 0

const metaParts = [
  movie.year ? String(movie.year) : '',
  movie.quality || '',
  movie.lang || '',
  movie.time || '',
  movie.status || '',
  movie.episode_current || '',
  movie.view != null && movie.view > 0 ? `${formatViewCount(movie.view)} lượt xem` : '',
].filter(Boolean)

const countryNames = Array.isArray(movie.country)
  ? movie.country.map((c) => (typeof c === 'string' ? c : c.name)).join(', ')
  : ''

function typeLabel(t: string | undefined): string {
  if (t === 'series') return 'Phim bộ'
  if (t === 'single') return 'Phim lẻ'
  return t || ''
}

const techRows = [
  { k: 'Năm', v: movie.year ? String(movie.year) : '' },
  { k: 'Chất lượng', v: movie.quality || '' },
  { k: 'Quốc gia', v: countryNames },
  { k: 'Loại phim', v: typeLabel(movie.type) },
  { k: 'Thời lượng', v: movie.time || '' },
  { k: 'Trạng thái', v: movie.status || '' },
  ...(hasDirector
    ? [
        {
          k: 'Đạo diễn',
          v: movie.director!.map((d: string) => ({ name: d, slug: `/dao-dien/${slugifyName(d)}` })),
        },
      ]
    : []),
].filter((r: any) => r.v)

const tabs = [
  { id: 'tong-quan', label: 'Tổng quan' },
  ...(trailerEmbed ? [{ id: 'trailer', label: 'Trailer' }] : []),
  ...(hasActor ? [{ id: 'dien-vien', label: 'Diễn viên' }] : []),
  ...(episodes.length > 0 ? [{ id: 'tap-phim', label: 'Tập phim' }] : []),
  { id: 'danh-gia', label: 'Đánh giá' },
]

const chipClass =
  'px-3 py-1.5 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]'
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  keywords={metaKeywords}
  ogImage={ogImage}
  cache="public"
  sMaxAge={300}
  staleWhileRevalidate={3600}
  island={{
    movieSlug: slug,
    movieName: movie.name,
    movieThumb: movie.thumb_url || '',
    movieYear: movie.year ? String(movie.year) : '',
    movieQuality: movie.quality || '',
    movieSource: 'vsmov',
    movieType: movie.type || '',
    movieGenres: Array.isArray(movie.category)
      ? movie.category.map((c) => (typeof c === 'string' ? c : c.name)).join('|')
      : '',
    episodeSlug: episodes[0]?.list?.[0]?.slug || '',
    episodeTotal: episodes[0]?.list?.length || 0,
  }}
>
  <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />
  <script is:inline set:html={breadcrumbLd(breadcrumb)} type="application/ld+json" />
  <ThemeBG name={slug} />

  <div class="px-4 sm:px-6 md:px-8 pt-6 pb-32 lg:pb-12 max-w-[1600px] mx-auto w-full">
    <Breadcrumb items={crumbItems} class="mb-4" />

    {/* Backdrop 1 lớp — không ken-burns, không glass-frame */}
    <div class="relative h-[34vh] sm:h-[44vh] lg:h-[50vh] rounded-[var(--radius-cm-card)] overflow-hidden mb-6 bg-cm-surface">
      {
        image ? (
          <img
            src={imgUrl(image, 1600)}
            srcset={imgSrcSet(image)}
            sizes="100vw"
            data-proxy={imgProxyUrl(image, 1600)}
            alt={movie.name}
            width="1600"
            height="900"
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-cm-meta text-cm-text-3">
            No image
          </div>
        )
      }
      <div class="absolute inset-x-0 bottom-0 h-[60%] bg-gradient-to-t from-cm-bg via-cm-bg/70 to-transparent" aria-hidden="true"></div>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_300px] gap-x-10 gap-y-8">
      {/* ─── Cột chính ─── */}
      <div class="min-w-0">
        <h1 class="text-cm-h1 font-bold text-cm-text tracking-tight">{movie.name}</h1>
        {movie.origin_name && <p class="text-cm-body text-cm-text-3 mt-1.5">{movie.origin_name}</p>}

        <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-cm-meta text-cm-text-2">
          {tmdbVote && (
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-cm-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
              </svg>
              TMDB {tmdbVote}
            </span>
          )}
          {metaParts.length > 0 && <span>{metaParts.join(' · ')}</span>}
          {movie.sub_docquyen && (
            <span class="inline-flex items-center rounded-[4px] border border-cm-border-strong bg-cm-surface px-1.5 py-0.5 text-[10px] font-medium text-cm-text-2">
              Vietsub độc quyền
            </span>
          )}
        </p>

        {/* CTA row — 1 primary duy nhất */}
        <div class="mt-6 flex flex-wrap items-center gap-2.5">
          {
            watchHref && (
              <a
                href={watchHref}
                class="inline-flex h-11 items-center gap-2 rounded-[var(--radius-cm-btn)] bg-cm-accent px-6 text-sm font-semibold text-white transition-colors duration-[var(--duration-cm)] hover:bg-cm-accent-hover"
              >
                <FaPlay className="w-3.5 h-3.5" />
                Xem ngay
              </a>
            )
          }
          <FavoriteButton id={movie._id} name={movie.name} slug={slug} thumb={movie.thumb_url || ''} vote={movie.tmdb?.vote_average} variant="action" />
          <FavoriteButton id={movie._id} name={movie.name} slug={slug} thumb={movie.thumb_url || ''} vote={movie.tmdb?.vote_average} variant="icon" />
          {/* Nút tạo phòng XemChung: render công khai (không phụ thuộc session), script
              `xc-quick` tự ẩn với người không phải admin (4.2). */}
          <XemChungButton slug={slug} name={movie.name} thumb={image || ''} servers={episodes} />
          <div id="phim-resume" class="hidden"></div>
          <ShareButton slug={slug} name={movie.name} />
        </div>

        {/* Tabs */}
        <div class="mt-8">
          <Tabs tabs={tabs}>
            {/* Tổng quan */}
            <section data-panel="tong-quan" class="movie-panel">
              {
                movie.content && (
                  <>
                    <div id="movie-desc" class="movie-desc text-cm-body leading-relaxed">{movie.content}</div>
                    <button
                      id="desc-toggle"
                      type="button"
                      class="mt-2 inline-flex items-center gap-1 text-cm-meta font-medium text-cm-text-3 hover:text-cm-text transition-colors duration-[var(--duration-cm)]"
                      aria-expanded="false"
                    >
                      <span class="desc-toggle-label">Xem thêm</span>
                      <svg class="desc-toggle-icon w-3.5 h-3.5 transition-transform duration-[var(--duration-cm)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                  </>
                )
              }

              {
                Array.isArray(movie.category) && movie.category.length > 0 && (
                  <div class="mt-6">
                    <h3 class="text-cm-meta font-semibold uppercase tracking-wide text-cm-text-3 mb-3">Thể loại</h3>
                    <div class="flex flex-wrap gap-1.5">
                      {
                        movie.category.map((cat) => (
                          <a href={`/the-loai/${typeof cat === 'string' ? cat : cat.slug}`} class={chipClass}>
                            {typeof cat === 'string' ? cat : cat.name}
                          </a>
                        ))
                      }
                    </div>
                  </div>
                )
              }

              {
                keywordsList.length > 0 && (
                  <div class="mt-5">
                    <div class="flex flex-wrap gap-1.5">
                      {
                        keywordsList.slice(0, 10).map((kw) => (
                          <a href={`/search?q=${encodeURIComponent(kw)}`} class="px-2.5 py-1 rounded-[4px] bg-cm-surface border border-cm-border text-cm-meta text-cm-text-3 hover:text-cm-text-2 hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]">
                            {kw}
                          </a>
                        ))
                      }
                    </div>
                  </div>
                )
              }

              <div class="mt-8">
                <SimilarMovies
                  categories={movie.category ?? []}
                  countries={movie.country ?? []}
                  director={movie.director}
                  actor={movie.actor}
                  year={movie.year}
                  excludeSlug={slug}
                />
              </div>
            </section>

            {/* Trailer — lazy iframe */}
            {
              trailerEmbed && (
                <section data-panel="trailer" class="movie-panel" hidden>
                  <div class="relative aspect-video rounded-[var(--radius-cm-card)] overflow-hidden border border-cm-border bg-black">
                    <iframe
                      data-src={trailerEmbed}
                      title={`Trailer ${movie.name}`}
                      class="absolute inset-0 w-full h-full"
                      allow="autoplay; encrypted-media; fullscreen"
                      allowfullscreen
                    ></iframe>
                  </div>
                </section>
              )
            }

            {/* Diễn viên */}
            {
              (hasActor || hasDirector) && (
                <section data-panel="dien-vien" class="movie-panel" hidden>
                  <div class="flex flex-col gap-5">
                    {hasActor && (
                      <div>
                        <h3 class="text-cm-meta font-semibold uppercase tracking-wide text-cm-text-3 mb-2">Diễn viên</h3>
                        <p class="text-cm-body text-cm-text-2 leading-relaxed flex flex-wrap gap-x-2 gap-y-1">
                          {movie.actor!.map((a: string, i: number) => (
                            <>
                              <a href={`/dien-vien/${slugifyName(a)}`} class="hover:text-cm-text underline-offset-4 hover:underline">{a}</a>
                              {i < movie.actor!.length - 1 && <span class="text-cm-text-3">,</span>}
                            </>
                          ))}
                        </p>
                      </div>
                    )}
                    {hasDirector && (
                      <div>
                        <h3 class="text-cm-meta font-semibold uppercase tracking-wide text-cm-text-3 mb-2">Đạo diễn</h3>
                        <p class="text-cm-body text-cm-text-2 leading-relaxed flex flex-wrap gap-x-2 gap-y-1">
                          {movie.director!.map((d: string, i: number) => (
                            <>
                              <a href={`/dao-dien/${slugifyName(d)}`} class="hover:text-cm-text underline-offset-4 hover:underline">{d}</a>
                              {i < movie.director!.length - 1 && <span class="text-cm-text-3">,</span>}
                            </>
                          ))}
                        </p>
                      </div>
                    )}
                  </div>
                </section>
              )
            }

            {/* Tập phim */}
            {
              episodes.length > 0 && (
                <section data-panel="tap-phim" class="movie-panel" hidden>
                  <EpisodeList slug={slug} servers={episodes} />
                </section>
              )
            }

            {/* Đánh giá */}
            <section data-panel="danh-gia" class="movie-panel" hidden>
              <div class="mb-7 flex flex-col items-start gap-2">
                <p class="text-cm-h3 font-semibold text-cm-text">Bạn thấy phim này thế nào?</p>
                <p class="text-cm-meta text-cm-text-3 -mt-1">Chọn 1 trong 5 mức độ — lưu vào tài khoản khi đăng nhập</p>
                <RatingBox slug={slug} name={movie.name} />
                {
                  communityRating && (
                    <p class="text-cm-meta text-cm-text-2 mt-1 inline-flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-cm-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                      </svg>
                      <span class="font-semibold text-cm-text">{communityRating.average.toFixed(1)}</span>
                      <span class="text-cm-text-3">· {communityRating.count} lượt đánh giá</span>
                    </p>
                  )
                }
              </div>
              <MovieComments slug={slug} />
            </section>
          </Tabs>
        </div>

        {/* Chân trang phim */}
        <div class="mt-14 flex items-center gap-3 border-t border-cm-border pt-6">
          <a
            href="/"
            class="inline-flex h-9 items-center gap-2 rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface/80 px-3.5 text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]"
          >
            <FaArrowLeft className="w-3.5 h-3.5" />
            Quay lại
          </a>
          <span class="flex-1"></span>
          <ReportButton slug={slug} name={movie.name} />
        </div>
      </div>

      {/* ─── Sidebar thông tin kỹ thuật (desktop) ─── */}
      <aside class="hidden lg:block">
        <h3 class="text-cm-meta font-semibold uppercase tracking-wide text-cm-text-3 mb-3">Thông tin phim</h3>
        <dl class="tech-list">
          {
            techRows.map((r: any) => (
              <div class="tech-row">
                <dt>{r.k}</dt>
                <dd>
                  {Array.isArray(r.v)
                    ? r.v.map((item: any, i: number) => (
                        <>
                          {typeof item === 'string' ? (
                            item
                          ) : (
                            <a href={item.slug} class="hover:text-cm-text hover:underline underline-offset-4">
                              {item.name}
                            </a>
                          )}
                          {i < r.v.length - 1 && <span class="text-cm-text-3">, </span>}
                        </>
                      ))
                    : r.v}
                </dd>
              </div>
            ))
          }
          {
            imdbId && (
              <div class="tech-row">
                <dt>IMDb</dt>
                <dd>
                  <a
                    href={`https://www.imdb.com/title/${imdbId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-cm-accent hover:text-cm-accent-hover transition-colors duration-[var(--duration-cm)]"
                  >
                    Xem điểm
                  </a>
                </dd>
              </div>
            )
          }
        </dl>

        {
          Array.isArray(movie.category) && movie.category.length > 0 && (
            <div class="mt-7">
              <h3 class="text-cm-meta font-semibold uppercase tracking-wide text-cm-text-3 mb-3">Thể loại</h3>
              <div class="flex flex-wrap gap-1.5">
                {
                  movie.category.map((cat) => (
                    <a href={`/the-loai/${typeof cat === 'string' ? cat : cat.slug}`} class={chipClass}>
                      {typeof cat === 'string' ? cat : cat.name}
                    </a>
                  ))
                }
              </div>
            </div>
          )
        }
      </aside>
    </div>
  </div>

  {/* CTA sticky mobile — nằm trên bottom-nav */}
  <div class="mobile-cta">
    <div class="flex items-center gap-2.5">
      {
        watchHref && (
          <a
            href={watchHref}
            class="flex-1 inline-flex h-11 items-center justify-center gap-2 rounded-[var(--radius-cm-btn)] bg-cm-accent text-sm font-semibold text-white transition-colors duration-[var(--duration-cm)] hover:bg-cm-accent-hover"
          >
            <FaPlay className="w-3.5 h-3.5" />
            Xem ngay
          </a>
        )
      }
      <FavoriteButton id={movie._id} name={movie.name} slug={slug} thumb={movie.thumb_url || ''} vote={movie.tmdb?.vote_average} variant="icon" />
      <ShareButton slug={slug} name={movie.name} />
    </div>
  </div>
</BaseLayout>

<script>
  import { registerPageInit } from '../../scripts/lifecycle'
  import { getRecent } from '../../scripts/store'
  import { escapeHTML } from '../../scripts/cards'
  import { imgUrl } from '../../lib/img'

  registerPageInit(() => {
    const desc = document.getElementById('movie-desc')
    const toggle = document.getElementById('desc-toggle')
    if (desc && toggle) {
      toggle.addEventListener('click', () => {
        const expanded = desc.classList.toggle('expanded')
        toggle.setAttribute('aria-expanded', String(expanded))
        const label = toggle.querySelector('.desc-toggle-label')
        if (label) label.textContent = expanded ? 'Thu gọn' : 'Xem thêm'
        const icon = toggle.querySelector('.desc-toggle-icon')
        if (icon) icon.classList.toggle('rotate-180', expanded)
      })
    }
    try {
      const slug = (document.querySelector('meta[property="og:url"]') as HTMLMetaElement | null)?.content
        ?.split('/')
        ?.filter(Boolean)
        ?.pop() || window.location.pathname.split('/').filter(Boolean).pop() || ''
      const hist = getRecent()
      const item = hist.find((r) => r.slug === slug)
      const box = document.getElementById('phim-resume')
      if (box && item && item.episodeSlug) {
        const epName = item.episode || ''
        const pos = typeof item.position === 'number' && typeof item.duration === 'number' && item.duration > 0
          ? Math.round((item.position / item.duration) * 100)
          : 0
        const href = `/xem/${escapeHTML(item.slug)}/${escapeHTML(item.episodeSlug)}`
        box.className = 'mt-3'
        box.innerHTML = `
          <a href="${href}" class="group inline-flex w-full items-center gap-3 rounded-[var(--radius-cm-card)] border border-cm-border bg-cm-surface/80 px-3.5 py-2.5 text-sm text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]">
            <div class="relative w-12 h-16 shrink-0 overflow-hidden rounded-[var(--radius-cm-card)]">
              ${item.thumb ? `<img src="${escapeHTML(imgUrl(item.thumb, 200))}" alt="" class="w-full h-full object-cover" />` : '<div class="w-full h-full bg-cm-surface"></div>'}
              ${pos > 5 ? `<span class="absolute inset-x-0 bottom-0 h-[2px]" style="background:var(--color-cm-accent);width:${pos}%"></span>` : ''}
            </div>
            <div class="min-w-0">
              <p class="font-medium truncate">Tiếp tục xem • ${escapeHTML(epName)}</p>
              ${pos > 5 ? `<p class="text-cm-meta text-cm-text-3">${pos}% đã xem</p>` : `<p class="text-cm-meta text-cm-text-3">Tiếp tục ngay</p>`}
            </div>
            <span class="ml-auto text-cm-meta text-cm-text-3 group-hover:text-cm-text">Xem tiếp</span>
          </a>
        `
        box.classList.remove('hidden')
      }
    } catch {}
    return () => {}
  })
</script>