---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { listCuratedLists } from '../../lib/curated'
import { imgProxyUrl } from '../../lib/img'
import { FaLayerGroup } from 'react-icons/fa6'

const lists = await listCuratedLists()
---

<BaseLayout title="Bộ sưu tập phim" description="Các bộ sưu tập phim biên tập tuyển chọn" cache="public" sMaxAge={600} staleWhileRevalidate={1800}>
  <main class="px-4 sm:px-6 md:px-8 py-6 space-y-6">
    <header class="flex items-center gap-3">
      <FaLayerGroup className="w-5 h-5 text-cm-text-3" />
      <h1 class="text-2xl sm:text-3xl font-bold text-cm-text">Bộ sưu tập</h1>
    </header>

    {lists.length === 0 ? (
      <div class="text-center py-12 text-cm-text-2">Chưa có bộ sưu tập biên tập.</div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {lists.map((l) => (
          <a href={`/bo-suu-tap/${l.slug}`} class="group relative rounded-[var(--radius-cm-card)] overflow-hidden border border-cm-border bg-cm-surface hover:ring-1 hover:ring-cm-border-strong transition-all">
            <div class="aspect-[16/9] relative">
              {l.cover ? (
                <img src={imgProxyUrl(l.cover, 640)} alt={l.title} loading="lazy" class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-cm-accent/20 to-cm-surface"></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-4">
                <h2 class="text-lg font-semibold text-white">{l.title}</h2>
                {l.description && <p class="text-sm text-white/80 mt-1 line-clamp-2">{l.description}</p>}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
</BaseLayout>
