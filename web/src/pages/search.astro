---
/**
 * /search — render shell NGAY, không chờ vsmov (trước đây await searchMovies
 * server-side → TTFB chậm khi vsmov chậm / Vercel cold start).
 * Kết quả được SearchClient tự tải theo URL (?q= / ?f= / ?p=) trên client.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SearchClient from '../components/SearchClient.astro'

const params = Astro.url.searchParams
const q = params.get('q') ?? ''
---

<BaseLayout title="Tìm kiếm phim" description="Tìm kiếm phim theo từ khoá, thể loại, quốc gia, năm tại Nô Lệ Làm Phim.">
  <SearchClient initialQuery={q} />
</BaseLayout>