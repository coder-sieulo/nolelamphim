---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ListingPage from '../../components/ListingPage.astro'
import { getMoviesByYear, getYears } from '../../lib/api'
import { breadcrumbLd } from '../../lib/seo'
import type { Movie, ListResponse } from '../../lib/types'

export const prerender = true
export const revalidate = 60
export const fallback = 'blocking'

export async function getStaticPaths() {
  const years = await getYears().catch(() => null)
  return (years?.data?.items ?? []).map((y) => ({ params: { slug: String(y.slug) } }))
}

const slug = Astro.params.slug ?? ''

const empty: ListResponse<Movie> = { status: false, items: [] as Movie[] }
const data = await getMoviesByYear(slug, { page: 1, limit: 24 }).catch(() => empty)

const title = `Phim năm ${slug}`
const desc = `Xem các bộ phim ra mắt năm ${slug}, hay nhất với chất lượng HD VietSub miễn phí tại Nô Lệ Làm Phim.`

const breadcrumb = [
  { name: 'Trang chủ', path: '/' },
  { name: 'Danh mục', path: '/search' },
  { name: title, path: `/nam/${slug}` },
]
const crumb = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Danh mục', href: '/search' },
  { label: `Năm ${slug}` },
]
---

<BaseLayout title={title} description={desc}>
  <script is:inline set:html={breadcrumbLd(breadcrumb)} type="application/ld+json" />
  <ListingPage
    title={title}
    desc={desc}
    crumb={crumb}
    items={data.items ?? []}
    totalPages={data.pagination?.totalPages}
    path={`/nam/${slug}`}
    options={{ type: true, status: true }}
  />
</BaseLayout>