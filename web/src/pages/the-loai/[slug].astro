---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ListingPage from '../../components/ListingPage.astro'
import { getMoviesByCategory, getCategories } from '../../lib/api'
import { breadcrumbLd } from '../../lib/seo'
import type { Movie, ListResponse } from '../../lib/types'

export const prerender = true
export const revalidate = 60
export const fallback = 'blocking'

export async function getStaticPaths() {
  const cats = await getCategories().catch(() => null)
  return (cats?.data?.items ?? []).map((c) => ({ params: { slug: c.slug } }))
}

const slug = Astro.params.slug ?? ''
const name = slug.charAt(0).toUpperCase() + slug.slice(1)

const cats = await getCategories().catch(() => null)
const cat = cats?.data?.items?.find((c) => c.slug === slug)
const title = cat ? `Phim ${cat.name}` : `Phim ${name}`
const desc = `Xem các bộ phim ${cat?.name ?? name} mới nhất, hay nhất với chất lượng HD VietSub miễn phí tại Nô Lệ Làm Phim.`

const empty: ListResponse<Movie> = { status: false, items: [] as Movie[] }
const data = await getMoviesByCategory(slug, { page: 1, limit: 24 }).catch(() => empty)

const breadcrumb = [
  { name: 'Trang chủ', path: '/' },
  { name: 'Danh mục', path: '/search' },
  { name: cat?.name ?? name, path: `/the-loai/${slug}` },
]
const crumb = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Danh mục', href: '/search' },
  { label: cat?.name ?? name },
]
---

<BaseLayout title={title} description={desc}>
  <script is:inline set:html={breadcrumbLd(breadcrumb)} type="application/ld+json" />
  <ListingPage
    title={name}
    desc={desc}
    crumb={crumb}
    items={data.items ?? []}
    totalPages={data.pagination?.totalPages}
    path={`/the-loai/${slug}`}
    options={{ type: true, status: true, year: true, country: true }}
  />
</BaseLayout>