---
import BaseLayout from '../layouts/BaseLayout.astro'
import { FaDice, FaFilm } from 'react-icons/fa6'

---

<BaseLayout title="Bé Lỏ chọn phim" description="Bé Lỏ chọn ngẫu nhiên một bộ phim cho bạn" cache="public" sMaxAge={60} staleWhileRevalidate={300}>
  <main class="px-4 sm:px-6 md:px-8 py-10 min-h-[60vh] flex items-center justify-center">
    <div class="text-center space-y-6 max-w-md">
      <div class="flex justify-center">
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-cm-accent to-orange-500 flex items-center justify-center shadow-[0_0_60px_-20px_rgba(249,115,22,0.8)]">
          <FaDice className="w-9 h-9 text-white" />
        </div>
      </div>
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-bold text-cm-text">Bé Lỏ chọn phim</h1>
        <p class="text-cm-text-2">Không biết xem gì? Để Bé Lỏ chọn ngẫu nhiên một bộ phim cho bạn</p>
      </div>
      <button id="pick-movie" class="inline-flex items-center gap-2 h-12 px-6 rounded-[var(--radius-cm-btn)] bg-cm-accent text-white text-base font-semibold hover:bg-cm-accent-hover transition-colors">
        <FaFilm className="w-4 h-4" />
        Bé Lỏ chọn ngay
      </button>
      <p id="status" class="text-sm text-cm-text-3 hidden">Đang chọn...</p>
    </div>
  </main>

  <script is:inline>
    document.getElementById('pick-movie')?.addEventListener('click', () => {
      const btn = document.getElementById('pick-movie')
      const status = document.getElementById('status')
      if (btn) btn.disabled = true
      if (status) { status.classList.remove('hidden'); status.textContent = 'Đang chọn...' }
      window.location.href = '/api/random'
    })
  </script>
</BaseLayout>
