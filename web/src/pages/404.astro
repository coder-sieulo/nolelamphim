---
import BaseLayout from '../layouts/BaseLayout.astro'

Astro.response.status = 404
---

<BaseLayout title="Không tìm thấy" description="Trang không tồn tại." noIndex>
  <div class="px-4 md:px-8 py-24 pb-28 flex flex-col items-center">
    <p class="text-6xl font-bold text-cm-accent mb-4">404</p>
    <p class="text-cm-text-2 text-cm-body mb-6">Không tìm thấy trang này</p>
    <a href="/" class="inline-flex h-10 items-center rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface px-5 text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]">
      Về trang chủ
    </a>
  </div>
</BaseLayout>
