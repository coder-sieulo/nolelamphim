---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getSessionUser } from '../lib/auth'
import { getUserLibrary } from '../lib/user-store'
import { movieCardHTML, escapeHTML, continueCardHTML } from '../lib/movieCard'
import { imgUrl } from '../lib/img'
import { FaHeart, FaClockRotateLeft, FaStar, FaRightToBracket, FaChevronRight } from 'react-icons/fa6'

const user = await getSessionUser(Astro.cookies)
const lib = user ? await getUserLibrary(user.sub) : null
const favorites = lib?.favorites ?? []
const history = lib ? [...lib.history].sort((a, b) => b.watchedAt - a.watchedAt) : []
const continueList = history.filter((h) => h.episodeSlug)
const ratings = lib ? Object.entries(lib.ratings).sort((a, b) => b[1] - a[1]) : []

function timeAgo(ts: number): string {
  const diff = Date.now() - ts
  const min = Math.floor(diff / 60000)
  if (min < 1) return 'vừa xem'
  if (min < 60) return `${min} phút trước`
  const hr = Math.floor(min / 60)
  if (hr < 24) return `${hr} giờ trước`
  const day = Math.floor(hr / 24)
  if (day < 30) return `${day} ngày trước`
  return new Date(ts).toLocaleDateString('vi-VN')
}

function cwCard(h: { slug: string; name: string; thumb: string; episode?: string; episodeSlug?: string }) {
  // Nguồn duy nhất: lib/movieCard.ts (bản cũ copy tay ở đây)
  return continueCardHTML(h, { removeClass: 'pf-cw-remove' })
}

const favoritesHTML = favorites.map((f) => movieCardHTML({ _id: f.id, slug: f.slug, name: f.name, thumb_url: f.thumb, tmdb_vote: f.tmdb_vote })).join('')
const continueHTML = continueList.slice(0, 30).map(cwCard).join('')
const ratingItems = ratings.map(([slug, v]) => ({ slug: escapeHTML(slug), label: escapeHTML(slug.replace(/-/g, ' ')), v }))
const historyItems = history.slice(0, 30).map((h) => ({
  href: h.episodeSlug ? `/xem/${escapeHTML(h.slug)}/${escapeHTML(h.episodeSlug)}` : `/phim/${escapeHTML(h.slug)}`,
  thumb: h.thumb ? escapeHTML(imgUrl(h.thumb, 160)) : '',
  name: escapeHTML(h.name),
  episode: h.episode ? escapeHTML(h.episode) : '',
  time: timeAgo(h.watchedAt),
}))

const card = 'bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)]'
const row = 'bg-cm-surface border border-cm-border rounded-[var(--radius-cm-card)] hover:border-cm-border-strong hover:bg-cm-elevated transition-colors duration-[var(--duration-cm)]'
---

<BaseLayout title={user ? `Hồ sơ của ${user.global_name || user.username}` : 'Hồ sơ'} description="Hồ sơ người dùng và thư viện phim của bạn tại Nô Lệ Làm Phim." noIndex>
  <div class="px-4 sm:px-6 md:px-8 py-6 pb-24 lg:pb-12 max-w-6xl mx-auto">
    {
      !user ? (
        <div class={`${card} px-6 py-16 flex flex-col items-center text-center`}>
          <img src="/logo.png" alt="" width="72" height="72" class="rounded-[var(--radius-cm-card)] mb-5" />
          <h1 class="text-lg font-semibold text-cm-text mb-2">Đăng nhập để dùng hồ sơ của bạn</h1>
          <p class="text-cm-text-2 text-cm-body max-w-md mb-6">
            Đăng nhập Discord để lưu phim yêu thích, đánh giá và lịch sử xem — đồng bộ trên mọi thiết bị,
            cùng nhiều tính năng riêng của thành viên.
          </p>
          <a href="/api/auth/discord" class="inline-flex items-center gap-2.5 h-11 px-5 rounded-[var(--radius-cm-btn)] bg-[#5865F2] text-white text-cm-body font-semibold hover:bg-[#4752c4] transition-colors duration-[var(--duration-cm)]">
            <FaRightToBracket className="w-4 h-4" />
            Đăng nhập với Discord
          </a>
        </div>
      ) : (
        <div>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-16 h-16 md:w-20 md:h-20 rounded-[var(--radius-cm-card)] overflow-hidden bg-cm-bg-2 border border-cm-border shrink-0">
              {
                user.avatar ? (
                  <img src={`https://cdn.discordapp.com/avatars/${user.sub}/${user.avatar}.png?size=128`} alt="" width="80" height="80" class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-cm-accent text-white text-2xl font-bold">
                    {(user.global_name || user.username || '?').slice(0, 1).toUpperCase()}
                  </div>
                )
              }
            </div>
            <div class="min-w-0">
              <h1 class="text-lg md:text-xl font-bold text-cm-text truncate">{user.global_name || user.username}</h1>
              <p class="text-cm-meta text-cm-text-3 truncate">@{user.username}</p>
              <p class="text-[11px] text-cm-text-3 mt-1.5 flex items-center gap-1.5">
                <FaHeart className="w-3 h-3 text-cm-accent" /> {favorites.length} yêu thích
                <span>·</span>
                <FaClockRotateLeft className="w-3 h-3 text-cm-text-3" /> {history.length} đã xem
              </p>
            </div>
          </div>

          {favorites.length > 0 && (
            <section class="mb-10">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-cm-body font-semibold text-cm-text flex items-center gap-2">
                  <FaHeart className="w-4 h-4 text-cm-accent" /> Yêu thích
                </h2>
                <span class="text-[11px] text-cm-text-3">{favorites.length} phim</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2.5" set:html={favoritesHTML} />
            </section>
          )}

          {continueList.length > 0 && (
            <section class="mb-10">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-cm-body font-semibold text-cm-text flex items-center gap-2">
                  <FaClockRotateLeft className="w-4 h-4 text-cm-text-3" /> Tiếp tục xem
                </h2>
                <button type="button" id="pf-clear-history" class="text-[11px] text-cm-text-3 hover:text-cm-accent transition-colors duration-[var(--duration-cm)]">
                  Xoá toàn bộ lịch sử
                </button>
              </div>
              <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none snap-x snap-mandatory" set:html={continueHTML} />
            </section>
          )}

          <section class="mb-10">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-cm-body font-semibold text-cm-text flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-cm-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>
                Đánh giá của bạn
              </h2>
              <span class="text-[11px] text-cm-text-3">{ratings.length} phim</span>
            </div>
            {
              ratings.length === 0 ? (
                <p class="text-cm-meta text-cm-text-3 px-1">
                  Bạn chưa đánh giá phim nào. Vào trang phim và chấm sao là xong nhé!
                </p>
              ) : (
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                  {ratingItems.map((r) => (
                    <a href={`/phim/${r.slug}`} class={`flex items-center gap-2.5 px-3.5 py-2.5 ${row} min-w-0`}>
                      <span class="w-8 h-8 rounded-[var(--radius-cm-btn)] bg-cm-bg-2 border border-cm-border flex items-center justify-center text-cm-text-3 shrink-0">
                        <FaStar className="w-3.5 h-3.5 text-[#F5C518]" />
                      </span>
                      <span class="text-cm-meta text-cm-text-2 truncate hover:text-cm-text">{r.label}</span>
                      <span class="ml-auto text-cm-meta font-semibold text-cm-text shrink-0 tabular-nums">{r.v}/5</span>
                    </a>
                  ))}
                </div>
              )
            }
          </section>

          {historyItems.length > 0 && (
            <section class="mb-10">
              <h2 class="text-cm-body font-semibold text-cm-text mb-4 flex items-center gap-2">
                <FaClockRotateLeft className="w-4 h-4 text-cm-text-3" /> Đã xem gần đây
              </h2>
              <div class="space-y-1.5">
                {historyItems.map((h) => (
                  <a href={h.href} class={`flex items-center gap-3 px-3.5 py-2.5 ${row} min-w-0`} aria-label={`Xem ${h.name}`}>
                    <div class="w-10 h-14 rounded-[var(--radius-cm-btn)] overflow-hidden bg-cm-bg-2 border border-cm-border poster-shell shrink-0">
                      {h.thumb ? (
                        <img src={h.thumb} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                      ) : (
                        <div class="w-full h-full bg-cm-bg-2"></div>
                      )}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="text-cm-body text-cm-text truncate">{h.name}</p>
                      <p class="text-[11px] text-cm-text-3">{h.episode ? `${h.episode} • ` : ''}{h.time}</p>
                    </div>
                    <FaChevronRight className="w-3.5 h-3.5 text-cm-text-3 shrink-0" />
                  </a>
                ))}
              </div>
            </section>
          )}

          {favorites.length === 0 && continueList.length === 0 && ratings.length === 0 && (
            <div class={`${card} px-6 py-12 flex flex-col items-center text-center`}>
              <FaHeart className="w-8 h-8 text-cm-text-3 mb-3" />
              <p class="text-cm-text-2 text-cm-body mb-1">Thư viện của bạn còn trống</p>
              <p class="text-cm-text-3 text-cm-meta mb-5">Yêu thích, đánh giá và xem phim để thấy chúng xuất hiện ở đây.</p>
              <a href="/" class="inline-flex h-10 items-center rounded-[var(--radius-cm-btn)] border border-cm-border bg-cm-surface px-4 text-cm-meta text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]">Khám phá phim</a>
            </div>
          )}
        </div>
      )
    }
  </div>

  <script>
    import { removeRecent, getRecent } from '../scripts/store'
    import { registerPageInit } from '../scripts/lifecycle'

    registerPageInit(() => {
      document.querySelectorAll<HTMLButtonElement>('.pf-cw-remove').forEach((btn) => {
        btn.addEventListener('click', () => {
          const card = btn.closest<HTMLElement>('[data-slug]')
          if (!card) return
          const slug = card.dataset.slug || ''
          removeRecent(slug)
          fetch(`/api/user/history?slug=${encodeURIComponent(slug)}`, { method: 'DELETE', credentials: 'same-origin' }).catch(() => {})
          card.remove()
        })
      })
      const clearBtn = document.getElementById('pf-clear-history')
      clearBtn?.addEventListener('click', async () => {
        const ok = confirm('Xoá toàn bộ lịch sử xem?')
        if (!ok) return
        try {
          await fetch('/api/user/history/clear', { method: 'POST', credentials: 'same-origin' })
        } catch {
          /* vẫn xoá trên máy */
        }
        getRecent().forEach((r) => removeRecent(r.slug))
        window.location.reload()
      })
    })
  </script>
</BaseLayout>