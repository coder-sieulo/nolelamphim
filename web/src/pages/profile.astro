---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getSessionUser } from '../lib/auth'
import { getUserLibrary } from '../lib/user-store'
import { movieCardHTML, escapeHTML } from '../lib/movieCard'
import { imgUrl } from '../lib/img'
import { FaHeart, FaClockRotateLeft, FaStar, FaRightToBracket } from 'react-icons/fa6'

const user = await getSessionUser(Astro.cookies)
const lib = user ? await getUserLibrary(user.sub) : null
const favorites = lib?.favorites ?? []
const history = lib ? [...lib.history].sort((a, b) => b.watchedAt - a.watchedAt) : []
const continueList = history.filter((h) => h.episodeSlug)
const ratings = lib ? Object.entries(lib.ratings).sort((a, b) => b[1] - a[1]) : []

function timeAgo(ts: number): string {
  const diff = Date.now() - ts
  const min = Math.floor(diff / 60000)
  if (min < 1) return 'vừa xem'
  if (min < 60) return `${min} phút trước`
  const hr = Math.floor(min / 60)
  if (hr < 24) return `${hr} giờ trước`
  const day = Math.floor(hr / 24)
  if (day < 30) return `${day} ngày trước`
  return new Date(ts).toLocaleDateString('vi-VN')
}

function cwCard(h: { slug: string; name: string; thumb: string; episode?: string; episodeSlug?: string }) {
  return `
    <div class="snap-start shrink-0 w-[150px] relative group" data-slug="${escapeHTML(h.slug)}">
      <a href="/xem/${escapeHTML(h.slug)}/${escapeHTML(h.episodeSlug || '')}" class="block relative aspect-[2/3] rounded-xl overflow-hidden bg-bg-card glass-frame poster-shell${h.thumb ? ' shimmer' : ''}">
        ${h.thumb ? `<img src="${escapeHTML(imgUrl(h.thumb, 300))}" alt="${escapeHTML(h.name)}" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />` : '<div class="w-full h-full bg-bg-card"></div>'}
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        ${h.episode ? `<span class="absolute top-2 left-2 px-2 py-0.5 rounded-full bg-[#FF6B9D] text-white text-[10px] font-semibold">${escapeHTML(h.episode)}</span>` : ''}
        <span class="absolute inset-x-0 bottom-0 px-2.5 py-2 flex items-center gap-1.5 text-white text-[11px] font-medium">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Tiếp tục
        </span>
      </a>
      <button type="button" class="pf-cw-remove absolute -top-1.5 -right-1.5 z-10 w-5 h-5 rounded-full bg-black/60 border border-white/15 text-white/80 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-black/80" aria-label="Xoá khỏi lịch sử xem">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
    </div>
  `
}

const favoritesHTML = favorites.map((f) => movieCardHTML({ _id: f.id, slug: f.slug, name: f.name, thumb_url: f.thumb, tmdb_vote: f.tmdb_vote })).join('')
const continueHTML = continueList.slice(0, 30).map(cwCard).join('')
const ratingItems = ratings.map(([slug, v]) => ({ slug: escapeHTML(slug), label: escapeHTML(slug.replace(/-/g, ' ')), v }))
const historyItems = history.slice(0, 30).map((h) => ({
  href: h.episodeSlug ? `/xem/${escapeHTML(h.slug)}/${escapeHTML(h.episodeSlug)}` : `/phim/${escapeHTML(h.slug)}`,
  thumb: h.thumb ? escapeHTML(imgUrl(h.thumb, 160)) : '',
  name: escapeHTML(h.name),
  episode: h.episode ? escapeHTML(h.episode) : '',
  time: timeAgo(h.watchedAt),
}))
---

<BaseLayout title={user ? `Hồ sơ của ${user.global_name || user.username}` : 'Hồ sơ'} description="Hồ sơ người dùng và thư viện phim của bạn tại Nô Lệ Làm Phim." noIndex>
  <div class="px-4 md:px-8 py-6 max-w-6xl mx-auto">
    {
      !user ? (
        <div class="content-card px-6 py-16 flex flex-col items-center text-center">
          <img src="/logo.png" alt="" width="72" height="72" class="rounded-2xl mb-5" />
          <h1 class="text-lg font-semibold text-text-primary mb-2">Đăng nhập để dùng hồ sơ của bạn</h1>
          <p class="text-text-secondary text-sm max-w-md mb-6">
            Đăng nhập Discord để lưu phim yêu thích, đánh giá và lịch sử xem — đồng bộ trên mọi thiết bị,
            cùng nhiều tính năng riêng của thành viên.
          </p>
          <a href="/api/auth/discord" class="flex items-center gap-2.5 px-5 py-3 rounded-xl bg-[#5865F2] text-white text-sm font-semibold hover:bg-[#4752c4] transition-colors">
            <FaRightToBracket className="w-4 h-4" />
            Đăng nhập với Discord
          </a>
        </div>
      ) : (
        <div>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl overflow-hidden bg-white/5 glass-frame shrink-0">
              {
                user.avatar ? (
                  <img src={`https://cdn.discordapp.com/avatars/${user.sub}/${user.avatar}.png?size=128`} alt="" width="80" height="80" class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[#5865F2] to-[#FF6B9D] text-white text-2xl font-bold">
                    {(user.global_name || user.username || '?').slice(0, 1).toUpperCase()}
                  </div>
                )
              }
            </div>
            <div class="min-w-0">
              <h1 class="text-lg md:text-xl font-bold text-text-primary truncate">{user.global_name || user.username}</h1>
              <p class="text-xs text-text-muted truncate">@{user.username}</p>
              <p class="text-[11px] text-text-muted mt-1.5 flex items-center gap-1.5">
                <FaHeart className="w-3 h-3 text-[#FF6B9D]" /> {favorites.length} yêu thích
                <span>·</span>
                <FaClockRotateLeft className="w-3 h-3 text-[#4A9EFF]" /> {history.length} đã xem
              </p>
            </div>
          </div>

          {favorites.length > 0 && (
            <section class="mb-10">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold text-text-primary flex items-center gap-2">
                  <FaHeart className="w-4 h-4 text-[#FF6B9D]" /> Yêu thích
                </h2>
                <span class="text-[11px] text-text-muted">{favorites.length} phim</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2.5" set:html={favoritesHTML} />
            </section>
          )}

          {continueList.length > 0 && (
            <section class="mb-10">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold text-text-primary flex items-center gap-2">
                  <FaClockRotateLeft className="w-4 h-4 text-[#4A9EFF]" /> Tiếp tục xem
                </h2>
                <button type="button" id="pf-clear-history" class="text-[11px] text-text-muted hover:text-red-400 transition-colors">
                  Xoá toàn bộ lịch sử
                </button>
              </div>
              <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none snap-x snap-mandatory" set:html={continueHTML} />
            </section>
          )}

          <section class="mb-10">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-semibold text-text-primary flex items-center gap-2">
                <span class="text-[#4A9EFF]">★</span> Đánh giá của bạn
              </h2>
              <span class="text-[11px] text-text-muted">{ratings.length} phim</span>
            </div>
            {
              ratings.length === 0 ? (
                <p class="text-xs text-text-muted px-1">
                  Bạn chưa đánh giá phim nào. Vào trang phim và chấm sao là xong nhé!
                </p>
              ) : (
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                  {ratingItems.map((r) => (
                    <a href={`/phim/${r.slug}`} class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl glass-tile hover:bg-white/5 transition-colors min-w-0">
                      <span class="w-8 h-8 rounded-lg bg-bg-card glass-frame flex items-center justify-center text-text-muted shrink-0">
                        <FaStar className="w-3.5 h-3.5 text-[#F5C518]" />
                      </span>
                      <span class="text-xs text-text-secondary truncate hover:text-white">{r.label}</span>
                      <span class="ml-auto text-xs font-semibold text-white shrink-0 tabular-nums">{r.v}/5</span>
                    </a>
                  ))}
                </div>
              )
            }
          </section>

          {historyItems.length > 0 && (
            <section class="mb-10">
              <h2 class="text-sm font-semibold text-text-primary mb-4 flex items-center gap-2">
                <FaClockRotateLeft className="w-4 h-4 text-text-muted" /> Đã xem gần đây
              </h2>
              <div class="space-y-1.5">
                {historyItems.map((h) => (
                  <a href={h.href} class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl glass-tile hover:bg-white/5 transition-colors min-w-0">
                    <div class="w-10 h-14 rounded-lg overflow-hidden bg-bg-card glass-frame poster-shell shrink-0">
                      {h.thumb ? (
                        <img src={h.thumb} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                      ) : (
                        <div class="w-full h-full bg-bg-card"></div>
                      )}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm text-text-primary truncate">{h.name}</p>
                      <p class="text-[11px] text-text-muted">{h.episode ? `${h.episode} • ` : ''}{h.time}</p>
                    </div>
                    <span class="text-[11px] text-text-muted shrink-0">Xem →</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {favorites.length === 0 && continueList.length === 0 && ratings.length === 0 && (
            <div class="content-card px-6 py-12 flex flex-col items-center text-center">
              <FaHeart className="w-8 h-8 text-text-muted mb-3" />
              <p class="text-text-secondary text-sm mb-1">Thư viện của bạn còn trống</p>
              <p class="text-text-muted text-xs mb-5">Yêu thích, đánh giá và xem phim để thấy chúng xuất hiện ở đây.</p>
              <a href="/" class="px-4 py-2 rounded-xl glass-tile text-xs text-text-secondary hover:text-white transition-colors">Khám phá phim</a>
            </div>
          )}
        </div>
      )
    }
  </div>

  <script>
    import { removeRecent, getRecent } from '../scripts/store'
    import { registerPageInit } from '../scripts/lifecycle'

    registerPageInit(() => {
      document.querySelectorAll<HTMLButtonElement>('.pf-cw-remove').forEach((btn) => {
        btn.addEventListener('click', () => {
          const card = btn.closest<HTMLElement>('[data-slug]')
          if (!card) return
          const slug = card.dataset.slug || ''
          removeRecent(slug)
          fetch(`/api/user/history?slug=${encodeURIComponent(slug)}`, { method: 'DELETE', credentials: 'same-origin' }).catch(() => {})
          card.remove()
        })
      })
      const clearBtn = document.getElementById('pf-clear-history')
      clearBtn?.addEventListener('click', async () => {
        const ok = confirm('Xoá toàn bộ lịch sử xem?')
        if (!ok) return
        try {
          await fetch('/api/user/history/clear', { method: 'POST', credentials: 'same-origin' })
        } catch {
          /* vẫn xoá trên máy */
        }
        getRecent().forEach((r) => removeRecent(r.slug))
        window.location.reload()
      })
    })
  </script>
</BaseLayout>