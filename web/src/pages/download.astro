---
/**
 * Tải ứng dụng — skin CINEMA MINIMAL (Phase 2).
 * Nguồn: GitHub release mới nhất (vien105200318/nolelamphim).
 * Không đổi logic fetch; bỏ glass/gradient → surface phẳng + accent.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import EmptyState from '../components/ui/EmptyState.astro'
import { FaAndroid, FaApple, FaTv, FaMobileScreenButton, FaChevronLeft } from 'react-icons/fa6'

interface ReleaseAsset {
  name: string
  browser_download_url: string
}

interface Release {
  tag_name: string
  assets: ReleaseAsset[]
}

async function getLatestRelease(): Promise<Release | null> {
  try {
    const res = await fetch(
      'https://api.github.com/repos/vien105200318/nolelamphim/releases?per_page=1',
      { headers: { Accept: 'application/json' } },
    )
    if (!res.ok) return null
    const releases: Release[] = await res.json()
    return releases[0] ?? null
  } catch {
    return null
  }
}

const release = await getLatestRelease()

const apkAsset = release?.assets.find((a) => a.name.endsWith('.apk') && !a.name.includes('tv'))
const ipaAsset = release?.assets.find((a) => a.name.endsWith('.ipa'))
const tvAsset = release?.assets.find((a) => a.name.endsWith('-androidtv.apk'))
const webosAsset = release?.assets.find((a) => a.name.endsWith('.ipk') || a.name.includes('webos'))

const platforms = [
  {
    id: 'android',
    label: 'Android',
    url: apkAsset?.browser_download_url ?? null,
    filename: apkAsset?.name ?? null,
    note: null as string | null,
    Icon: FaAndroid,
  },
  {
    id: 'ios',
    label: 'iOS',
    url: ipaAsset?.browser_download_url ?? null,
    filename: ipaAsset?.name ?? null,
    note: ipaAsset ? 'unsigned — cần sign trước khi cài' : null,
    Icon: FaApple,
  },
  {
    id: 'androidtv',
    label: 'Android TV',
    url: tvAsset?.browser_download_url ?? null,
    filename: tvAsset?.name ?? null,
    note: null as string | null,
    Icon: FaTv,
  },
  {
    id: 'webos',
    label: 'LG webOS',
    url: webosAsset?.browser_download_url ?? null,
    filename: webosAsset?.name ?? null,
    note: webosAsset ? 'Cài bằng webOS TV SDK (ares-install)' : null,
    Icon: FaMobileScreenButton,
  },
]
const hasAny = platforms.some((p) => p.url)
---

<BaseLayout title="Tải ứng dụng" description="Tải ứng dụng Nô Lệ Làm Phim cho điện thoại và máy tính." cache="public">
  <div class="px-4 sm:px-6 md:px-8 py-14">
    <div class="max-w-3xl mx-auto">
      <div class="flex flex-col items-center text-center mb-12">
        <img
          src="/logo.png"
          alt="Nô Lệ Làm Phim"
          width="72"
          height="72"
          class="rounded-[var(--radius-cm-card)] mb-6"
        />
        <h1 class="text-2xl md:text-3xl font-bold text-cm-text mb-3">Tải ứng dụng</h1>
        <p class="text-sm text-cm-text-2 max-w-md">
          Chọn nền tảng phù hợp để tải xuống. Hỗ trợ Android, iOS, Android TV và LG webOS.
        </p>
        {
          release && (
            <p class="mt-4 px-3 py-1 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-cm-meta text-cm-text-3 text-xs inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cm-accent" aria-hidden />
              Phiên bản {release.tag_name.replace(/^v/i, '')}
            </p>
          )
        }
      </div>

      {
        hasAny ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {
              platforms.map((p) => (
                <div class="rounded-[var(--radius-cm-card)] bg-cm-surface border border-cm-border p-6 flex flex-col items-center text-center">
                  <div class="w-12 h-12 rounded-[var(--radius-cm-card)] bg-cm-elevated flex items-center justify-center text-cm-text mb-5">
                    <p.Icon className="w-6 h-6" />
                  </div>
                  <h2 class="text-base font-semibold text-cm-text mb-4">{p.label}</h2>

                  {
                    p.url ? (
                      <>
                        <a
                          href={p.url}
                          download
                          class="w-full h-10 inline-flex items-center justify-center rounded-[var(--radius-cm-btn)] bg-cm-accent text-white text-sm font-semibold hover:bg-cm-accent-hover transition-colors duration-[var(--duration-cm)]"
                        >
                          Tải xuống
                        </a>
                        {p.note && <p class="mt-3 text-xs text-cm-text-3 leading-relaxed">{p.note}</p>}
                        {p.filename && <p class="mt-1.5 text-cm-meta text-cm-text-3 font-mono truncate w-full">{p.filename}</p>}
                      </>
                    ) : (
                      <>
                        <div class="w-full h-10 inline-flex items-center justify-center rounded-[var(--radius-cm-btn)] bg-cm-bg text-cm-text-3 text-sm font-medium border border-cm-border cursor-not-allowed">
                          Đang phát triển
                        </div>
                        <p class="mt-3 text-xs text-cm-text-3">Sẽ sớm ra mắt</p>
                      </>
                    )
                  }
                </div>
              ))
            }
          </div>
        ) : (
          <EmptyState
            title="Chưa có bản release nào"
            hint="Kiểm tra GitHub repository để biết khi nào ứng dụng sẵn sàng"
          />
        )
      }

      <div class="flex justify-center mt-12">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-4 h-10 rounded-[var(--radius-cm-btn)] bg-cm-surface border border-cm-border text-sm text-cm-text-2 hover:text-cm-text hover:border-cm-border-strong transition-colors duration-[var(--duration-cm)]"
        >
          <FaChevronLeft className="w-3.5 h-3.5" />
          Quay lại trang chủ
        </a>
      </div>
    </div>
  </div>
</BaseLayout>